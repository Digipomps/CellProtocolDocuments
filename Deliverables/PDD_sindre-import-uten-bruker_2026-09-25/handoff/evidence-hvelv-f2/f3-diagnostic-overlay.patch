+    func testF3OriginalTemporaryRootDiagnostics() throws {
+        let temporary = URL(fileURLWithPath: NSTemporaryDirectory()).resolvingSymlinksInPath()
+        print("F3 original temporary raw=", NSTemporaryDirectory(), "canonical=", temporary.path)
+        var descriptor = Darwin.open("/", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)
+        defer { if descriptor >= 0 { Darwin.close(descriptor) } }
+        for part in temporary.path.split(separator: "/") {
+            let next = Darwin.openat(descriptor, String(part), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)
+            print("F3 openat component=", part, "result=", next, "errno=", errno)
+            Darwin.close(descriptor); descriptor = next
+            if next < 0 { break }
+        }
+        let fixture = URL(fileURLWithPath: "/private/tmp/f3-reader-diagnostic-" + UUID().uuidString)
+        defer { try? FileManager.default.removeItem(at: fixture) }
+        try FileManager.default.createDirectory(at: fixture, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        let file = fixture.appendingPathComponent("manifest.json")
+        FileManager.default.createFile(atPath: file.path, contents: Data("{}".utf8), attributes: [.posixPermissions: 0o400])
+        for path in [fixture, file] {
+            let attributes = try FileManager.default.attributesOfItem(atPath: path.path)
+            let fd = Darwin.open(path.path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC)
+            defer { if fd >= 0 { Darwin.close(fd) } }
+            var names = [CChar](repeating: 0, count: 4096)
+            let count = Darwin.flistxattr(fd, &names, names.count, 0)
+            print("F3 reader fixture", path.lastPathComponent, "uid", attributes[.ownerAccountID]!, "gid", attributes[.groupOwnerAccountID]!, "mode", attributes[.posixPermissions]!, "xattrs", count, String(decoding: names.prefix(max(0,count)).map { UInt8(bitPattern: $0) }, as: UTF8.self))
+        }
+    }

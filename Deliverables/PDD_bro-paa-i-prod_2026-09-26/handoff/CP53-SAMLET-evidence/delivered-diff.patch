+        }
+        var encoded = try encode(value)
+        if field == "duplicateJSON" { encoded = Data("{\"extra\":1,\"extra\":1,".utf8) + encoded.dropFirst() }
+        var padded = P.integer(UInt32(encoded.count)) + encoded + Data(repeating: 0, count: size-4-encoded.count)

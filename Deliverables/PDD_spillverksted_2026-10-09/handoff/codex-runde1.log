import Vapor

enum MVPAdminWebRole: String, Codable, CaseIterable, Sendable {
    case observer
    case `operator`
    case security
}

enum MVPAdminAuthorizationMode: String, Codable, Sendable {
    case scopedRoles = "scoped_roles"
    case none
}

struct MVPAdminAuthorization: Sendable {
    let roles: Set<MVPAdminWebRole>
    let mode: MVPAdminAuthorizationMode

    var isAdmin: Bool { !roles.isEmpty }
}

enum MVPAdminAccess {
    static let mutationHeaderName = HTTPHeaders.Name("X-HAVEN-Admin-Request")
    static let mutationHeaderValue = "1"

    static func requireAuthenticatedUser(_ req: Request) throws -> FidoUser {
        guard let user = req.auth.get(FidoUser.self) else {
            throw Abort(.unauthorized, reason: "Passkey authentication required.")
        }
        return user
    }

    static func requireAdminUser(_ req: Request, role: MVPAdminWebRole) throws -> FidoUser {
        let user = try requireAuthenticatedUser(req)
        let userID = try user.requireID().uuidString.lowercased()
        let authorization = authorization(for: userID, on: req.application)
        req.adminRequiredRole = role

        guard authorization.isAdmin else {
            throw Abort(
                .forbidden,
                reason: "Admin API is disabled for this user. Configure scoped admin role IDs."
            )
        }
        guard authorization.roles.contains(role) else {
            throw Abort(.forbidden, reason: "Admin \(role.rawValue) role required.")
        }
        return user
    }

    static func authorization(for userID: String, on application: Application) -> MVPAdminAuthorization {
        authorization(for: userID, settings: application.authSecuritySettings)
    }

    static func authorization(for userID: String, settings: AuthSecuritySettings) -> MVPAdminAuthorization {
        let normalizedID = userID.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
        guard !normalizedID.isEmpty else {
            return MVPAdminAuthorization(roles: [], mode: .none)
        }

        var roles = Set<MVPAdminWebRole>()
        if settings.adminObserverUserIDs.contains(normalizedID) {
            roles.insert(.observer)
        }
        if settings.adminOperatorUserIDs.contains(normalizedID) {
            roles.formUnion([.observer, .operator])
        }
        if settings.adminSecurityUserIDs.contains(normalizedID) {
            roles.formUnion([.observer, .security])
        }
        return MVPAdminAuthorization(roles: roles, mode: roles.isEmpty ? .none : .scopedRoles)
    }

    static func requireMutationProtection(_ req: Request) throws {
        guard req.method != .GET, req.method != .HEAD, req.method != .OPTIONS else {
            return
        }

        if hasBearerAuthorization(req.headers) {
            return
        }

        if let fetchSite = req.headers.first(name: HTTPHeaders.Name("Sec-Fetch-Site"))?.lowercased(),
           fetchSite == "cross-site" {
            throw Abort(.forbidden, reason: "Cross-site admin mutation rejected.")
        }

        guard req.headers.first(name: mutationHeaderName) == mutationHeaderValue else {
            throw Abort(.forbidden, reason: "Admin mutation requires an explicit same-origin request header.")
        }
    }

    static func mutationRequestIsProtected(method: HTTPMethod, headers: HTTPHeaders) -> Bool {
        guard method != .GET, method != .HEAD, method != .OPTIONS else {
            return true
        }
        if hasBearerAuthorization(headers) {
            return true
        }
        if let fetchSite = headers.first(name: HTTPHeaders.Name("Sec-Fetch-Site"))?.lowercased(),
           fetchSite == "cross-site" {
            return false
        }
        return headers.first(name: mutationHeaderName) == mutationHeaderValue
    }

    private static func hasBearerAuthorization(_ headers: HTTPHeaders) -> Bool {
        guard let authorization = headers.first(name: .authorization) else {
            return false
        }
        return authorization.lowercased().hasPrefix("bearer ")
    }

}

private struct MVPAdminRequiredRoleKey: StorageKey {
    typealias Value = MVPAdminWebRole
}


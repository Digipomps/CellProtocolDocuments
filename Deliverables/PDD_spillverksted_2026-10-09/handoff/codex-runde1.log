// purpose://candidate.game-workshop.engine.sandbox-isolation
import Foundation
import Vapor
@preconcurrency import CellBase
@preconcurrency import CellVapor

struct VaporGameSandbox: RouteCollection {
    static let csp = "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-inline'; img-src data: blob:; style-src 'unsafe-inline'; connect-src 'none'; media-src data: blob:"

    func boot(routes: RoutesBuilder) throws {
        let authenticated = routes.grouped(FidoUser.sessionAuthenticator(), FidoUser.jwtAccessAuthenticator())
        authenticated.get("spill", "sandbox", ":project", ":version") { req async throws -> Response in
            // The HTTP session establishes the requester; the URL never names an identity.
            guard let user = req.auth.get(FidoUser.self),
                  let project = req.parameters.get("project"), UUID(uuidString: project) != nil,
                  let version = req.parameters.get("version"), version == "pending" || Int(version).map({ $0 > 0 }) == true,
                  let resolver = CellBase.defaultCellResolver else { return Self.notFound() }
            do {
                let requester = try await MVPAuthAccess.authenticatedRequester(for: user, req: req)
                let owner = try await Self.scaffoldOwner(req)
                guard let cell = try await resolver.cellAtEndpoint(endpoint: "cell:///GameProject", requester: owner) as? GameProjectCell,
                      let code = try await cell.sandboxCode(projectID: project, version: version, requester: requester) else { return Self.notFound() }
                return Self.response(code: code)
            } catch { return Self.notFound() }
        }
    }
    private static func scaffoldOwner(_ req: Request) async throws -> Identity {
        let state = req.application.scaffoldOwnerRuntimeState
        if let uuid = state.identity_uuid, let vault = CellBase.defaultIdentityVault as? VaporIdentityVault,
           let identity = await vault.getIdentity(by: uuid) { return identity }
        guard let vault = CellBase.defaultIdentityVault,
              let identity = await vault.identity(for: state.owner_context, makeNewIfNotFound: false) else { throw Abort(.notFound) }
        return identity
    }
    static func notFound() -> Response { Response(status: .notFound, headers: headers(), body: .init(string: "Not found")) }
    static func headers() -> HTTPHeaders {
        var headers = HTTPHeaders()
        headers.replaceOrAdd(name: .contentType, value: "text/html; charset=utf-8")
        headers.replaceOrAdd(name: "Content-Security-Policy", value: csp)
        headers.replaceOrAdd(name: "X-Content-Type-Options", value: "nosniff")
        headers.replaceOrAdd(name: "Referrer-Policy", value: "no-referrer")
        headers.replaceOrAdd(name: .cacheControl, value: "no-store")
        return headers
    }
    static func response(code: String) -> Response { Response(status: .ok, headers: headers(), body: .init(string: document(code: code))) }
    static func document(code: String) -> String {
        guard let url = Bundle.module.url(forResource: "sandbox", withExtension: "html", subdirectory: "GameWorkshop"),
              let template = try? String(contentsOf: url, encoding: .utf8),
              let marker = template.range(of: "__GAME_CODE__") else { return "" }
        let offset = template[..<marker.lowerBound].filter { $0 == "\n" }.count
        let escaped = code.replacingOccurrences(of: "</script", with: "<\\/script", options: .caseInsensitive)
        return template.replacingOccurrences(of: "__GAME_OFFSET__", with: String(offset)).replacingOccurrences(of: "__GAME_CODE__", with: escaped)
    }
}

/// Must wrap SessionsMiddleware, so even session refresh cookies are removed.
struct GameSandboxResponseMiddleware: AsyncMiddleware {
    func respond(to request: Request, chainingTo next: AsyncResponder) async throws -> Response {
        guard request.url.path.hasPrefix("/spill/sandbox/") else { return try await next.respond(to: request) }
        let response: Response
        do { response = try await next.respond(to: request) } catch { response = VaporGameSandbox.notFound() }
        response.headers.remove(name: .setCookie)
        for header in VaporGameSandbox.headers() { response.headers.replaceOrAdd(name: header.name, value: header.value) }
        return response

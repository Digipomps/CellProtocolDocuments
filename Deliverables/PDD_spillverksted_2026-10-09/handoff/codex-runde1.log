def haven_root() -> Path:
    """HAVEN-roten er en maskininnstilling: env HAVEN_ROOT, ~/.haven/root, ellers
    utledet fra dette skriptets plassering (<HAVEN>/CellScaffold/scripts/)."""
    env = os.environ.get("HAVEN_ROOT")
    if env:
        return Path(env).expanduser().resolve()
    marker = Path.home() / ".haven" / "root"
    if marker.is_file():
        text = marker.read_text().strip()
        if text:
            candidate = Path(text).expanduser()
            if candidate.is_dir():
                return candidate.resolve()
    return SCRIPT_PATH.parents[2]



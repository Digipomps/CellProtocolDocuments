final class GameToolLibraryCellTests: IsolatedCellTestCase {
    func testExactThenSiblingThenTextAndStableOrder() throws {
        let library = try GameToolLibrary.bundled()
        XCTAssertEqual(library.entries.count, 20)
        let results = library.lookup(purposeRef: \"purpose://candidate.game.detect-collision\", text: \"versjon\")
        let reasons = results.compactMap { value -> String? in
            guard case .object(let entry) = value else { return nil }
            return GameToolLibrary.string(entry[\"matchedBy\"])
        }
        XCTAssertEqual(reasons.first, \"purpose\")
        XCTAssertTrue(reasons.contains(\"sibling\"))
        let ranks = reasons.map { [\"purpose\": 0, \"sibling\": 1, \"text\": 2]["'$0]! }
        XCTAssertEqual(ranks, ranks.sorted())
        XCTAssertTrue(library.lookup(purposeRef: nil, text: nil).isEmpty)
        XCTAssertFalse(library.lookup(purposeRef: nil, text: "hopp").isEmpty)
        let encoder = JSONEncoder(); encoder.outputFormatting = [.sortedKeys]
        XCTAssertEqual(try encoder.encode(results), try encoder.encode(library.lookup(purposeRef: "purpose://candidate.game.detect-collision", text: "versjon")))
    }
    func testLibraryCellReturnsGroupedPurposesAndLookup() async throws {
        let owner = await makeCellProtocolTestIdentity("game-library-owner")
        let cell = await GameToolLibraryCell(owner: owner)
        let groups = try await cell.get(keypath: "library.purposes", requester: owner)
        guard case .list(let values) = groups else { return XCTFail("Missing groups") }
        XCTAssertEqual(values.count, 5)
        let result = try await cell.set(keypath: "library.lookup", value: .object(["purposeRef": .string("purpose://candidate.game.gravity-and-jump")]), requester: owner)
        guard case .list(let entries)? = result, case .object(let first)? = entries.first else { return XCTFail("Missing lookup") }
        XCTAssertEqual(first["matchedBy"], .string("purpose"))
        XCTAssertEqual(first["id"], .string("api.kaplay.body-jump"))
    }
}

        var sources: [ValueType] = []
        var unavailableReasons: [String] = []
        var seenPortfolios = Set<String>()
        var ownPortfolioStatus = "setup-required"
        // Browsing must not create an identity-unique cell. Only resolve an
        // existing mapping, by concrete UUID, and let the resolver verify it.
        let ownMappings = await resolver.identityNamedCells(requester: requester)[requester.uuid] ?? [:]
        if let ownUUID = ownMappings["ProjectPortfolio"] {
            ownPortfolioStatus = "unavailable"
            do {
                if UUID(uuidString: ownUUID) != nil,
                      let portfolio = try await PortholeActionDiagnostics.cellAtEndpoint(
                        using: resolver, endpoint: "cell:///\(ownUUID)", requester: requester
                      ) as? ProjectPortfolioCell,

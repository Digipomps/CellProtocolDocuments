//
//  VaporPublication.swift
//  CellScaffold
//
//  The anonymous visitor surface for publications:
//
//    GET /pub                       directory of listed publications (HTML)
//    GET /pub/:slug                 front page (HTML)
//    GET /pub/:slug/feed.json       JSON feed of published posts
//    GET /pub/:slug/media/:assetID  media bytes
//    GET /pub/:slug/verk            works published in ArtistSales (HTML, opt-in)
//    GET /pub/:slug/verk/:workID    one work (HTML)
//    GET /pub/:slug/verk/:workID/preview   preview bytes — never display or original
//    GET /pub/:slug/:entrySlug      a page or a post (HTML)
//
//  There is no session here on purpose. The cell is resolved through the
//  scaffold identity and read through its local signing owner, exactly like
//  the Butterpop catalog. Whatever the cell returns as `.null` becomes 404 —
//  the route never learns whether a slug is unknown, a draft, unpublished or
//  hosting-lapsed, so it cannot leak that difference either.
//

import Foundation
import Vapor
import ScaffoldKit
@preconcurrency import CellBase

struct VaporPublication: RouteCollection {
    private static let publicReadRatePolicy = AuthRateLimiter.Policy(
        windowSeconds: 10 * 60,
        maxAttempts: 240,
        blockSeconds: 5 * 60
    )

    func boot(routes: RoutesBuilder) throws {
        let pub = routes.grouped("pub")

        pub.get { req async throws -> Response in
            try await enforceRateLimit(req)
            let cell = try await publicationCell()
            let directory = try await cell.cell.get(keypath: "publicDirectory", requester: cell.owner)
            var items: [(slug: String, title: String, tagline: String, kindLabel: String)] = []
            if case let .list(values) = directory {
                for value in values {
                    guard let object = PublicationValue.object(value), let slug = PublicationValue.string(object["slug"]) else { continue }
                    items.append((
                        slug: slug,
                        title: PublicationValue.string(object["title"]) ?? slug,
                        tagline: PublicationValue.text(object["tagline"]) ?? "",
                        kindLabel: PublicationSetupAssistant.kindLabel(PublicationValue.string(object["kind"]) ?? "person")
                    ))
                }
            }
            return html(PublicationHTML.renderDirectory(items))
        }

        pub.get(":slug") { req async throws -> Response in
            try await enforceRateLimit(req)
            let slug = try Self.slug(req.parameters.get("slug"))
            let cell = try await publicationCell()
            let value = try await cell.cell.set(keypath: "readPublicSite", value: .object(["slug": .string(slug)]), requester: cell.owner)
            guard let value, let site = PublicationHTML.decode(value) else { return notFound() }
            return html(PublicationHTML.renderFrontPage(site))
        }

        pub.get(":slug", "feed.json") { req async throws -> Response in
            try await enforceRateLimit(req)
            let slug = try Self.slug(req.parameters.get("slug"))
            let cell = try await publicationCell()
            let value = try await cell.cell.set(keypath: "readPublicSite", value: .object(["slug": .string(slug)]), requester: cell.owner)
            guard let value, let object = PublicationValue.object(value), PublicationValue.bool(object["paused"]) != true else { return notFound() }
            let origin = Self.origin(for: req)
            var feed: Object = [
                "version": .string("https://jsonfeed.org/version/1.1"),
                "title": object["title"] ?? .string(slug),
                "home_page_url": .string(origin + PublicationContract.publicPath(slug: slug)),
                "feed_url": .string(origin + PublicationContract.publicPath(slug: slug) + "/feed.json"),
                "description": object["tagline"] ?? .string("")
            ]
            var items: [ValueType] = []
            if case let .list(posts)? = object["posts"] {
                for post in posts {
                    guard let postObject = PublicationValue.object(post), let postSlug = PublicationValue.string(postObject["slug"]) else { continue }
                    var item: Object = [
                        "id": .string(PublicationContract.publicPath(slug: slug, entrySlug: postSlug)),
                        "url": .string(origin + PublicationContract.publicPath(slug: slug, entrySlug: postSlug)),
                        "title": postObject["title"] ?? .string(postSlug),
                        "summary": postObject["summary"] ?? .string("")
                    ]
                    if case let .float(publishedAt)? = postObject["publishedAt"] {
                        item["date_published"] = .string(ISO8601DateFormatter().string(from: Date(timeIntervalSince1970: publishedAt)))
                    }
                    if let author = PublicationValue.string(postObject["authorLabel"]) {
                        item["authors"] = .list([.object(["name": .string(author)])])
                    }
                    items.append(.object(item))
                }
            }
            feed["items"] = .list(items)
            var headers = HTTPHeaders()
            headers.contentType = HTTPMediaType(type: "application", subType: "feed+json", parameters: ["charset": "utf-8"])
            headers.replaceOrAdd(name: .cacheControl, value: "public, max-age=120")
            return Response(status: .ok, headers: headers, body: .init(string: try ValueType.object(feed).jsonString()))
        }

        pub.get(":slug", "media", ":assetID") { req async throws -> Response in
            try await enforceRateLimit(req)
            let slug = try Self.slug(req.parameters.get("slug"))

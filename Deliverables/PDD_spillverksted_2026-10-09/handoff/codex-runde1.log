    /// A public visitor snapshot is not a signer. For an already proof-bound
    /// local web account, attach its exact existing home vault for the fresh
    /// GeneralCell contract challenge. A descriptor cannot choose a root path,
    /// replace a key, create a vault identity, or acquire a grant by this lookup.
    static func localContractSubject(publicDescriptor: Identity) async -> Identity? {
        guard let reference = publicDescriptor.homeVaultReference,
              let domain = reference.split(separator: ":").last.map(String.init),
              UUID(uuidString: domain) != nil else { return nil }
        let vault = BrowserClientIdentityVault(identityDomain: domain)
        guard await vault.identityVaultReference() == reference else { return nil }
        return await vault.existingIdentity(matching: publicDescriptor)
    }

    static func publicIdentitySnapshot(_ identity: Identity) -> Identity {
        let snapshot = Identity(identity.uuid, displayName: identity.displayName, identityVault: nil)
        snapshot.publicSecureKey = identity.publicSecureKey
        snapshot.publicKeyAgreementSecureKey = identity.publicKeyAgreementSecureKey
        snapshot.grants = identity.grants
        snapshot.properties = nil
        snapshot.homeVaultReference = identity.homeVaultReference
        return snapshot
    }

    private static func identitiesHaveSameSigningPublicKey(_ lhs: Identity, _ rhs: Identity) -> Bool {
        guard
            let lhsKey = lhs.publicSecureKey,
            let rhsKey = rhs.publicSecureKey,
            lhsKey.algorithm == rhsKey.algorithm,
            lhsKey.curveType == rhsKey.curveType,
            let lhsCompressed = lhsKey.compressedKey,
            lhsCompressed.isEmpty == false,
            let rhsCompressed = rhsKey.compressedKey,
    private func requesterIdentity(req: Request) async throws -> Identity {
        // Reuse Porthole's account-bound home vault. A fixture persona must
        // never replace a proven account, including in test environments.
        if req.auth.has(FidoUser.self) {
            return try await authenticatedRequesterIdentity(req: req)
        }
        let fixturePersona = req.headers.first(name: "X-Personal-Copilot-User")
            ?? req.query[String.self, at: "persona"]
            ?? req.query[String.self, at: "user"]
        guard req.application.environment == .testing,
              fixturePersona?.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty == false else {
            throw Abort(.unauthorized)
        }
        guard let vault = CellBase.defaultIdentityVault else {
            throw Abort(.internalServerError, reason: "Identity vault not available.")
        }

        let explicitPersona = req.headers.first(name: "X-Personal-Copilot-User")
            ?? req.query[String.self, at: "persona"]
            ?? req.query[String.self, at: "user"]

        let sessionID: String
        if let explicitPersona = explicitPersona?.trimmingCharacters(in: .whitespacesAndNewlines),
           explicitPersona.isEmpty == false {
            sessionID = explicitPersona
        } else {
        }
    }


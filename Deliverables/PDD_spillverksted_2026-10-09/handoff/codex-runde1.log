// SPDX-License-Identifier: Apache-2.0
// purpose://candidate.tool-library.purpose-first-lookup
import CellBase
import Foundation
import ScaffoldKit

struct GameLibraryPurpose: Codable {
    var ref: String
    var title: String
}
struct GameToolLibrary: Decodable {
    var purposes: [GameLibraryPurpose]
    var entries: [Object]

    static func bundled() throws -> GameToolLibrary {
        guard let url = Bundle.module.url(forResource: \"game-tool-library.v1\", withExtension: \"json\", subdirectory: \"GameWorkshop\") else {
            throw CocoaError(.fileNoSuchFile)
        }
        return try JSONDecoder().decode(GameToolLibrary.self, from: Data(contentsOf: url))
    }
    func lookup(purposeRef: String?, text: String?) -> [ValueType] {
        let words = Self.words(text ?? \"\")
        let parent = purposeRef.flatMap(Self.parent)
        var matches: [(index: Int, rank: Int, score: Int, entry: Object)] = []
        for (index, entry) in entries.enumerated() {
            let refs: [String]
            if case .list(let values)? = entry[\"purposeRefs\"] { refs = values.compactMap(Self.string) } else { refs = [] }
            let content = [\"title\", \"childSummary\", \"summary\"].compactMap { Self.string(entry["'$0]) }.joined(separator: " ")
            let score = words.intersection(Self.words(content)).count
            let reason: String
            let rank: Int
            if let purposeRef, refs.contains(purposeRef) { reason = "purpose"; rank = 0 }
            else if let parent, refs.contains(where: { Self.parent($0) == parent }) { reason = "sibling"; rank = 1 }
            else if score > 0 { reason = "text"; rank = 2 }
            else { continue }
            var result = entry; result["matchedBy"] = .string(reason)
            matches.append((index, rank, score, result))
        }
        return matches.sorted {
            if $0.rank != $1.rank { return $0.rank < $1.rank }
            if $0.rank == 2 && $0.score != $1.score { return $0.score > $1.score }
            return $0.index < $1.index
        }.map { .object($0.entry) }
    }
    func groupedPurposes() -> ValueType {
        let groups: [(String, [String])] = [
            ("Bevegelse", ["react-to-input", "gravity-and-jump", "move-object"]),
            ("Treff og poeng", ["detect-collision", "spawn-and-remove", "show-score", "collectible-item"]),
            ("Skjermer og tid", ["timing", "switch-scene"]),
            ("Utseende og lyd", ["character-art", "play-sound"]),
            ("Start et spill", ["platformer-template", "maze-template", "catch-template"])
        ]
        func value(_ purpose: GameLibraryPurpose) -> ValueType { .object(["ref": .string(purpose.ref), "title": .string(purpose.title)]) }
        return .list(groups.map { title, suffixes in
            .object(["title": .string(title), "purposes": .list(suffixes.compactMap { suffix in purposes.first { $0.ref == "purpose://candidate.game.'"\\(suffix)\" } }.map(value))])
        })
    }
    static func string(_ value: ValueType?) -> String? { if case .string(let text)? = value { return text }; return nil }
    private static func parent(_ ref: String) -> String? {
        guard ref.hasPrefix(\"purpose://\"), let dot = ref.lastIndex(of: \".\") else { return nil }
        return String(ref[..<dot])
    }
    private static func words(_ text: String) -> Set<String> {
        let normalized = text.folding(options: [.caseInsensitive, .diacriticInsensitive], locale: Locale(identifier: \"nb_NO\"))
        let stop: Set<String> = [\"en\", \"et\", \"og\", \"eller\", \"til\", \"fra\", \"med\", \"som\", \"det\", \"den\", \"jeg\", \"vil\", \"kan\", \"skal\", \"the\", \"and\", \"of\", \"to\"]
        return Set(normalized.components(separatedBy: CharacterSet.alphanumerics.inverted).filter { "'$0.count > 1 && !stop.contains($0) })
    }
}

/// Read-only catalogue. Lookup is a set operation solely to accept an explicit query;
/// it does not persist user text or change library state.
final class GameToolLibraryCell: GeneralCell, PortholeRuntimeBindingEnsuring {
    private var library: GameToolLibrary?
    required init(owner: Identity) async {
        library = try? GameToolLibrary.bundled()
        await super.init(owner: owner)
        try? await ensureRuntimeReady()
    }
    required init(from decoder: Decoder) throws {
        library = try? GameToolLibrary.bundled()
        try super.init(from: decoder)
    }
    override func installCellRuntimeBindingsForAccess() async throws {
        guard await installBindings(requester: storedOwnerIdentity) else { throw PortholeRuntimeBindingInstallationError.persistedOwnerHomeVaultUnavailable }
    }
    func ensurePortholeRuntimeBindings(requester: Identity) async { _ = await installBindings(requester: requester) }
    private func installBindings(requester: Identity) async -> Bool {
        let owner = await portholeRuntimeOwner(requester: requester)
        return await installPortholeRuntimeBindings(owner: owner, installPermissions: { _ in }, installRuntime: setupKeys)
    }
    private func setupKeys(owner: Identity) async {
        agreementTemplate.ensureGrant("r---", for: "library.purposes")
        agreementTemplate.ensureGrant("rw--", for: "library.lookup")
        await registerGet(key: "library.purposes", owner: owner, returns: ExploreContract.schema(type: "list"), permissions: ["r---"], description: .string("Formål gruppert som på verktøyflaten.")) { [weak self] requester in
            guard let self, await self.validateAccess("r---", at: "library.purposes", for: requester) else { return .null }
            return self.library?.groupedPurposes() ?? GameProjectCell.error("library_unavailable")
        }
        let string = ExploreContract.schema(type: "string")
        let input = ExploreContract.objectSchema(properties: ["purposeRef": string, "text": string], requiredKeys: [])
        await registerSet(key: "library.lookup", owner: owner, input: input, returns: ExploreContract.schema(type: "list"), permissions: ["rw--"], description: .string("Oppslag: eksakt formål, søskenformål, så ordtreff. matchedBy forklarer hvert treff.")) { [weak self] requester, payload in
            guard let self, await self.validateAccess("rw--", at: "library.lookup", for: requester) else { return .null }
            guard let library = self.library else { return GameProjectCell.error("library_unavailable") }
            guard case .object(let raw) = payload else { return GameProjectCell.error("invalid_query") }
            return .list(library.lookup(purposeRef: GameToolLibrary.string(raw["purposeRef"]), text: GameToolLibrary.string(raw["text"])))
        }
    }
}

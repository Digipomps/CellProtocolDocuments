DESKTOP_ZIP_DIR_REL = Path("CellScaffold/Documentation/ClaudeSkills/desktop-zips")


def build_zip(name: str) -> Path:
    """Zip any canon skill as <name>/SKILL.md… into CellScaffold's desktop-zips (Desktop/Cowork upload)."""
    import zipfile
    canon = canon_of_skill(name)
    if canon is None:
        raise SystemExit(f"Skill '{name}' finnes ikke i noen canon")
    source = HAVEN / canon / name
    zip_dir = HAVEN / DESKTOP_ZIP_DIR_REL
    zip_dir.mkdir(parents=True, exist_ok=True)
    zip_path = zip_dir / f"{name}.zip"
    with zipfile.ZipFile(zip_path, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        for path in sorted(source.rglob("*")):
            if path.is_file() and ".DS_Store" not in path.name:
                archive.write(path, str(Path(name) / path.relative_to(source)))
    return zip_path


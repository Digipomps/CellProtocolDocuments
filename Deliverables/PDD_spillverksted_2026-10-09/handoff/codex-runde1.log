final class PurposeReviewCellTests: IsolatedCellTestCase {
    func testImportedTreeIsProjectedForThePurposeTreeVisualization() async throws {
        let owner = await makeCellProtocolTestIdentity("purpose-review-owner")
        let cell = await PurposeReviewCell(owner: owner)

        let empty = try await state(cell, owner)
        XCTAssertEqual(empty["hasSelection"], .bool(false))
        XCTAssertNotNil(string(empty["emptyText"]))

        let imported = try await set(cell, PurposeReviewContract.importKeypath, try fixtureTree(), owner)
        XCTAssertEqual(imported["ok"], .bool(true), "\(imported)")

        let projected = try await state(cell, owner)
        XCTAssertEqual(projected["hasSelection"], .bool(true))
        let selected = try XCTUnwrap(object(projected["selected"]))
        XCTAssertEqual(string(selected["gateText"]), "G1 venter på deg")
        XCTAssertEqual(string(selected["countsText"]), "2 grener · 3 bladformål")
        XCTAssertEqual(selected["revision"], .integer(1))
        let tree = try XCTUnwrap(object(selected["tree"]))
        XCTAssertEqual(string(tree["schema"]), PurposeReviewContract.treeSchema)
        XCTAssertEqual(string(tree["rootRef"]), "purpose://candidate.example.root")
        guard case .list(let nodes)? = tree["nodes"] else { return XCTFail("nodes missing") }
        XCTAssertEqual(nodes.count, 6)
    }

    func testMalformedTreesAreRefusedWithAReason() async throws {
        let owner = await makeCellProtocolTestIdentity("purpose-review-invalid")
        let cell = await PurposeReviewCell(owner: owner)
        let node = { (ref: String, parent: String?) -> ValueType in
            .object(["ref": .string(ref), "parentRef": parent.map(ValueType.string) ?? .null, "title": .string(ref)])
        }
        let tree = { (nodes: [ValueType]) -> ValueType in
            .object([
                "id": .string("t"), "title": .string("T"),
                "rootRef": .string("purpose://r"), "nodes": .list(nodes)
            ])
        }
        let cases: [ValueType] = [
            tree([node("purpose://r", nil), node("purpose://a", "purpose://missing")]),
            tree([node("purpose://r", nil), node("purpose://r", nil)]),
            tree([node("purpose://r", nil), node("purpose://a", "purpose://b"), node("purpose://b", "purpose://a")]),
            tree([node("r", nil)]),
            .object(["title": .string("Uten id")])
        ]
        for payload in cases {
            let result = try await set(cell, PurposeReviewContract.importKeypath, payload, owner)
            XCTAssertEqual(string(result["error"]), "invalid_tree", "\(payload)")
        }
        let after = try await state(cell, owner)
        XCTAssertEqual(after["reviewCount"], .integer(0))
    }


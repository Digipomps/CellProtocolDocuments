const template = fs.readFileSync(path.join(__dirname, '"'../Sources/App/Resources/GameWorkshop/sandbox.html'), 'utf8');
function document(code) {
  const offset = template.slice(0, template.indexOf('__GAME_CODE__')).split('\\n').length - 1;
  return template.replaceAll('__GAME_OFFSET__', String(offset)).replace('__GAME_CODE__', code.replace(/<\\/script/gi, '<\\\\/script'));
}
async function mount(page, code, direct = false) {

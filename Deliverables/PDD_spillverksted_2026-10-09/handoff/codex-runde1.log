def skill_names_of(entry: dict) -> list[str]:
    names = []
    for t in entry.get("targets") or []:
        ref = t.get("ref", "")
        if ref.startswith(("skill:", "new-skill:")):
            names.append(ref.split(":", 1)[1])
    return names


def canon_of_skill(name: str) -> str | None:
    for canon in SKILL_CANONS:
        if (HAVEN / canon / name / "SKILL.md").is_file():
            return canon
    return None


def run_sync_on_mac(skills: list[str], build_artifacts: bool, dry_run: bool) -> tuple[bool, str]:
    """Run sync_claude_desktop_skills.py per canon. Returns (ok, transcript)."""
    transcript: list[str] = []
    ok = True
    for canon, names in group_skills_by_canon(skills).items():
        argv = sync_argv(canon, names, build_artifacts=build_artifacts, dry_run=dry_run)
        cmd = [sys.executable, str(HAVEN / argv[0])] + argv[1:]
        transcript.append("$ " + " ".join(cmd))
        proc = subprocess.run(cmd, capture_output=True, text=True, check=False, cwd=str(HAVEN))
        transcript.append(proc.stdout.strip())
        if proc.returncode != 0:
            ok = False
            transcript.append(f"[exit {proc.returncode}] {proc.stderr.strip()}")
        elif build_artifacts and not dry_run and str(Path(canon).parents[1]) != "CellScaffold":
            for n in names:
                transcript.append(f"Built {build_zip(n)}")
    return ok, "\n".join(transcript)


def group_skills_by_canon(skills: list[str]) -> dict[str, list[str]]:
    """Map canon dir → skill names. Unknown skills are refused: a queued job must not fail on the Mac."""
    by_canon: dict[str, list[str]] = {}
    for name in skills:
        canon = canon_of_skill(name)
        if canon is None:
            raise SystemExit(f"Skill '{name}' finnes ikke i noen canon ({', '.join(SKILL_CANONS)})")
        by_canon.setdefault(canon, []).append(name)
    return by_canon



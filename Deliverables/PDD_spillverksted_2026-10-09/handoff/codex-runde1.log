def resolve_target(ref: str, *, allow_create: bool, description: str, what: str,
                   ledger_id: str, skill_canon: str) -> dict:
    if ":" not in ref:
        raise SystemExit(f"Ugyldig mål '{ref}'. Bruk {', '.join(p + ':<…>' for p in TARGET_PREFIXES)}")
    prefix, value = ref.split(":", 1)
    if prefix not in TARGET_PREFIXES:
        raise SystemExit(f"Ukjent målprefiks '{prefix}'. Gyldige: {', '.join(TARGET_PREFIXES)}")
    created = False
    if prefix == "skill":
        md = find_skill(value)
        if md is None:
            raise SystemExit(
                f"Fant ingen skill '{value}' i {', '.join(SKILL_CANONS)}. "
                f"Kjør `route --query …` for kandidater, eller bruk --target new-skill:{value}")
        path = md
    elif prefix == "new-skill":
        if not allow_create:
            raise SystemExit("new-skill krever --description (én setning: når skal skillen brukes)")
        path = scaffold_skill(value, description, what, ledger_id, canon=skill_canon)
        created = True
    elif prefix == "entrypoint":
        path = HAVEN / value
    else:  # prompt, doc, file
        path = HAVEN / value
        if not path.exists():
            raise SystemExit(f"Målfilen finnes ikke: {path} (relativt til HAVEN-roten {HAVEN})")
    rel_path = rel(path)
    if re.search(r"(^|/)(_wt-[^/]*|_worktrees|_handoff|_to_delete|tmp)(/|$)", rel_path):

def settle_session(session_id: str | None, outcome: str, detail: str) -> str | None:
    sid = session_id or latest_pending_session()
    if not sid:
        return None
    marker = session_marker(sid)
    data = {}
    if marker.is_file():
        try:
            data = json.loads(marker.read_text())
        except (OSError, json.JSONDecodeError):
            data = {}
    data.update({"state": "done", "outcome": outcome, "detail": detail, "settledAt": now_iso()})
    write_atomic(marker, json.dumps(data, ensure_ascii=False, indent=1))
    return sid

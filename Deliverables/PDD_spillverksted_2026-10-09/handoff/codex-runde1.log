                         "Neste tråd leser canon (CellScaffold/.claude/skills, Book/, Documentation/) — "
                         "pek dit hvis læringen skal overleve.\n")
    return {
        "ref": ref,
        "path": rel_path,
        "hashBefore": None if created else sha256_file(path),
        "created": created,
        "applied": False,
        "appliedAt": None,
        "hashAfter": None,
    }



@testable import App
import XCTest
import CellBase

final class ProjectPortfolioCellTests: IsolatedCellTestCase {
    func testSelectAcceptsSkeletonActivationAndSelectionPayloads() async throws {
        try await withDebugAccess { owner, cell in
            for id in ["project-a", "project-b"] {
                _ = try await cell.set(
                    keypath: "capture",
                    value: .object(["id": .string(id), "name": .string(id)]),
                    requester: owner
                )
            }
            let payloads: [(ValueType, String)] = [
                (.object(["trigger": .string("select"), "selected": .string("project-a")]), "project-a"),
                (.object(["trigger": .string("activate"), "interacted": .string("project-b"), "selected": .string("project-a")]), "project-b"),
                (.object(["selected": .object(["id": .string("project-a")])]), "project-a"),
                (.object(["projectID": .string("project-b")]), "project-b"),
                (.string("project-a"), "project-a")
            ]
            for (payload, expectedID) in payloads {
                let result = try await cell.set(keypath: "select", value: payload, requester: owner)
                let ack = try XCTUnwrap(object(result))
                XCTAssertEqual(string(ack["status"]), "ok")
                XCTAssertEqual(string(ack["operation"]), "projectPortfolio.select")
                XCTAssertEqual(string(ack["entityID"]), expectedID)
                let state = try await cell.get(keypath: "state", requester: owner)
                XCTAssertEqual(string(object(object(state)?["selectedProject"])?["id"]), expectedID)
            }
            for invalid in [ValueType.object([:]), .object(["selected": .string("unknown-project")])] {
                let result = try await cell.set(keypath: "select", value: invalid, requester: owner)
                XCTAssertEqual(string(object(result)?["status"]), "error")
                let state = try await cell.get(keypath: "state", requester: owner)
                XCTAssertEqual(string(object(object(state)?["selectedProject"])?["id"]), "project-a")
            }
        }
    }

    func testProjectPortfolioCapturesAndQueriesProjects() async throws {
        try await withDebugAccess { owner, cell in
            let capture = try await cell.set(
                keypath: "capture",
                value: .object([
                    "id": .string("project-haven-1"),
                    "name": .string("HAVEN Workbench"),
                    "summary": .string("Canonical workspace for project intake, triage, backlog, docs, and roadmap views."),
                    "status": .string("active"),
                    "health": .string("yellow"),
                    "priority": .string("P1"),
                    "ownerRef": .string("identity:///kjetil"),
                    "repoRefs": .list([.string("CellScaffold")]),
                    "cellRefs": .list([.string("cell:///WorkItem"), .string("cell:///ProjectPortfolio")]),
                    "workItemRefs": .list([.string("work-bug-1")]),
                    "labels": .list([.string("project-handler"), .string("workbench")]),
                    "currentFocus": .string("Make V0 usable by assistants"),
                    "nextAction": .string("Wire ProjectPortfolioCell into HAVEN Workbench")
                ]),
                requester: owner
            )

            let captureObject = try XCTUnwrap(object(capture))
            XCTAssertEqual(string(captureObject["status"]), "ok")
            XCTAssertEqual(string(captureObject["operation"]), "projectPortfolio.capture")
            XCTAssertEqual(string(captureObject["entityType"]), "project")
            XCTAssertEqual(string(captureObject["entityID"]), "project-haven-1")
            XCTAssertNotNil(string(captureObject["eventID"]))
            XCTAssertEqual(int(captureObject["stateVersion"]), 1)
            XCTAssertNil(object(captureObject["state"]))

            let project = try XCTUnwrap(object(captureObject["project"]))
            XCTAssertEqual(string(project["id"]), "project-haven-1")
            XCTAssertEqual(string(project["status"]), "active")
            XCTAssertEqual(string(project["health"]), "yellow")
            XCTAssertEqual(int(project["workItemCount"]), 1)
            XCTAssertEqual(string(project["repoText"]), "CellScaffold")

            let stateValue = try await cell.get(keypath: "state", requester: owner)
            let state = try XCTUnwrap(object(stateValue))
            XCTAssertEqual(string(state["schemaVersion"]), "haven.project-portfolio.v0.3")
            XCTAssertEqual(int(state["totalCount"]), 1)
            XCTAssertEqual(int(state["openCount"]), 1)
            XCTAssertEqual(int(state["activeCount"]), 1)
            XCTAssertEqual(int(state["yellowCount"]), 1)
            XCTAssertEqual(int(state["riskCount"]), 1)
            XCTAssertEqual(string(object(state["selectedProject"])?.get("name")), "HAVEN Workbench")

            let query = try await cell.set(
                keypath: "query",
                value: .object([
                    "health": .string("yellow"),
                    "label": .string("workbench"),
                    "search": .string("assistants")
                ]),
                requester: owner
            )
            let queryObject = try XCTUnwrap(object(query))
            XCTAssertEqual(string(queryObject["status"]), "ok")
            XCTAssertEqual(int(queryObject["count"]), 1)
            let projects = list(queryObject["projects"])
            XCTAssertEqual(string(object(projects.first)?.get("id")), "project-haven-1")
        }
    }


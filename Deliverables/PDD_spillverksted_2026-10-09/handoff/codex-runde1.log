// SPDX-License-Identifier: Apache-2.0
// SPDX-FileCopyrightText: Copyright (c) 2026 Stiftelsen Digipomps and HAVEN contributors

import CellBase
import Foundation
import ScaffoldKit

/// Formålstre til godkjenning: et PDD-formålstre (FORMAALSSPEC §1) som eieren
/// leser, kommenterer og godkjenner eller ber om endringer i. Treet er et
/// forslag; cellen gir ingen rettigheter og endrer ikke Book 23. En beslutning
/// lagres med treets revisjon og sendes på `haven.purpose.review`, så agenten
/// som laget treet kan fortsette uten at noen må gjenta beslutningen i chat.
enum PurposeReviewContract {
    static let cellName = "PurposeReview"
    static let endpoint = "cell:///PurposeReview"

    static let stateKeypath = "review.state"
    static let importKeypath = "review.import"
    static let setDraftImportKeypath = "review.setDraftImport"
    static let importDraftKeypath = "review.importDraft"
    static let selectKeypath = "review.select"
    static let setDraftCommentKeypath = "review.setDraftComment"
    static let commentNodeKeypath = "review.commentNode"
    static let approveKeypath = "review.approve"
    static let requestChangesKeypath = "review.requestChanges"

    static let topic = "haven.purpose.review"
    static let treeSchema = "haven.purpose-review.v0"
    static let decisionSchema = "haven.purpose-review-decision.v0"
    static let approved = "godkjent"
    static let changesRequested = "endringer"
    static let maxNodes = 400
}

struct PurposeReviewNode: Codable, Equatable {
    var ref: String
    var parentRef: String?
    var code: String?
    var title: String
    var composition: String?
    var outcome: String?
    var signals: [String]?
    var verifier: String?
    var status: String?
    var phase: String?
    var why: String?
    var reused: String?
}

struct PurposeReviewDocument: Codable, Equatable {
    var id: String
    var title: String
    var pdd: String?
    var gate: String?
    var anchorRef: String?
    var anchorNote: String?
    var rootRef: String
    var nodes: [PurposeReviewNode]
    var next: [String]?
    var revision: Int?
    var importedAt: String?
}

struct PurposeReviewDecision: Codable, Equatable {
    var id: String
    var reviewID: String
    var pdd: String?
    var gate: String
    var decision: String
    var comment: String
    var at: String
    var by: String
    var revision: Int
}

final class PurposeReviewCell: GeneralCell {
    private enum CodingKeys: CodingKey {
        case reviews
        case decisions
        case selectedID
        case draftComments
        case commentedRefs
    }

    private let stateQueue = DispatchQueue(label: "PurposeReviewCell.State")
    private var reviews: [String: PurposeReviewDocument] = [:]
    private var decisions: [PurposeReviewDecision] = []
    private var selectedID: String?
    private var draftComments: [String: String] = [:]
    private var commentedRefs: [String: [String]] = [:]
    // Utkastet til import er bare skjematilstand og lagres ikke.
    private var draftImport = ""
    private var lastMessage: String?

    required init(owner: Identity) async {
        await super.init(owner: owner)
        try? await ensureRuntimeReady()
    }

    required init(from decoder: Decoder) throws {
        let container = try decoder.container(keyedBy: CodingKeys.self)
        reviews = try container.decodeIfPresent([String: PurposeReviewDocument].self, forKey: .reviews) ?? [:]
        decisions = try container.decodeIfPresent([PurposeReviewDecision].self, forKey: .decisions) ?? []
        selectedID = try container.decodeIfPresent(String.self, forKey: .selectedID)
        draftComments = try container.decodeIfPresent([String: String].self, forKey: .draftComments) ?? [:]
        commentedRefs = try container.decodeIfPresent([String: [String]].self, forKey: .commentedRefs) ?? [:]
        try super.init(from: decoder)
    }

    override func encode(to encoder: Encoder) throws {
        try super.encode(to: encoder)
        var container = encoder.container(keyedBy: CodingKeys.self)
        let snapshot = stateQueue.sync { (reviews, decisions, selectedID, draftComments, commentedRefs) }
        try container.encode(snapshot.0, forKey: .reviews)
        try container.encode(snapshot.1, forKey: .decisions)
        try container.encodeIfPresent(snapshot.2, forKey: .selectedID)
        try container.encode(snapshot.3, forKey: .draftComments)
        try container.encode(snapshot.4, forKey: .commentedRefs)
    }

    override func installCellRuntimeBindingsForAccess() async throws {
        let owner = storedOwnerIdentity
        setupPermissions()
        await setupRuntime(owner: owner)
    }

    private static let ownerActions = [
        PurposeReviewContract.importKeypath,
        PurposeReviewContract.setDraftImportKeypath,
        PurposeReviewContract.importDraftKeypath,
        PurposeReviewContract.selectKeypath,
        PurposeReviewContract.setDraftCommentKeypath,
        PurposeReviewContract.commentNodeKeypath,
        PurposeReviewContract.approveKeypath,
        PurposeReviewContract.requestChangesKeypath
    ]

    private func setupPermissions() {
        agreementTemplate.ensureGrant("r---", for: PurposeReviewContract.stateKeypath)
        Self.ownerActions.forEach { agreementTemplate.ensureGrant("rw--", for: $0) }
    }

    private func setupRuntime(owner: Identity) async {
        let string = ExploreContract.schema(type: "string")
        let object = ExploreContract.schema(type: "object")
        let result = ExploreContract.objectSchema(
            properties: ["ok": ExploreContract.schema(type: "bool"), "error": string, "message": string],
            requiredKeys: ["ok"]
        )

        await registerGet(
            key: PurposeReviewContract.stateKeypath,
            owner: owner,
            returns: object,
            permissions: ["r---"],
            description: .string("Formålstrær til godkjenning, valgt tre (\(PurposeReviewContract.treeSchema)), utkast og beslutninger.")
        ) { [weak self] requester in
            guard let self else { return .null }
            guard await self.validateAccess("r---", at: PurposeReviewContract.stateKeypath, for: requester) else {
                return .object(Self.error("not_authorized", "Å lese formålstrærne krever tilgang."))
            }
            return .object(self.stateProjection())
        }

        let actions: [(String, ValueType, String, (PurposeReviewCell, Identity, ValueType) async -> Object)] = [
            (PurposeReviewContract.importKeypath, object,
             "Legg inn eller erstatt et formålstre (\(PurposeReviewContract.treeSchema)). Samme id gir ny revisjon; beslutningene beholdes.",
             { cell, requester, payload in cell.importTree(payload, requester: requester) }),
            (PurposeReviewContract.setDraftImportKeypath, string,
             "Skjemautkast: JSON for et formålstre som skal legges inn.",
             { cell, _, payload in cell.setDraftImport(payload) }),
            (PurposeReviewContract.importDraftKeypath, object,
             "Legg inn formålstreet fra skjemautkastet.",
             { cell, requester, _ in cell.importDraftTree(requester: requester) }),
            (PurposeReviewContract.selectKeypath, object,
             "Velg formålstreet som vises. Payload: {id}.",
             { cell, _, payload in cell.select(payload) }),
            (PurposeReviewContract.setDraftCommentKeypath, string,
             "Kommentarutkast for valgt formålstre.",
             { cell, _, payload in cell.setDraftComment(payload) }),
            (PurposeReviewContract.commentNodeKeypath, object,
             "Henvis til et formål i kommentaren. Payload fra purposeTree-visningen: {id, item: {ref, code}}.",
             { cell, _, payload in cell.commentNode(payload) }),
            (PurposeReviewContract.approveKeypath, object,
             "Eieren godkjenner porten for valgt formålstre. Sendes på \(PurposeReviewContract.topic).",
             { cell, requester, _ in await cell.decide(PurposeReviewContract.approved, requester: requester) }),
            (PurposeReviewContract.requestChangesKeypath, object,
             "Eieren ber om endringer i valgt formålstre. Krever kommentar. Sendes på \(PurposeReviewContract.topic).",
             { cell, requester, _ in await cell.decide(PurposeReviewContract.changesRequested, requester: requester) })
        ]
        for (key, input, description, handler) in actions {
            await registerSet(
                key: key,
                owner: owner,
                input: input,
                returns: result,
                permissions: ["rw--"],
                description: .string(description)
            ) { [weak self] requester, payload in
                guard let self else { return .null }
                // Formålstreet er eierens. Deling til andre godkjennere er ikke bygget.
                guard requester.uuid == owner.uuid,
                      await self.validateAccess("rw--", at: key, for: requester) else {
                    return .object(Self.error("not_authorized", "Bare eieren kan endre eller godkjenne formålstrærne."))
                }
                return .object(await handler(self, requester, payload))
            }
        }
    }

    // MARK: - Actions

    private func importTree(_ payload: ValueType, requester: Identity) -> Object {
        guard case .object(let raw) = payload,
              let data = try? JSONEncoder().encode(ValueType.object(raw)),
              let document = try? JSONDecoder().decode(PurposeReviewDocument.self, from: data) else {
            return remember(Self.error("invalid_tree", "Forventet et formålstre med id, title, rootRef og nodes."))
        }
        return store(document, requester: requester)
    }

    private func importDraftTree(requester: Identity) -> Object {
        let text = stateQueue.sync { draftImport }
        guard let data = text.data(using: .utf8),
              let document = try? JSONDecoder().decode(PurposeReviewDocument.self, from: data) else {
            return remember(Self.error("invalid_tree", "Teksten er ikke et formålstre. Lim inn tree.json med id, title, rootRef og nodes."))
        }
        let stored = store(document, requester: requester)
        if case .bool(true)? = stored["ok"] {
            stateQueue.sync { draftImport = "" }
        }
        return stored
    }

    private func store(_ incoming: PurposeReviewDocument, requester: Identity) -> Object {
        if let problem = Self.validationProblem(incoming) {
            return remember(Self.error("invalid_tree", problem))
        }
        let message: String = stateQueue.sync {
            var document = incoming
            document.revision = (reviews[document.id]?.revision ?? 0) + 1
            document.importedAt = Self.now()
            reviews[document.id] = document
            selectedID = document.id
            commentedRefs[document.id] = []
            return "«\(document.title)» er lagt inn som revisjon \(document.revision ?? 1)."
        }
        let output = remember(["ok": .bool(true), "message": .string(message)])
        emit(title: "purpose.review.imported", content: ["reviewID": .string(incoming.id)], requester: requester)
        return output
    }

    private func setDraftImport(_ payload: ValueType) -> Object {
        stateQueue.sync { draftImport = Self.text(payload) ?? "" }
        return ["ok": .bool(true)]
    }

    private func select(_ payload: ValueType) -> Object {
        let requested = Self.text(payload) ?? Self.field("id", in: payload)
        return stateQueue.sync {
            guard let requested, reviews[requested] != nil else {
                return Self.error("unknown_review", "Fant ikke formålstreet.")
            }
            selectedID = requested
            return ["ok": .bool(true)]
        }
    }

    private func setDraftComment(_ payload: ValueType) -> Object {
        stateQueue.sync {
            guard let id = currentID() else { return Self.error("no_review", "Ingen formålstre er valgt.") }
            draftComments[id] = Self.text(payload) ?? ""
            return ["ok": .bool(true)]
        }
    }

    private func commentNode(_ payload: ValueType) -> Object {
        let ref = Self.field("id", in: payload) ?? Self.field("ref", in: payload)
        return stateQueue.sync {
            guard let id = currentID(), let review = reviews[id] else {
                return Self.error("no_review", "Ingen formålstre er valgt.")
            }
            guard let ref, let node = review.nodes.first(where: { $0.ref == ref }) else {
                return Self.error("unknown_purpose", "Formålet finnes ikke i treet.")
            }
            let label = node.code?.isEmpty == false ? node.code! : node.title
            let current = (draftComments[id] ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
            draftComments[id] = (current.isEmpty ? "" : current + "\n") + "[\(label)] "
            var marked = commentedRefs[id] ?? []
            if !marked.contains(ref) { marked.append(ref) }
            commentedRefs[id] = marked
            return ["ok": .bool(true)]
        }
    }

    private func decide(_ decision: String, requester: Identity) async -> Object {
        let outcome: Result<PurposeReviewDecision, PurposeReviewFailure> = stateQueue.sync {
            guard let id = currentID(), let review = reviews[id] else {
                return .failure(.init(code: "no_review", message: "Ingen formålstre er valgt."))
            }
            let comment = (draftComments[id] ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
            if decision == PurposeReviewContract.changesRequested && comment.isEmpty {
                return .failure(.init(code: "comment_required", message: "Skriv hva du vil ha endret, så vet agenten hva neste runde skal gjøre."))
            }
            let record = PurposeReviewDecision(
                id: UUID().uuidString,
                reviewID: id,
                pdd: review.pdd,
                gate: review.gate ?? "G1",
                decision: decision,
                comment: comment,
                at: Self.now(),
                by: requester.uuid,
                revision: review.revision ?? 1
            )
            decisions.append(record)
            draftComments[id] = ""
            commentedRefs[id] = []
            return .success(record)
        }
        switch outcome {
        case .failure(let failure):
            return remember(Self.error(failure.code, failure.message))
        case .success(let record):
            emit(title: "purpose.review.decision", content: Self.decisionObject(record), requester: requester)
            let text = record.decision == PurposeReviewContract.approved
                ? "\(record.gate) er godkjent for revisjon \(record.revision). Beslutningen er sendt på \(PurposeReviewContract.topic)."
                : "Endringer er bedt om for revisjon \(record.revision). Kommentaren er sendt på \(PurposeReviewContract.topic)."
            return remember(["ok": .bool(true), "message": .string(text)])
        }
    }

    // MARK: - Projection

    private func stateProjection() -> Object {
        let snapshot = stateQueue.sync {
            (reviews, decisions, currentID(), draftComments, commentedRefs, draftImport, lastMessage)
        }
        let summaries: [ValueType] = snapshot.0.values
            .sorted { ($0.importedAt ?? "") > ($1.importedAt ?? "") }
            .map { review in
                let latest = snapshot.1.last { $0.reviewID == review.id }
                return .object(Object.build {
                    $0["id"] = .string(review.id)
                    $0["title"] = .string(review.title)
                    $0["gateText"] = .string(Self.gateText(review, latest: latest))
                    $0["selected"] = .bool(review.id == snapshot.2)
                    $0["selectPayload"] = .object(["id": .string(review.id)])
                })
            }
        return Object.build {
            $0["schema"] = .string("haven.purpose-review-state.v0")
            $0["reviewCount"] = .integer(snapshot.0.count)
            $0["reviews"] = .list(summaries)
            $0["hasSelection"] = .bool(snapshot.2 != nil)
            $0["message"] = snapshot.6.map(ValueType.string) ?? .null
            $0["draftImport"] = .string(snapshot.5)
            guard let id = snapshot.2, let review = snapshot.0[id] else {
                $0["emptyText"] = .string("Ingen formålstre er lagt inn ennå. Lim inn tree.json fra en PDD, eller la agenten legge det inn med review.import.")
                return
            }
            let history = snapshot.1.filter { $0.reviewID == id }.reversed()
            $0["selected"] = .object(Self.selectedObject(
                review,
                latest: history.first,
                commented: snapshot.4[id] ?? []
            ))
            $0["draft"] = .object(["comment": .string(snapshot.3[id] ?? "")])
            $0["decisions"] = .list(history.map { .object(Self.decisionRow($0)) })
            $0["decisionCount"] = .integer(history.count)
        }
    }

    private static func selectedObject(
        _ review: PurposeReviewDocument,
        latest: PurposeReviewDecision?,
        commented: [String]
    ) -> Object {
        let branches = review.nodes.filter { $0.parentRef == review.rootRef }.count
        let parents = Set(review.nodes.compactMap(\.parentRef))
        let leaves = review.nodes.filter { !parents.contains($0.ref) }.count
        let gate = review.gate ?? "G1"
        return Object.build {
            $0["id"] = .string(review.id)
            $0["title"] = .string(review.title)
            $0["pdd"] = review.pdd.map(ValueType.string) ?? .null
            $0["gate"] = .string(gate)
            $0["revision"] = .integer(review.revision ?? 1)
            $0["gateText"] = .string(gateText(review, latest: latest))
            $0["headline"] = .string("Formålsplan · \(review.pdd ?? review.id) · port \(gate) · revisjon \(review.revision ?? 1)")
            $0["countsText"] = .string("\(branches) grener · \(leaves) bladformål")
            $0["nextText"] = .string((review.next ?? []).enumerated().map { "\($0.offset + 1). \($0.element)" }.joined(separator: "\n"))
            $0["tree"] = .object(Object.build { tree in
                tree["schema"] = .string(PurposeReviewContract.treeSchema)
                tree["title"] = .string(review.title)
                tree["rootRef"] = .string(review.rootRef)
                tree["anchorRef"] = review.anchorRef.map(ValueType.string) ?? .null
                tree["anchorNote"] = review.anchorNote.map(ValueType.string) ?? .null
                tree["countsText"] = .string("\(branches) grener · \(leaves) bladformål")
                tree["commentedRefs"] = .list(commented.map(ValueType.string))
                tree["nodes"] = .list(review.nodes.map { .object(nodeObject($0)) })
            })
        }
    }

    private static func nodeObject(_ node: PurposeReviewNode) -> Object {
        Object.build {
            $0["ref"] = .string(node.ref)
            $0["parentRef"] = node.parentRef.map(ValueType.string) ?? .null
            $0["code"] = node.code.map(ValueType.string) ?? .null
            $0["title"] = .string(node.title)
            $0["composition"] = node.composition.map(ValueType.string) ?? .null
            $0["outcome"] = node.outcome.map(ValueType.string) ?? .null
            $0["signals"] = .list((node.signals ?? []).map(ValueType.string))
            $0["verifier"] = node.verifier.map(ValueType.string) ?? .null
            $0["status"] = node.status.map(ValueType.string) ?? .null
            $0["phase"] = node.phase.map(ValueType.string) ?? .null
            $0["why"] = node.why.map(ValueType.string) ?? .null
            $0["reused"] = node.reused.map(ValueType.string) ?? .null
        }
    }

    private static func decisionObject(_ record: PurposeReviewDecision) -> Object {
        Object.build {
            $0["schema"] = .string(PurposeReviewContract.decisionSchema)
            $0["id"] = .string(record.id)
            $0["reviewID"] = .string(record.reviewID)
            $0["pdd"] = record.pdd.map(ValueType.string) ?? .null
            $0["gate"] = .string(record.gate)
            $0["decision"] = .string(record.decision)
            $0["comment"] = .string(record.comment)
            $0["at"] = .string(record.at)
            $0["by"] = .string(record.by)
            $0["revision"] = .integer(record.revision)
        }
    }

    private static func decisionRow(_ record: PurposeReviewDecision) -> Object {
        var row = decisionObject(record)
        let label = record.decision == PurposeReviewContract.approved ? "Godkjent" : "Endringer bedt om"
        row["headline"] = .string("\(label) · \(record.gate) · revisjon \(record.revision) · \(record.at)")
        return row
    }

    private static func gateText(_ review: PurposeReviewDocument, latest: PurposeReviewDecision?) -> String {
        let gate = review.gate ?? "G1"
        guard let latest, latest.revision == (review.revision ?? 1) else {
            return "\(gate) venter på deg"
        }
        return latest.decision == PurposeReviewContract.approved ? "\(gate) godkjent" : "Endringer bedt om"
    }

    // MARK: - Validation

    static func validationProblem(_ document: PurposeReviewDocument) -> String? {
        if document.id.trimmingCharacters(in: .whitespaces).isEmpty { return "Treet mangler id." }
        if document.nodes.isEmpty { return "Treet har ingen formål." }
        if document.nodes.count > PurposeReviewContract.maxNodes {
            return "Treet har flere enn \(PurposeReviewContract.maxNodes) formål."
        }
        var byRef: [String: PurposeReviewNode] = [:]
        for node in document.nodes {
            guard node.ref.hasPrefix("purpose://") else { return "\(node.ref) er ikke en purpose://-ref." }
            guard byRef[node.ref] == nil else { return "\(node.ref) står mer enn én gang." }
            byRef[node.ref] = node
        }
        guard let root = byRef[document.rootRef], root.parentRef == nil else {
            return "rootRef må være et formål i treet uten parentRef."
        }
        for node in document.nodes where node.ref != document.rootRef {
            guard let parent = node.parentRef, byRef[parent] != nil else {
                return "\(node.ref) har ingen forelder i treet."
            }
            var seen: Set<String> = [node.ref]
            var cursor = byRef[parent]
            while let current = cursor {
                guard seen.insert(current.ref).inserted else { return "Treet har en sykel gjennom \(current.ref)." }
                cursor = current.parentRef.flatMap { byRef[$0] }
            }
        }
        return nil
    }

    // MARK: - Helpers

    private func currentID() -> String? {
        if let selectedID, reviews[selectedID] != nil { return selectedID }
        return reviews.values.max { ($0.importedAt ?? "") < ($1.importedAt ?? "") }?.id
    }

    private func remember(_ output: Object) -> Object {
        let text: String?
        if case .string(let message)? = output["message"] { text = message } else { text = nil }
        stateQueue.sync { lastMessage = text }
        return output
    }

    private func emit(title: String, content: Object, requester: Identity) {
        var flow = FlowElement(
            title: title,
            content: .object(content),
            properties: FlowElement.Properties(type: .event, contentType: .object)
        )
        flow.topic = PurposeReviewContract.topic
        flow.origin = uuid
        pushFlowElement(flow, requester: requester)
    }

    private static func text(_ value: ValueType) -> String? {
        if case .string(let string) = value { return string }
        return nil
    }

    private static func field(_ key: String, in value: ValueType) -> String? {
        guard case .object(let object) = value else { return nil }
        if case .string(let string)? = object[key], !string.isEmpty { return string }
        if case .object(let item)? = object["item"], case .string(let string)? = item[key], !string.isEmpty {
            return string
        }
        return nil
    }

    private static func now() -> String {
        ISO8601DateFormatter().string(from: Date())
    }

    private static func error(_ code: String, _ message: String) -> Object {
        ["ok": .bool(false), "error": .string(code), "message": .string(message)]
    }
}

private struct PurposeReviewFailure: Error {
    var code: String
    var message: String
}

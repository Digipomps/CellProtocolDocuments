          let activeVaultReference = await vault.identityVaultReference(),
          homeVaultReference == activeVaultReference,
          identity.signingPublicKeyFingerprint != nil else {
        return false
    }
    return await vault.identityExistInVault(identity)
}

public extension PortholeRuntimeBindingEnsuring where Self: GeneralCell {
    func portholeRuntimeOwner(requester: Identity) async -> Identity {
        if let runtimeOwner = await verifiedRuntimeOwnerIdentity(),
           await identityIsBoundToAttachedHomeVault(runtimeOwner) {
            return runtimeOwner
        }

        let candidate = storedOwnerIdentity

        if PortholeRuntimeBindingIdentityKey.referencesSameCryptographicIdentity(candidate, requester),
           await identityIsBoundToAttachedHomeVault(requester),
           await restoreStoredOwnerIdentity(using: requester) {
            return requester
        }

        if let hydratedOwner = try? await PaymentGateOwnerIdentitySupport.requireSigningIdentity(
            for: candidate
        ), await restoreStoredOwnerIdentity(using: hydratedOwner) {
            return hydratedOwner
        }

        if await identityIsBoundToAttachedHomeVault(candidate),
           await restoreStoredOwnerIdentity(using: candidate) {
            return candidate
        }
        return candidate
    }

    @discardableResult
    func installPortholeRuntimeBindings(
        owner: Identity,
        installPermissions: (Identity) async -> Void,
        installRuntime: (Identity) async -> Void
    ) async -> Bool {
        let targetID = ObjectIdentifier(self)
        if await portholeRuntimeBindingInstallStore.runtimeIsComplete(
            target: self,
            targetID: targetID
        ) {
            return true
        }
        guard await identityIsBoundToAttachedHomeVault(owner) else {
            CellBase.diagnosticLog(
                "Porthole runtime binding requires the persisted owner key in its exact home vault",
                domain: .identity
            )
            return false
        }
        let ownerKey = await PortholeRuntimeBindingIdentityKey.proofCapableOwnerKey(for: owner)



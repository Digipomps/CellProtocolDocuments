    private func sortedProjects() -> [ProjectPortfolioRecord] {
        stateQueue.sync {
            Self.sorted(Array(projectsByID.values))
        }
    }

    private static func sorted(_ projects: [ProjectPortfolioRecord]) -> [ProjectPortfolioRecord] {
        projects.sorted { lhs, rhs in
            if lhs.status.isOpen != rhs.status.isOpen {
                return lhs.status.isOpen && !rhs.status.isOpen
            }
            if lhs.health.riskRank != rhs.health.riskRank {
                return lhs.health.riskRank < rhs.health.riskRank
            }
            if lhs.priority.rank != rhs.priority.rank {
                return lhs.priority.rank < rhs.priority.rank
            }
            if lhs.updatedAtEpochMs != rhs.updatedAtEpochMs {
                return lhs.updatedAtEpochMs > rhs.updatedAtEpochMs
            }
            return lhs.name.localizedCaseInsensitiveCompare(rhs.name) == .orderedAscending
        }
    }


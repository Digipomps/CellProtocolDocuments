#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: Copyright (c) 2026 Stiftelsen Digipomps and HAVEN contributors

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
if (( $# == 0 )); then
  echo "Usage: scripts/run_swift_bounded.sh <build|test|run|package> [arguments...]" >&2
  exit 64
fi
case "$1" in
  build|test|run|package) ;;
  *)
    echo "ERROR: unsupported Swift subcommand: $1" >&2
    exit 64
    ;;
esac

swift_subcommand="$1"
swift_arguments=("$@")
if [[ "$swift_subcommand" != "package" ]]; then
  swift_jobs="${HAVEN_SWIFTPM_JOBS:-2}"
  if [[ ! "$swift_jobs" =~ ^[1-9][0-9]*$ ]]; then
    echo "ERROR: HAVEN_SWIFTPM_JOBS must be a positive integer: $swift_jobs" >&2
    exit 64
  fi

  has_explicit_jobs=false
  for argument in "${swift_arguments[@]:1}"; do
    case "$argument" in
      --jobs|--jobs=*|-j|-j[0-9]*)
        has_explicit_jobs=true
        break
        ;;
    esac
  done
  if [[ "$has_explicit_jobs" == false ]]; then
    swift_arguments=("$swift_subcommand" "--jobs" "$swift_jobs" "${swift_arguments[@]:1}")
  fi
fi

resolve_runner() {
  local common_git_dir main_checkout haven_root
  if [[ -n "${HAVEN_SWIFTPM_RUNNER:-}" ]]; then
    if [[ ! -x "$HAVEN_SWIFTPM_RUNNER" || -L "$HAVEN_SWIFTPM_RUNNER" ]]; then
      echo "ERROR: HAVEN_SWIFTPM_RUNNER must be an executable non-symlink: $HAVEN_SWIFTPM_RUNNER" >&2
      return 64
    fi
    printf '%s\n' "$HAVEN_SWIFTPM_RUNNER"
    return 0
  fi

  if [[ -x "$repo_root/../CellProtocol/Scripts/haven-swiftpm.sh" ]]; then
    printf '%s\n' "$repo_root/../CellProtocol/Scripts/haven-swiftpm.sh"
    return 0
  fi

  common_git_dir="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  if [[ -n "$common_git_dir" ]]; then
    main_checkout="$(dirname "$common_git_dir")"
    haven_root="$(dirname "$main_checkout")"
    if [[ -x "$haven_root/CellProtocol/Scripts/haven-swiftpm.sh" ]]; then
      printf '%s\n' "$haven_root/CellProtocol/Scripts/haven-swiftpm.sh"
      return 0
    fi
  fi

  echo "ERROR: bounded CellProtocol SwiftPM runner not found; set HAVEN_SWIFTPM_RUNNER." >&2
  return 69
}

cache_size_kib() {
  if [[ -d "$1" ]]; then
    du -sk "$1" 2>/dev/null | awk '{ print $1 }'
  else
    printf '0\n'
  fi
}

"$repo_root/scripts/check_build_capacity.sh" "$repo_root"
runner="$(resolve_runner)"

if [[ "$(uname -s)" == "Darwin" ]]; then
  default_cache_root="/private/tmp/haven-swiftpm-bounded"
else
  default_cache_root="${TMPDIR:-/tmp}/haven-swiftpm-bounded"
fi
cache_root="${HAVEN_SWIFTPM_CACHE_ROOT:-$default_cache_root}"
max_age_seconds="${HAVEN_SWIFTPM_MAX_AGE_SECONDS:-86400}"
max_cache_kib="${HAVEN_SWIFTPM_MAX_CACHE_KIB:-12582912}"

before_cache_kib="$(cache_size_kib "$cache_root")"
before_available_kib="$(df -Pk "$repo_root" | awk 'NR == 2 { print $4 }')"

set +e
"$runner" \
  --cache-root "$cache_root" \
  --max-age-seconds "$max_age_seconds" \
  --max-cache-kib "$max_cache_kib" \
  -- "${swift_arguments[@]}"
status=$?
set -e

after_cache_kib="$(cache_size_kib "$cache_root")"
after_available_kib="$(df -Pk "$repo_root" | awk 'NR == 2 { print $4 }')"
cache_delta_kib=$((after_cache_kib - before_cache_kib))
available_delta_kib=$((after_available_kib - before_available_kib))
printf 'Build disk result: cache=%d KiB (delta=%+d KiB), available delta=%+d KiB, status=%d.\n' \
  "$after_cache_kib" "$cache_delta_kib" "$available_delta_kib" "$status" >&2

if (( after_cache_kib > max_cache_kib )); then
  echo "WARNING: the active managed cache exceeds its ${max_cache_kib} KiB cap; another build is not sustainable until reviewed." >&2
fi

exit "$status"


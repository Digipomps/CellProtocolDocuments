const csp = controller.match(/static let csp = "([^"]+)"/)[1];
const template = fs.readFileSync(path.join(__dirname, '../Sources/App/Resources/GameWorkshop/sandbox.html'), 'utf8');
function document(code) {
  return template.replace('__GAME_CODE__', () => JSON.stringify(code).replaceAll('<', '\u003c'));
}
async function mount(page, code, direct = false) {
  await page.route('**/*', route => {
    const url = new URL(route.request().url());
    if (url.pathname.startsWith('/spill/sandbox/')) return route.fulfill({ contentType: 'text/html', headers: { 'content-security-policy': csp }, body: document(code) });
    if (url.pathname.endsWith('/kaplay.js')) return route.fulfill({ contentType: 'application/javascript', body: 'window.kaplay=function(){};' });
    if (url.pathname === '/') return route.fulfill({ contentType: 'text/html', body: `<script>window.messages=[];addEventListener('message',e=>messages.push(e.data));</script><iframe src="/spill/sandbox/p/1"></iframe>` });
    static func response(code: String) -> Response { Response(status: .ok, headers: headers(), body: .init(string: document(code: code))) }
    static func document(code: String) -> String {
        guard let url = Bundle.module.url(forResource: "sandbox", withExtension: "html", subdirectory: "GameWorkshop"),
              let template = try? String(contentsOf: url, encoding: .utf8),
              template.contains("__GAME_CODE__") else { return "" }
        // Use a JSON string and an inline DOM script: HTML parsing cannot terminate
        // the game's strings, comments or regex literals. CSP needs no unsafe-eval.
        guard let encoded = try? JSONEncoder().encode(code) else { return "" }
        let literal = String(decoding: encoded, as: UTF8.self)
            .replacingOccurrences(of: "<", with: "\\u003c")
            .replacingOccurrences(of: "\u{2028}", with: "\\u2028")
            .replacingOccurrences(of: "\u{2029}", with: "\\u2029")
        return template.replacingOccurrences(of: "__GAME_CODE__", with: literal)

    }
}

/// Must wrap SessionsMiddleware, so even session refresh cookies are removed.
struct GameSandboxResponseMiddleware: AsyncMiddleware {
    func respond(to request: Request, chainingTo next: AsyncResponder) async throws -> Response {
        guard request.url.path.hasPrefix("/spill/sandbox/") else { return try await next.respond(to: request) }

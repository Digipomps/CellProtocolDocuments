import Foundation
import PackageDescription

private func hasPackageManifest(at candidate: String) -> Bool {
    let manifestPath = (candidate as NSString).appendingPathComponent("Package.swift")
    return FileManager.default.fileExists(atPath: manifestPath)
}

private let currentPackagePath = URL(fileURLWithPath: #filePath)
    .deletingLastPathComponent()
    .path

private func localPackagePath(from environmentKey: String) -> String? {
    let environment = ProcessInfo.processInfo.environment
    guard let candidate = environment[environmentKey]?
        .trimmingCharacters(in: .whitespacesAndNewlines),
          !candidate.isEmpty else {
        return nil
    }

    guard hasPackageManifest(at: candidate) else {
        return nil
    }

    return candidate
}

private func siblingPackagePath(named packageName: String, relativeTo packagePath: String) -> String? {
    let siblingPath = URL(fileURLWithPath: packagePath)
        .deletingLastPathComponent()
        .appendingPathComponent(packageName)
        .path
    guard hasPackageManifest(at: siblingPath) else {
        return nil
    }
    return siblingPath
}

private func coordinatedLocalPackagePath(
    explicitEnvironmentKey: String,
    packageName: String,
    siblingEnvironmentKeys: [String]
) -> String? {
    if let explicitPath = localPackagePath(from: explicitEnvironmentKey) {
        return explicitPath
    }

    for environmentKey in siblingEnvironmentKeys {
        guard let basePath = localPackagePath(from: environmentKey) else {
            continue
        }
        if let siblingPath = siblingPackagePath(named: packageName, relativeTo: basePath) {
            return siblingPath
        }
    }

    if let siblingPath = siblingPackagePath(named: packageName, relativeTo: currentPackagePath) {
        return siblingPath
    }

    return nil
}

let dimyMintDependency: Package.Dependency = {
    if let localPath = coordinatedLocalPackagePath(
        explicitEnvironmentKey: "DIMYMINT_LOCAL_PACKAGE_PATH",
        packageName: "DiMyMint",
        siblingEnvironmentKeys: [
            "DIMYMICROPAYMENTS_LOCAL_PACKAGE_PATH",
            "CELLPROTOCOL_LOCAL_PACKAGE_PATH"
        ]
    ) {
        return .package(path: localPath)
    }
    return .package(
        url: "git@github.com:DiMy-io/DiMyMint.git",
        exact: "2026.9.4"
    )
}()


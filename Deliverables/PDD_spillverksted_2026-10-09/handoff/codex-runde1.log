import Foundation
@preconcurrency import CellBase

/// Local durability boundary for the existing WorkMutationSync acknowledgements.
/// The Cell still authorizes the action. A successful mutation of a persistent
/// Cell must survive a fresh storage read before its acknowledgement is returned.
final class WorkbenchMutationPersistence {
    private actor Gate {
        private var locked = false
        private var waiters: [CheckedContinuation<Void, Never>] = []

        func acquire() async {
            if !locked { locked = true; return }
            await withCheckedContinuation { waiters.append($0) }
        }

        func release() {
            if waiters.isEmpty { locked = false } else { waiters.removeFirst().resume() }
        }
    }

    private let gate = Gate()

    func perform(
        on cell: GeneralCell,
        verifyTodoState: Bool = false,
        operation: () async throws -> ValueType?
    ) async throws -> ValueType? {
        await gate.acquire()
        do {
            let response = try await operation()
            let result = await verifyAcknowledgement(response, cell: cell, verifyTodoState: verifyTodoState)
            await gate.release()
            return result
        } catch {
            await gate.release()
            throw error
        }
    }

    private func verifyAcknowledgement(_ response: ValueType?, cell: GeneralCell, verifyTodoState: Bool) async -> ValueType? {
        guard cell.persistancy == .persistant, case var .object(ack) = response else { return response }
        if verifyTodoState {
            guard case .list? = ack["items"] else { return response }
        } else {
            guard case .string("ok") = ack["status"] else { return response }
            switch ack["eventID"] {
            case .some(.string), .some(.null): break
            default: return response
            }
        }

        // An unchanged receipt can be a retry of an earlier in-memory write
        // whose persistence was uncertain. It needs the same fresh proof as a
        // new event; null eventID must not turn that uncertainty into success.

        // TypedCellUtility's writer does not propagate storage errors. A fresh
        // read is essential: the resolver's Boolean alone is not a write receipt.
        if let resolver = CellBase.defaultCellResolver as? CellResolver,
           await resolver.persistCellSnapshot(cell),
           let utility = resolver.tcUtility,
           case let .loaded(restored) = utility.loadTypedEmitCellResult(with: cell.uuid),
           let expected = try? canonicalSnapshot(cell),
           let actual = try? canonicalSnapshot(restored),
           expected == actual {
            return response
        }

        // The existing mutation/event has happened in memory. Preserve its IDs
        // and make that uncertainty explicit; claiming rollback or encouraging
        // blind capture retries could create duplicates.
        ack["status"] = .string("error")
        ack["code"] = .string("workbench_snapshot_unverified")
        ack["appliedInMemory"] = .bool(true)
        ack["message"] = .string("Endringen finnes i denne økten, men lagring kunne ikke bekreftes. Kontroller oppgaven før du prøver på nytt.")
        return .object(ack)
    }

    private func canonicalSnapshot(_ cell: Emit) throws -> Data {
        guard let codable = cell as? Codable else {
            throw EncodingError.invalidValue(cell, .init(codingPath: [], debugDescription: "Cell is not Codable"))
        }
        let typeName = String(String(describing: Swift.type(of: cell)).split(separator: ".").last ?? "UnknownCell")
        let encoded = try CellJSONCoder.encodeCell(cellClassName: typeName, cell: codable)
        let object = try JSONSerialization.jsonObject(with: encoded)
        return try JSONSerialization.data(withJSONObject: object, options: [.sortedKeys])
    }
}

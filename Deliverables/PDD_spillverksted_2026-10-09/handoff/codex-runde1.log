    /// Only registered portfolio sources on this scaffold are discoverable here.
    func accessibleProjects(requester: Identity) async -> ValueType {
        guard await verifyRequesterIdentityControl(requester),
              let fingerprint = Self.signingKeyFingerprint(for: requester) else {

import ScaffoldKit
@_spi(Testing) import CellBase
import XCTest

/// Establishes a clean CellProtocol runtime boundary before every AppTests case.
///
/// Subclasses that override the async XCTest lifecycle must call `super`.
/// Synchronous `setUp`/`tearDown` overrides do not replace these async hooks.
open class IsolatedCellTestCase: XCTestCase {
    private var isolationContext: TestRuntimeIsolation.Context?

    open override func setUp() async throws {
        try await super.setUp()
        let context = try TestRuntimeIsolation.beginTest()
        isolationContext = context

        await resetPortholeRuntimeBindingInstallStoreForTesting()
        await CellResolver.sharedInstance.resetRuntimeStateForTesting()
        resetCellProtocolGlobals(documentRoot: context.documentRoot.path)
    }

    open override func tearDown() async throws {
        await resetPortholeRuntimeBindingInstallStoreForTesting()
        await CellResolver.sharedInstance.resetRuntimeStateForTesting()
        resetCellProtocolGlobals(documentRoot: nil)
        if let isolationContext {
            TestRuntimeIsolation.finishTest(isolationContext)
            self.isolationContext = nil
        }
        try await super.tearDown()
    }

    private func resetCellProtocolGlobals(documentRoot: String?) {
        CellBase.defaultIdentityVault = nil
        CellBase.defaultCellResolver = nil
        CellBase.defaultScopedSecretProvider = nil

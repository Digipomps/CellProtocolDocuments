// SPDX-License-Identifier: Apache-2.0
// purpose://candidate.game-workshop.project.uses-haven-workbench
import CellBase
import Foundation

/// Uses the existing Workbench records and their durability boundary.
/// Cross-cell writes are not atomic: failures report the stable project/task IDs.
enum GameWorkbench {
    static func create(id: String, title: String, requester: Identity, portfolio: ProjectPortfolioCell, workItems: WorkItemCell) async throws -> ValueType {
        let taskIDs = [\"\\(id)-design\", \"\\(id)-test\"]
        let project: ValueType = .object([
            \"id\": .string(id), \"name\": .string(title), \"labels\": .list([.string(\"spillverksted\")]),
            \"cellRefs\": .list([.string(\"cell:///GameProject\")]),
            \"workItemRefs\": .list(taskIDs.map(ValueType.string))
        ])
        let captured = try await portfolio.set(keypath: \"capture\", value: project, requester: requester)
        guard succeeded(captured) else { return failure(id, taskIDs, \"portfolio_capture_failed\") }
        for (index, taskTitle) in [\"Bestem hva spillet skal gjøre\", \"Prøv spillet og forklar endringene\"].enumerated() {
            let payload: ValueType = .object([
                \"id\": .string(taskIDs[index]), \"title\": .string(taskTitle), \"project\": .string(id),
                \"kind\": .string(\"feature\"), \"labels\": .list([.string(\"spillverksted\")])
            ])
            let task = try await workItems.set(keypath: \"capture\", value: payload, requester: requester)
            guard succeeded(task) else { return failure(id, taskIDs, \"work_item_capture_failed\") }
        }
        return .object([\"ok\": .bool(true), \"id\": .string(id), \"workItemRefs\": .list(taskIDs.map(ValueType.string))])
    }
    private static func succeeded(_ result: ValueType?) -> Bool {
        guard case .object(let o)? = result, case .string(\"ok\")? = o[\"status\"] else { return false }
        return true
    }
    private static func failure(_ id: String, _ taskIDs: [String], _ reason: String) -> ValueType {
        .object([\"ok\": .bool(false), \"error\": .string(reason), \"projectID\": .string(id), \"workItemRefs\": .list(taskIDs.map(ValueType.string)), \"mayBePartiallyApplied\": .bool(true)])
    }
}

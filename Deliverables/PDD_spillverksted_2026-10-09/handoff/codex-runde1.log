// SPDX-License-Identifier: Apache-2.0
@testable import App
import CellBase
import Foundation
import XCTest

final class GameProjectCellTests: IsolatedCellTestCase {
    func testTenChangesThenRevertPreservesElevenVersions() async throws {
        let owner = await makeCellProtocolTestIdentity(\"game-version-owner\")
        let cell = await GameProjectCell(owner: owner)
        _ = try await cell.set(keypath: \"project.create\", value: .object([\"title\": .string(\"Mitt spill\")]), requester: owner)
        for n in 1...10 {
            let proposal: ValueType = .object([\"title\": .string(\"Endring \\(n)\"), \"changes\": .string(\"Tall\"), \"why\": .string(\"Lære\"), \"usedLibrary\": .list([]), \"code\": .string(\"const n = \\(n);\")])
            let proposed = try await cell.set(keypath: \"project.propose\", value: proposal, requester: owner)
            XCTAssertEqual(object(proposed)?[\"ok\"], .bool(true))
            let applied = try await cell.set(keypath: \"project.applyProposal\", value: .object([:]), requester: owner)
            XCTAssertEqual(object(applied)?[\"ok\"], .bool(true))
        }
        _ = try await cell.set(keypath: \"project.revert\", value: .object([\"n\": .integer(3)]), requester: owner)
        let state = try await cell.get(keypath: \"project.state\", requester: owner)
        guard case .list(let versions)? = object(state)?[\"versions\"] else { return XCTFail(\"Missing versions\") }
        XCTAssertEqual(versions.count, 11)
        XCTAssertEqual(object(versions[2])?[\"code\"], object(versions[10])?[\"code\"])
        XCTAssertEqual(object(state)?[\"current\"], .integer(11))
        let data = try JSONEncoder().encode(cell)
        let restored = try JSONDecoder().decode(GameProjectCell.self, from: data)
        let restoredState = try await restored.get(keypath: \"project.state\", requester: owner)
        let encoder = JSONEncoder(); encoder.outputFormatting = [.sortedKeys]
        XCTAssertEqual(try encoder.encode(state), try encoder.encode(restoredState))
    }
    func testPendingDiscardLimitsAndUnknownVersion() async throws {
        let owner = await makeCellProtocolTestIdentity(\"game-pending-owner\")
        let cell = await GameProjectCell(owner: owner)
        _ = try await cell.set(keypath: \"project.create\", value: .object([\"title\": .string(\"Spill\")]), requester: owner)
        func proposal(_ code: String) -> ValueType { .object([\"title\": .string(\"Forslag\"), \"changes\": .string(\"Tall\"), \"why\": .string(\"Lære\"), \"usedLibrary\": .list([]), \"code\": .string(code)]) }
        let rejected = try await cell.set(keypath: \"project.propose\", value: proposal(String(repeating: \"æ\", count: 100_001)), requester: owner)
        XCTAssertEqual(object(rejected)?[\"ok\"], .bool(false))
        _ = try await cell.set(keypath: \"project.propose\", value: proposal(\"kaplay();\"), requester: owner)
        let preview = try await cell.get(keypath: \"project.preview\", requester: owner)
        guard case .string(let url)? = object(preview)?[\"url\"] else { return XCTFail(\"Missing preview\") }
        XCTAssertTrue(url.hasSuffix(\"/pending\"))
        _ = try await cell.set(keypath: \"project.discardProposal\", value: .object([:]), requester: owner)
        let rejectedRevert = try await cell.set(keypath: \"project.revert\", value: .object([\"n\": .integer(99)]), requester: owner)
        XCTAssertEqual(object(rejectedRevert)?[\"ok\"], .bool(false))
    }
    private func object(_ value: ValueType?) -> Object? { if case .object(let o)? = value { return o }; return nil }
}

    private static func portfolioUnavailableReason(_ error: Error, prefix: String) -> String {
        if let bindingError = error as? PortholeRuntimeBindingInstallationError {
            switch bindingError {
            case .persistedOwnerHomeVaultUnavailable:
                return "\(prefix)-portfolio-owner-vault-unavailable"
            }
        }
        return "\(prefix)-portfolio-access-unavailable"
    }


          test -f CellProtocolDocuments/Book/book_catalog.json
          test -f CellProtocolDocuments/Book/00_Book_Home.md
          grep -q '"doc_id": "book-16-reference-workspace"' CellProtocolDocuments/Book/book_catalog.json

      - name: Resolve pinned private dependency commits
        id: private_deps
        shell: bash
        run: |
          set -euo pipefail
          revision_for() {
            local identity="$1"
            awk -v identity="$identity" '
              $0 ~ "\"identity\" : \"" identity "\"" { found = 1; next }
              found && /\"revision\" : \"/ {
                line = $0
                sub(/^.*\"revision\" : \"/, "", line)
                sub(/\".*$/, "", line)
                print line
                exit
              }
            ' Package.resolved
          }
          fileutils="$(revision_for fileutils-c)"
          micropayments="$(revision_for dimymicropayments)"
          mint="$(revision_for dimymint)"
          for revision in "$fileutils" "$micropayments" "$mint"; do
            [[ "$revision" =~ ^[0-9a-f]{40}$ ]]
          done
          printf 'fileutils=%s\n' "$fileutils" >> "$GITHUB_OUTPUT"
          printf 'micropayments=%s\n' "$micropayments" >> "$GITHUB_OUTPUT"
          printf 'mint=%s\n' "$mint" >> "$GITHUB_OUTPUT"

      - name: Require scoped dependency credentials
        env:
          FILEUTILS_KEY: ${{ secrets.FILEUTILS_C_DEPLOY_KEY }}
          DIMY_APP_ID: ${{ secrets.DIMY_DEPENDENCY_APP_ID }}
          DIMY_APP_PRIVATE_KEY: ${{ secrets.DIMY_DEPENDENCY_APP_PRIVATE_KEY }}
        shell: bash

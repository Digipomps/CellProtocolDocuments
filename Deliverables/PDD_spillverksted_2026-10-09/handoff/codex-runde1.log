import Fluent
import Vapor
@preconcurrency import CellBase

enum MVPAuthAccess {
    private static let rememberCookieName = "chat_mvp_remember"

    static func requireAuthenticatedUser(_ req: Request) async throws -> FidoUser {
        if let user = req.auth.get(FidoUser.self) {
            return user
        }

        guard let token = req.cookies[rememberCookieName]?.string else {
            throw Abort(.unauthorized, reason: "Passkey authentication required.")
        }

        let now = Date()
        guard let claims = req.chatAuthTokens.verify(token: token),
              let userID = UUID(uuidString: claims.sub),
              let rememberToken = try await ChatRememberToken.query(on: req.db)
                .filter(\.$jti == claims.jti)
                .filter(\.$user.$id == userID)
                .with(\.$user)
                .first(),
              rememberToken.revokedAt == nil,
              rememberToken.expiresAt > now else {
            throw Abort(.unauthorized, reason: "Passkey authentication required.")
        }

        req.auth.login(rememberToken.user)
        return rememberToken.user
    }

    static func authenticatedRequester(for user: FidoUser, req: Request) async throws -> Identity {
        guard let identityDomain = user.id?.uuidString else {
            throw Abort(.internalServerError, reason: "Authenticated user has no identity domain.")
        }

        let identityVault = BrowserClientIdentityVault(identityDomain: identityDomain)
        let previousIdentityID = user.identityId
        let requester = try await PortholeWebSessionSupport.resolveRequesterIdentity(
            for: user,
            identityVault: identityVault,
            activeConferencePersonaID: nil
        )
        let activeVaultReference = await identityVault.identityVaultReference()
        guard await identityVault.identityExistInVault(requester),
              requester.homeVaultReference == activeVaultReference,
              requester.signingPublicKeyFingerprint != nil else {
            throw Abort(
                .forbidden,
                reason: "Identity proof required. Restore the identity in its home vault or link this scaffold before retrying."
            )
        }
        if user.identityId != previousIdentityID {
            try await user.save(on: req.db)
        }
        await PortholeWebSessionSupport.registerPublicRequesterIdentity(requester)
        return requester
    }
}


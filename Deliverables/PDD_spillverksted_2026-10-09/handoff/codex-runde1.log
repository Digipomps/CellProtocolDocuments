// SPDX-License-Identifier: Apache-2.0
// purpose://candidate.game-workshop.project.versioned-changes
import CellBase
import Foundation
import ScaffoldKit

struct GameVersion: Codable, Equatable {
    var n: Int
    var title: String
    var code: String
    var createdAt: String
    var lib: [String]
}
struct GameProposal: Codable, Equatable {
    var title: String
    var changes: String
    var why: String
    var usedLibrary: [String]
    var code: String
}
/// Game-specific data only; id links to the canonical ProjectPortfolio record.
struct GameProject: Codable, Equatable {
    var id: String
    var title: String
    var engine = \"kaplay\"
    var versions: [GameVersion] = []
    var current = 0
    var pending: GameProposal?
}

final class GameProjectCell: GeneralCell {
    static let actions = [\"project.create\", \"project.propose\", \"project.applyProposal\", \"project.discardProposal\", \"project.revert\", \"project.select\"]
    private enum CodingKeys: CodingKey { case projects, selectedID }
    private let queue = DispatchQueue(label: \"GameProject.state\")
    private var projects: [String: GameProject] = [:]
    private var selectedID: String?

    required init(owner: Identity) async {
        await super.init(owner: owner)
        try? await ensureRuntimeReady()
    }
    required init(from decoder: Decoder) throws {
        let c = try decoder.container(keyedBy: CodingKeys.self)
        projects = try c.decode([String: GameProject].self, forKey: .projects)
        selectedID = try c.decodeIfPresent(String.self, forKey: .selectedID)
        try super.init(from: decoder)
    }
    override func encode(to encoder: Encoder) throws {
        try super.encode(to: encoder)
        let snapshot = queue.sync { (projects, selectedID) }
        var c = encoder.container(keyedBy: CodingKeys.self)
        try c.encode(snapshot.0, forKey: .projects)
        try c.encodeIfPresent(snapshot.1, forKey: .selectedID)
    }
    override func installCellRuntimeBindingsForAccess() async throws {
        let owner = storedOwnerIdentity
        let object = ExploreContract.schema(type: \"object\")
        for key in [\"project.state\", \"project.preview\"] {
            agreementTemplate.ensureGrant(\"r---\", for: key)
            await registerGet(key: key, owner: owner, returns: object, permissions: [\"r---\"], description: .string(\"Spillprosjektets tilstand eller isolerte forhåndsvisning.\")) { [weak self] requester in
                guard let self, await self.validateAccess(\"r---\", at: key, for: requester) else { return .null }
                return self.queue.sync {
                    guard let id = self.selectedID, let project = self.projects[id] else { return .null }
                    if key == \"project.state\" { return Self.value(project) }
                    let version = project.pending == nil ? String(project.current) : \"pending\"
                    return .object([\"url\": .string(\"/spill/sandbox/\\(id)/\\(version)\"), \"label\": .string(project.pending == nil ? \"Versjon \\(version)\" : \"Forslag, ikke lagret\")])
                }
            }
        }
        for key in Self.actions {
            agreementTemplate.ensureGrant(\"rw--\", for: key)
            await registerSet(key: key, owner: owner, input: object, returns: object, permissions: [\"rw--\"], description: .string(\"Endre spillprosjektet; kode lagres som tekst og kjøres aldri av cellen.\")) { [weak self] requester, payload in
                guard let self, requester.uuid == owner.uuid,
                      await self.validateAccess(\"rw--\", at: key, for: requester) else { return Self.error(\"not_authorized\") }
                let result = self.mutate(key, payload)
                var flow = FlowElement(title: key, content: result, properties: FlowElement.Properties(type: .event, contentType: .object))
                flow.topic = \"haven.game-project.mutations\"
                flow.origin = self.uuid
                self.pushFlowElement(flow, requester: requester)
                return result
            }
        }
    }
    private static func value<T: Encodable>(_ value: T) -> ValueType {
        guard let data = try? JSONEncoder().encode(value), let result = try? JSONDecoder().decode(ValueType.self, from: data) else { return .null }
        return result
    }
    static func error(_ message: String) -> ValueType { .object([\"ok\": .bool(false), \"error\": .string(message)]) }
    private func mutate(_ key: String, _ payload: ValueType) -> ValueType {
        queue.sync {
            guard case .object(let raw) = payload else { return Self.error(\"invalid_payload\") }
            func text(_ field: String) -> String? { if case .string(let s)? = raw[field] { return s }; return nil }
            if key == \"project.create\" {
                guard let title = text(\"title\"), "'!title.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else { return Self.error("title_required") }
                // Templates are explicitly rejected until the library integration supplies them.
                guard raw["templateId"] == nil || raw["templateId"] == .null else { return Self.error("unsupported_template") }
                let id = UUID().uuidString.lowercased()
                projects[id] = GameProject(id: id, title: title)
                selectedID = id
                return .object(["ok": .bool(true), "id": .string(id)])
            }
            let id = text("id") ?? selectedID
            guard let id, var project = projects[id] else { return Self.error("unknown_project") }
            switch key {
            case "project.select": selectedID = id
            case "project.propose":
                guard let data = try? JSONEncoder().encode(payload), let proposal = try? JSONDecoder().decode(GameProposal.self, from: data), proposal.code.utf8.count <= 200_000 else { return Self.error("invalid_proposal_or_code_too_large") }
                project.pending = proposal
            case "project.applyProposal":
                guard let p = project.pending else { return Self.error("no_proposal") }
                append(&project, title: p.title, code: p.code, lib: p.usedLibrary)
                project.pending = nil
            case "project.discardProposal": project.pending = nil
            case "project.revert":
                guard case .integer(let n)? = raw["n"], let v = project.versions.first(where: { $0.n == n }) else { return Self.error("unknown_version") }
                append(&project, title: "Tilbake til versjon '"\\(n)\", code: v.code, lib: v.lib)
                project.pending = nil
            default: return Self.error(\"unknown_action\")
            }
            projects[id] = project
            return .object([\"ok\": .bool(true), \"project\": Self.value(project)])
        }
    }
    private func append(_ project: inout GameProject, title: String, code: String, lib: [String]) {
        let n = project.versions.count + 1
        project.versions.append(GameVersion(n: n, title: title, code: code, createdAt: ISO8601DateFormatter().string(from: Date()), lib: lib))
        project.current = n
    }
    /// Route reads are owner-authorized and never select/mutate a project.
    func sandboxCode(projectID: String, version: String, requester: Identity) async throws -> String? {
        try await ensureRuntimeReady()
        guard await validateAccess(\"r---\", at: \"project.state\", for: requester) else { return nil }
        return queue.sync {
            guard let project = projects[projectID] else { return nil }
            if version == \"pending\" { return project.pending?.code }
            guard let n = Int(version) else { return nil }
            return project.versions.first(where: { "'$0.n == n })?.code
        }
    }
}

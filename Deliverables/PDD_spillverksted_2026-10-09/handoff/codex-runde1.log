def cmd_capture(args: argparse.Namespace) -> int:
    entries = load_ledger()
    slug = slugify(args.slug or args.what)
    entry_id = next_id(entries, slug)
    targets = [
        resolve_target(ref, allow_create=bool(args.description), description=args.description or "",
                       what=args.what, ledger_id=entry_id, skill_canon=args.skill_canon)
        for ref in args.target
    ]
    entry = {
        "id": entry_id,
        "capturedAt": now_iso(),
        "surface": args.surface or guess_surface(),
        "session": args.session,
        "kind": args.kind,
        "what": args.what.strip(),
        "why": (args.why or "").strip(),
        "source": (args.source or "").strip(),
        "evidence": (args.evidence or "").strip(),
        "tags": sorted({t.strip() for t in (args.tags or "").split(",") if t.strip()}),
        "targets": targets,
        "synced": False,
        "syncedAt": None,
        "syncJob": None,
        "dropped": False,
        "notes": [],
    }
    if args.applied:
        # The thread edited the target(s) before recording the learning. Honest state:
        # applied now, with the current hash as hashAfter; hashBefore is unknown.
        for t in targets:
            t["hashAfter"], t["hashBefore"] = t["hashBefore"], None
            t["applied"], t["appliedAt"] = True, now_iso()
        entry["notes"].append({"at": now_iso(), "note": "captured with --applied: target edited before capture"})
    entries.append(entry)
    save_ledger(entries)
    settled = settle_session(args.session, "captured", entry_id)
    logged = False
    if not args.no_log:
        logged = append_losen_log(
            f"- haven-learn `{entry_id}` ({entry['surface']}): {entry['what']} → "
            + ", ".join(t["path"] for t in targets)
        )
    print(f"Fanget {entry_id}")
    for t in targets:
        marker = "opprettet" if t["created"] else "hashBefore " + (t["hashBefore"] or "-")[:12]
        print(f"  mål: {t['ref']} → {HAVEN / t['path']}  [{marker}]")
    if args.applied:
        print("Målet er markert oppdatert (--applied). Neste steg:")
    else:
        print("Neste steg: oppdater målet/målene over, deretter")
        print(f"  python3 {rel(SCRIPT_PATH)} applied {entry_id}")
    print(f"  python3 {rel(SCRIPT_PATH)} sync --id {entry_id}")
    if settled:
        print(f"Økt {settled} markert som håndtert (Stop-hook slipper).")
    if logged:
        print(f"Én linje lagt til i {HAVEN / LOSEN_LOG}")
    return 0



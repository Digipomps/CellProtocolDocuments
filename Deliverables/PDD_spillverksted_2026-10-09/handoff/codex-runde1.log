        e["synced"], e["syncedAt"], e["syncJob"] = True, now_iso(), args.job or "manual"
        print(f"{i}: synced")
    save_ledger(entries)
    return 0


def skill_fingerprint(md: Path) -> str:
    """Content fingerprint that ignores frontmatter quoting/ordering: Cowork and Claude Desktop rewrite
    `name: x` as `name: "x"` when they store a skill, which is not a real difference."""
    text = md.read_text(encoding="utf-8", errors="replace")
    meta = parse_frontmatter(md)
    body = text
    if text.startswith("---"):
        end = text.find("\n---", 3)
        if end != -1:
            body = text[end + 4:]
    body = "\n".join(line.rstrip() for line in body.strip().splitlines())
    key = json.dumps({"name": meta.get("name", ""), "description": " ".join(meta.get("description", "").split()),
                      "body": body}, ensure_ascii=False, sort_keys=True)
    return hashlib.sha256(key.encode("utf-8")).hexdigest()


def drift_report(verbose: bool = False) -> list[dict]:
    """Compare canon SKILL.md (normalized) against the home stores on this machine."""
    stores = home_stores()
    report: list[dict] = []
    for name, md, _ in iter_skills():
        canon_fp = skill_fingerprint(md)
        row = {"skill": name, "canon": rel(md), "canonHash": canon_fp[:12], "stores": {}}
        if verbose:
            row["copies"] = []


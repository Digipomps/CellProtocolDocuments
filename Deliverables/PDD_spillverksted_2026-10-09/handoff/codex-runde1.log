        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
        with:
          repository: Digipomps/CellProtocolDocuments
          ref: ${{ env.CELLPROTOCOL_DOCUMENTS_REF }}

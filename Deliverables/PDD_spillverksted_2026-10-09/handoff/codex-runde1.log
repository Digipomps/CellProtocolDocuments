def iter_skills() -> Iterable[tuple[str, Path, dict[str, str]]]:
    """Yield (name, SKILL.md path, frontmatter) across all canon dirs; first canon wins."""
    seen: set[str] = set()
    for canon in SKILL_CANONS:
        base = HAVEN / canon
        if not base.is_dir():
            continue
        for skill_dir in sorted(p for p in base.iterdir() if p.is_dir()):
            md = skill_dir / "SKILL.md"
            if not md.is_file() or skill_dir.name in seen:
                continue
            seen.add(skill_dir.name)
            yield skill_dir.name, md, parse_frontmatter(md)


def find_skill(name: str) -> Path | None:
    for skill_name, md, _ in iter_skills():
        if skill_name == name:
            return md
    return None



private final class PurposeReviewFlowRecorder: @unchecked Sendable {
    private let lock = NSLock()
    private var values: [String] = []

    func append(_ element: FlowElement) {
        guard case .object(let content) = element.content, case .string(let decision)? = content["decision"] else { return }
        lock.lock()
        values.append(decision)
        lock.unlock()
    }

    var decisions: [String] {
        lock.lock()
        defer { lock.unlock() }
        return values
    }

    func wait(for count: Int) async -> Bool {
        for _ in 0..<250 {
            if decisions.count >= count { return true }
            try? await Task.sleep(nanoseconds: 20_000_000)
        }
        return decisions.count >= count
    }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "haven.workbench-assistant-profile.v0",
  "title": "Workbench assistant profile (v0, draft)",
  "description": "How a workbench adopts the workbench-assistant pattern without new chat-engine code. Purpose: purpose://candidate.workbench-assistant.reusable-profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "anchorPurposeRef",
    "library",
    "preview",
    "allowedActions",
    "audience",
    "escalationCeiling",
    "metrics"
  ],
  "properties": {
    "schema": {
      "const": "haven.workbench-assistant-profile.v0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable ASCII id, English."
    },
    "title": {
      "type": "string",
      "description": "Display title in the user's language."
    },
    "anchorPurposeRef": {
      "type": "string",
      "pattern": "^purpose://",
      "description": "Purpose branch the assistant classifies wishes against (loop step 1)."
    },
    "library": {
      "type": "string",
      "description": "Library id proposals are drawn from; every entry is keyed on purpose:// refs."
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "skeleton-working-copy",
            "sandboxed-iframe"
          ],
          "description": "skeleton-working-copy = Porthole editor.working.setSkeleton; sandboxed-iframe = user code in iframe without allow-same-origin."
        },
        "engine": {
          "type": "string",
          "description": "Only for sandboxed-iframe, e.g. kaplay."
        }
      }
    },
    "allowedActions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^cell:///[A-Za-z0-9]+#[A-Za-z0-9.]+$"
      },
      "description": "The only actions a proposal may point at. The target cell re-checks access on every call."
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tone",
        "language"
      ],
      "properties": {
        "tone": {
          "enum": [
            "child",
            "learner",
            "professional"
          ]
        },
        "language": {
          "type": "string",
          "description": "BCP 47, e.g. nb."
        },
        "ageRange": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "readingLevel": {
          "enum": [
            "early",
            "fluent"
          ]
        }
      }
    },
    "escalationCeiling": {
      "enum": [
        "never_external",
        "ask_each_time",
        "automatic_within_grant"
      ],
      "description": "Same values as ChatInterpreterEscalationMode (Sources/App/Support/ChatInterpreterEscalationCeiling.swift:7). The strictest layer wins."
    },
    "levels": {
      "type": "array",
      "description": "Optional learning path (purpose://candidate.game-workshop.learning.progression-path).",
      "items": {
        "type": "object",
        "required": [
          "n",
          "title",
          "unlocks"
        ],
        "properties": {
          "n": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "unlocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "humanApproval": {
      "type": "object",
      "description": "Actions that need a named human besides the user, e.g. publishing.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "acceptedWithoutEdit",
          "secondsToFirstPreview",
          "clarifyingQuestionsPerWish",
          "revertsPerSession",
          "errorsExplained"
        ]
      },
      "description": "Shared across all workbenches."
    }
  }
}
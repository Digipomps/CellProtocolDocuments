+    /// The dedicated per-Cell bridge is the path HAVEN actually uses. A host that
+    /// authenticates the upgrade can only learn who is connecting from the URL,
+    /// because `LightweightBridgeTransport` opens the socket with
+    /// `URLSession.webSocketTask(with:)` and cannot attach request headers.
+    /// Before 2026-09-02 the provider was applied to the legacy endpoint path and
+    /// to the multiplex session URL, but not here, so a credential silently never
+    /// reached the server.
+    func testDedicatedBridgeConnectionURLCarriesProvidedQueryItems() throws {
+        let resolver = CellResolver.makeIsolatedForTesting()
+        CellBase.remoteWebSocketQueryItemsProvider = { _ in
+            [
+                URLQueryItem(name: "proof", value: "abc123"),
+                URLQueryItem(name: "", value: "dropped"),
+                URLQueryItem(name: "kid", value: "key-1")
+            ]
+        }
+
+        let url = try resolver.remoteWebSocketConnectionURLForTesting(
+            endpoint: "cell://example.haven.local/ConfigurationCatalog",
+            publisherUUID: "11111111-2222-3333-4444-555555555555",
+            route: RemoteCellHostRoute(
+                websocketEndpoint: "bridgehead",
+                schemePreference: .wss,
+                pathLayout: .endpointThenPublisherUUID
+            )
+        )
+
+        let components = try XCTUnwrap(URLComponents(url: url, resolvingAgainstBaseURL: false))
+        XCTAssertEqual(components.scheme, "wss")
+        XCTAssertEqual(components.host, "example.haven.local")
+        XCTAssertEqual(
+            components.path,
+            "/bridgehead/ConfigurationCatalog/11111111-2222-3333-4444-555555555555"
+        )
+        let items: [URLQueryItem] = try XCTUnwrap(components.queryItems)
+        let names: [String] = items.map { $0.name }.sorted()
+        XCTAssertEqual(names, ["kid", "proof"])
+        XCTAssertEqual(items.first(where: { $0.name == "proof" })?.value, "abc123")
+        XCTAssertFalse(items.contains(where: { $0.name.isEmpty }), "Blank query names must be dropped")
+    }
+
+    /// No provider means no query string at all — an unauthenticated host must not
+    /// start seeing a stray `?` appear on its bridge URLs.
+    func testDedicatedBridgeConnectionURLHasNoQueryWithoutProvider() throws {
+        let resolver = CellResolver.makeIsolatedForTesting()
+        CellBase.remoteWebSocketQueryItemsProvider = nil
+
+        let url = try resolver.remoteWebSocketConnectionURLForTesting(
+            endpoint: "cell://example.haven.local/ConfigurationCatalog",
+            publisherUUID: "11111111-2222-3333-4444-555555555555",
+            route: RemoteCellHostRoute(
+                websocketEndpoint: "bridgehead",
+                schemePreference: .wss,
+                pathLayout: .endpointThenPublisherUUID
+            )
+        )
+
+        XCTAssertNil(URLComponents(url: url, resolvingAgainstBaseURL: false)?.queryItems)
+        XCTAssertEqual(
+            url.absoluteString,
+            "wss://example.haven.local/bridgehead/ConfigurationCatalog/11111111-2222-3333-4444-555555555555"
+        )
+    }

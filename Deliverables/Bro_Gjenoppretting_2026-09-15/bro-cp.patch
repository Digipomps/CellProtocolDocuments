+    /// Same checks `IdentitySigningChallenge.proveControl` performs, but it
+    /// returns the signed challenge and its signature rather than a Bool. The
+    /// proof is what a remote host needs in order to authenticate the caller;
+    /// discarding it was why the bridge could only ever be unauthenticated.
+    private func proveRemoteBridgeAuthority(
+        for identity: Identity,
+        logicalEndpoint: String,
+        now: Date = Date()
+    ) async -> (challenge: Data, signature: Data)? {
+        guard let vault = identity.identityVault,
+              let homeVaultReference = identity.homeVaultReference,
+              await vault.identityVaultReference() == homeVaultReference,
+              identity.signingPublicKeyFingerprint != nil,
+              await vault.identityExistInVault(identity),
+              let nonce = await vault.randomBytes64(),
+              nonce.count >= IdentitySigningChallenge.minimumNonceBytes,
+              nonce.count <= IdentitySigningChallenge.maximumNonceBytes else {
+            return nil
+        }
+        do {
+            let data = try IdentitySigningChallenge.signingData(
+                for: identity,
+                trustedIdentity: identity,
+                domain: Self.remoteBridgeAuthorityDomain,
+                resource: Self.remoteBridgeAuthorityChallengeResource(for: logicalEndpoint),
+                action: Self.remoteBridgeAuthorityAction,
+                audience: Self.remoteBridgeAuthorityAudience,
+                nonce: nonce,
+                issuedAt: now
+            )
+            _ = try IdentitySigningChallenge.validateSigningData(data, for: identity, now: now)
+            guard let signature = try await identity.sign(data: data),
+                  IdentityPublicKeySignatureVerifier.verify(
+                    signature: signature,
+                    messageData: data,
+                    identity: identity
+                  ) else {
+                return nil
+            }
+            return (challenge: data, signature: signature)
+        } catch {
+            return nil
+        }
+    }
+
+    /// Base64url without padding, matching what the scaffold decodes.
+    static func remoteBridgeBase64URL(_ data: Data) -> String {
+        data.base64EncodedString()
+            .replacingOccurrences(of: "+", with: "-")
+            .replacingOccurrences(of: "/", with: "_")
+            .replacingOccurrences(of: "=", with: "")
+    }

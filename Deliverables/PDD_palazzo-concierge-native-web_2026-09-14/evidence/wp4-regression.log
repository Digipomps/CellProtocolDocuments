HTTP 200: {"endpoint":"cell:\/\/\/PalazzoContent","keypath":"content.draft.tags.approve","value":{"proposal":{"payload":{"proposedTagsText":"pistasj, bronte, etna, dop, nøtter, gelato, pesto","tags":["pistasj","bronte","etna","dop","nøtter","gelato","pesto"],"articleID":"art-pistasj-bronte","dishID":"article:art-pistasj-bronte"},"dishID":"article:art-pistasj-bronte","status":"approved","dishTitle":"Pistasj fra Bronte — det grønne gullet under Etna","id":"article:art-pistasj-bronte","proposedTagsText":"pistasj, bronte, etna, dop, nøtter, gelato, pesto","kind":"article","dishDescription":"På lavajorden vest for Etna dyrkes pistasjnøtter som høstes bare annethvert år, for hånd, i september. Bronte-pistasjen er smaragdgrønn, intens og litt harpiksaktig, og har beskyttet opprinnelse (DOP). Den brukes i pesto til pasta, i gelato og granita, i cannoli-fyll, og i det siste stadig oftere over sjømat. Prisen forklares av høsten: bratte lavaskråninger, ingen maskiner.","articleID":"art-pistasj-bronte"},"status":"approved"}}

+
+struct EntityScaffoldDataRequest: Codable {
+    struct Payload: Codable {
+        var version = 1
+        var operation: String
+        var linkID: String
+        var enrollmentRequestID: String
+        var ownerIdentityUUID: String
+        var scaffoldIdentityUUID: String
+        var scaffoldIdentityDomain: String
+        var scaffoldPublicKeyBase64URL: String
+        var entityAnchorReference: String
+        var keypath: String
+        var capability: String
+        var purposeRef: String
+        var audience: String
+        var nonce: String
+        var createdAt: String
+        var expiresAt: String
+        var value: ValueType?
+    }
+    var payload: Payload
+    var proof: EntityScaffoldSignatureEnvelope
+    var ownerProof: EntityScaffoldSignatureEnvelope?
+
+    func value() throws -> ValueType {
+        try JSONDecoder().decode(ValueType.self, from: JSONEncoder().encode(self))
+    }
+
+    static func decode(_ value: ValueType) throws -> Self {
+        guard case .object(let object) = value,
+              Set(object.keys).isSubset(of: ["payload", "proof", "ownerProof"]),
+              case .object(let payload)? = object["payload"],
+              Set(payload.keys).isSubset(of: ["version", "operation", "linkID", "enrollmentRequestID", "ownerIdentityUUID", "scaffoldIdentityUUID",
+                "scaffoldIdentityDomain", "scaffoldPublicKeyBase64URL", "entityAnchorReference", "keypath",
+                "capability", "purposeRef", "audience", "nonce", "createdAt", "expiresAt", "value"]) else {
+            throw EntityScaffoldEnrollmentError.invalidPayload("Only a signed entity operation is accepted; cached grants and cache revisions are not authority.")
+        }
+        return try JSONDecoder().decode(Self.self, from: JSONEncoder().encode(value))
+    }
+}
+
+/// Client-side proxy to the canonical home's scaffold-scoped access ingress.
+/// The signed active enrollment is the bounded entity-data grant.
+/// This type holds no owner signing material and creates no local EntityAnchor.
+struct EntityScaffoldEntityAnchorProxy {
+    var accessReference: String
+    var ownerIdentityUUID: String
+    var link: EntityScaffoldLinkRecord
+    var requester: Identity
+
+    func request(operation: String, keypath: String, capability: String, value: ValueType? = nil,
+                 ownerApprover: Identity? = nil) async throws -> EntityScaffoldDataRequest {
+        let now = Date()
+        let payload = EntityScaffoldDataRequest.Payload(
+            operation: operation, linkID: link.linkID, enrollmentRequestID: link.requestID, ownerIdentityUUID: ownerIdentityUUID, scaffoldIdentityUUID: requester.uuid,
+            scaffoldIdentityDomain: link.scaffoldIdentityDomain,
+            scaffoldPublicKeyBase64URL: try EntityScaffoldEnrollmentSigning.publicKeyBase64URL(for: requester),
+            entityAnchorReference: link.entityAnchorReference, keypath: keypath, capability: capability,
+            purposeRef: EntityHomePolicy.dataPurpose, audience: link.audience,
+            nonce: UUID().uuidString, createdAt: EntityScaffoldEnrollmentClock.string(from: now),
+            expiresAt: EntityScaffoldEnrollmentClock.string(from: now.addingTimeInterval(120)), value: value
+        )
+        var request = EntityScaffoldDataRequest(payload: payload,
+            proof: try await EntityScaffoldEnrollmentSigning.signatureEnvelope(payload: payload, signer: requester))
+        if let ownerApprover {
+            request.ownerProof = try await EntityScaffoldEnrollmentSigning.signatureEnvelope(payload: payload, signer: ownerApprover)
+        }
+        return request
+    }
+
+    func perform(_ request: EntityScaffoldDataRequest) async throws -> ValueType {
+        guard let resolver = CellBase.defaultCellResolver,
+              let cell = try await resolver.cellAtEndpoint(endpoint: accessReference, requester: requester) as? Meddle else {
+            throw CellBaseError.noResolver
+        }
+        return try await cell.set(keypath: EntityScaffoldDataAccessCell.operation, value: request.value(), requester: requester) ?? .null
+    }
+}
+
+/// Decrypted, volatile display snapshot, not a persistence or grant artifact.
+/// A durable copy requires an encrypted cache exception in EntityHomePolicy.
+struct EntityScaffoldCachedRead {
+    let value: ValueType
+    let sourceHomeReference: String
+    let revision: String
+    let expiresAt: Date
+
+    func render(now: Date = Date()) -> ValueType {
+        .object(["value": value, "sourceHomeReference": .string(sourceHomeReference),
+                 "revision": .string(revision), "stale": .bool(expiresAt <= now),
+                 "mayAuthorizeWrite": .bool(false)])
+    }
+}
+
+actor EntityScaffoldOperationGate {
+    private var held = false
+    private var waiters: [CheckedContinuation<Void, Never>] = []
+    func run<T>(_ action: () async -> T) async -> T {
+        if held { await withCheckedContinuation { waiters.append($0) } } else { held = true }
+        let result = await action()
+        if waiters.isEmpty { held = false } else { waiters.removeFirst().resume() }
+        return result
+    }
+}
+
+extension EntityScaffoldDataRequest {
+    static var exploreSchema: ValueType {
+        let string = ExploreContract.schema(type: "string")
+        let storedValue = ExploreContract.oneOfSchema(options: ["object", "list", "string", "integer", "float", "bool", "null"].map { ExploreContract.schema(type: $0) })
+        let signature = ExploreContract.objectSchema(properties: ["type": string, "algorithm": string,
+            "byIdentityUUID": string, "signatureBase64URL": string],
+            requiredKeys: ["type", "algorithm", "byIdentityUUID", "signatureBase64URL"])
+        var fields: Object = [:]
+        let requiredFields = ["operation", "linkID", "enrollmentRequestID", "ownerIdentityUUID", "scaffoldIdentityUUID", "scaffoldIdentityDomain", "scaffoldPublicKeyBase64URL",
+            "entityAnchorReference", "keypath", "capability", "purposeRef", "audience", "nonce", "createdAt", "expiresAt"]
+        for key in requiredFields { fields[key] = string }
+        fields["version"] = ExploreContract.schema(type: "integer")
+        fields["value"] = storedValue
+        return ExploreContract.objectSchema(properties: [
+            "payload": ExploreContract.objectSchema(properties: fields, requiredKeys: ["version"] + requiredFields),
+            "proof": signature, "ownerProof": signature], requiredKeys: ["payload", "proof"])
+    }
+    static var resultSchema: ValueType {
+        let string = ExploreContract.schema(type: "string")
+        let storedValue = ExploreContract.oneOfSchema(options: ["object", "list", "string", "integer", "float", "bool", "null"].map { ExploreContract.schema(type: $0) })
+        return ExploreContract.objectSchema(properties: ["status": string, "operation": string,
+            "operationID": string, "keypath": string, "capability": string, "entityAnchorReference": string,
+            "policyRevision": string, "linkID": string, "value": storedValue,
+            "error": ExploreContract.objectSchema(properties: ["code": string, "message": string], requiredKeys: ["code", "message"])], requiredKeys: ["status"])
+    }
+}

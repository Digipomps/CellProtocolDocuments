diff --git a/Sources/App/Cells/EntityScaffoldEnrollment/EntityHomePolicy.swift b/Sources/App/Cells/EntityScaffoldEnrollment/EntityHomePolicy.swift
new file mode 100644
--- /dev/null
+++ b/Sources/App/Cells/EntityScaffoldEnrollment/EntityHomePolicy.swift
@@ -0,0 +1,188 @@
+import CellBase
+import Foundation
+
+/// Owner-local placement authority, persisted with EntityScaffoldEnrollment.
+/// A routing reference identifies a location; it never supplies authority.
+struct EntityHomePolicy: Codable, Equatable {
+    static let families = ["entityRepresentation", "relations", "agreements", "purposes", "chronicle"]
+    static let dataPurpose = "purpose://entity.owner-access"
+
+    struct Placement: Codable, Equatable {
+        var family: String
+        var entityAnchorReference: String
+    }
+
+    struct LocalCopy: Codable, Equatable {
+        enum Kind: String, Codable { case cache, backup, index, uiState }
+        var family: String
+        var scaffoldReference: String
+        var kind: Kind
+        var encrypted: Bool
+    }
+
+    var policyID: String
+    var ownerIdentityUUID: String
+    var homeScaffoldReference: String
+    var preferredStorageScaffoldReference: String
+    var availabilityTier: String
+    var estimatedMonthlyCostNOK: Int?
+    var maxMonthlyCostNOK: Int?
+    var dataSensitivity: String
+    var transportPolicy: String
+    var backupPolicy: String
+    var ownerPresenceRequiredForWrites: Bool
+    var status: String
+    var updatedAt: String
+    // Optional on disk so old enrollment snapshots remain readable. Old policy
+    // has one home for all families and grants no local-copy exceptions.
+    var placements: [Placement]?
+    var localCopies: [LocalCopy]?
+    var region: String?
+    var hostingBoundary: String?
+    var allowedRegions: [String]?
+    var allowedHostingBoundaries: [String]?
+    var revision: String?
+
+    var effectivePlacements: [Placement] {
+        placements ?? Self.families.map { Placement(family: $0, entityAnchorReference: homeScaffoldReference) }
+    }
+
+    static func defaultPolicy(owner: Identity) -> EntityHomePolicy {
+        EntityHomePolicy(
+            policyID: "entity-home-policy:\(owner.uuid)", ownerIdentityUUID: owner.uuid,
+            homeScaffoldReference: "cell:///EntityAnchor", preferredStorageScaffoldReference: "cell:///EntityAnchor",
+            availabilityTier: "local", estimatedMonthlyCostNOK: nil, maxMonthlyCostNOK: nil,
+            dataSensitivity: "owner-private", transportPolicy: "owner-approved-capability",
+            backupPolicy: "identity-vault-bound", ownerPresenceRequiredForWrites: true,
+            status: "active", updatedAt: EntityScaffoldEnrollmentClock.nowString()
+        )
+    }
+
+    func canonicalReference(for keypath: String, owner: Identity) throws -> String {
+        try validate(owner: owner)
+        guard status == "active" else {
+            throw EntityScaffoldEnrollmentError.invalidPayload("Home placement requires owner confirmation.")
+        }
+        guard let placement = effectivePlacements.first(where: {
+            keypath == $0.family || keypath.hasPrefix($0.family + ".") || keypath.hasPrefix($0.family + "[")
+        }) else {
+            throw EntityScaffoldEnrollmentError.invalidPayload("No canonical home for this entity family.")
+        }
+        return try EntityScaffoldEnrollmentCell.normalizedEntityAnchorEndpoint(placement.entityAnchorReference, owner: owner)
+    }
+
+    func validate(owner: Identity) throws {
+        guard ownerIdentityUUID == owner.uuid else { throw EntityScaffoldEnrollmentError.issuerMismatch }
+        guard ["synthetic", "public", "private", "owner-private", "sensitive"].contains(dataSensitivity) else {
+            throw EntityScaffoldEnrollmentError.invalidPayload("Unknown data sensitivity requires owner policy review.")
+        }
+        let homes = effectivePlacements
+        guard homes.count == Self.families.count, Set(homes.map(\.family)) == Set(Self.families) else {
+            throw EntityScaffoldEnrollmentError.invalidPayload("Each entity family must have exactly one canonical home.")
+        }
+        let home = try EntityScaffoldEnrollmentCell.normalizedEntityAnchorEndpoint(homeScaffoldReference, owner: owner)
+        let preferred = try EntityScaffoldEnrollmentCell.normalizedEntityAnchorEndpoint(preferredStorageScaffoldReference, owner: owner)
+        guard home == preferred else {
+            throw EntityScaffoldEnrollmentError.invalidPayload("A preferred store cannot be a second canonical home; use an explicit family placement or backup exception.")
+        }
+        let endpoints = try homes.map { try EntityScaffoldEnrollmentCell.normalizedEntityAnchorEndpoint($0.entityAnchorReference, owner: owner) }
+        let hosted = endpoints.contains { $0 != "cell:///EntityAnchor" } || availabilityTier.hasPrefix("hosted") || availabilityTier == "private-cloud" || availabilityTier == "swarm"
+        if hosted {
+            guard let cost = estimatedMonthlyCostNOK, let cap = maxMonthlyCostNOK,
+                  cost >= 0, cap >= 0, cost <= cap,
+                  let region, allowedRegions?.contains(region) == true,
+                  let hostingBoundary, allowedHostingBoundaries?.contains(hostingBoundary) == true,
+                  transportPolicy == "tls-remote-bridge" || transportPolicy == "vpn-lan" else {
+                throw EntityScaffoldEnrollmentError.invalidPayload("Hosted placement is outside the owner's cost, region, hosting or transport policy.")
+            }
+        }
+        var copies = Set<String>()
+        for copy in localCopies ?? [] {
+            guard Self.families.contains(copy.family), !copy.scaffoldReference.isEmpty,
+                  copies.insert(copy.family + "|" + copy.scaffoldReference).inserted else {
+                throw EntityScaffoldEnrollmentError.invalidPayload("Invalid or duplicate local-copy exception.")
+            }
+            if copy.kind == .cache || copy.kind == .backup {
+                guard copy.encrypted else {
+                    throw EntityScaffoldEnrollmentError.invalidPayload("Cache and backup exceptions require encryption.")
+                }
+            }
+        }
+    }
+
+    /// Audits known storage declarations. It does not scan another machine's
+    /// disk, nor pretend that a recipient cannot copy previously disclosed data.
+    func validateObservedCopy(family: String, scaffoldReference: String, kind: String,
+                              encrypted: Bool, containsEntityValues: Bool, writable: Bool,
+                              owner: Identity) throws {
+        let home = try canonicalReference(for: family, owner: owner)
+        if kind == "canonical" {
+            guard try EntityScaffoldEnrollmentCell.normalizedEntityAnchorEndpoint(scaffoldReference, owner: owner) == home else {
+                throw EntityScaffoldEnrollmentError.invalidPayload("Duplicate canonical entity data detected.")
+            }
+            return
+        }
+        guard !writable, let role = LocalCopy.Kind(rawValue: kind),
+              let exception = localCopies?.first(where: {
+                  $0.family == family && $0.scaffoldReference == scaffoldReference && $0.kind == role
+              }) else {
+            throw EntityScaffoldEnrollmentError.invalidPayload("Undeclared or writable second copy of entity data.")
+        }
+        switch exception.kind {
+        case .cache, .backup:
+            guard encrypted && exception.encrypted else {
+                throw EntityScaffoldEnrollmentError.invalidPayload("Unencrypted entity copy.")
+            }
+        case .index, .uiState:
+            guard !containsEntityValues else {
+                throw EntityScaffoldEnrollmentError.invalidPayload("Entity values require a named cache or backup exception.")
+            }
+        }
+    }
+
+    static func decode(_ value: ValueType, owner: Identity) throws -> EntityHomePolicy {
+        let object = EntityScaffoldEnrollmentValueCodec.object(from: value)
+        func string(_ name: String, _ fallback: String) -> String {
+            EntityScaffoldEnrollmentValueCodec.string(name, in: object) ?? fallback
+        }
+        func strings(_ name: String) -> [String]? {
+            guard case .list(let values)? = object[name] else { return nil }
+            return values.compactMap { if case .string(let s) = $0 { return s }; return nil }
+        }
+        func integer(_ name: String) -> Int? {
+            switch object[name] { case .integer(let n)?, .number(let n)?: return n; default: return nil }
+        }
+        var policy = defaultPolicy(owner: owner)
+        policy.homeScaffoldReference = string("homeScaffoldReference", policy.homeScaffoldReference)
+        policy.preferredStorageScaffoldReference = string("preferredStorageScaffoldReference", policy.homeScaffoldReference)
+        policy.ownerIdentityUUID = string("ownerIdentityUUID", owner.uuid)
+        policy.availabilityTier = string("availabilityTier", "local")
+        policy.estimatedMonthlyCostNOK = integer("estimatedMonthlyCostNOK")
+        policy.maxMonthlyCostNOK = integer("maxMonthlyCostNOK")
+        policy.dataSensitivity = string("dataSensitivity", "owner-private")
+        policy.transportPolicy = string("transportPolicy", "owner-approved-capability")
+        policy.backupPolicy = string("backupPolicy", "identity-vault-bound")
+        if case .bool(let presence)? = object["ownerPresenceRequiredForWrites"] { policy.ownerPresenceRequiredForWrites = presence }
+        policy.region = EntityScaffoldEnrollmentValueCodec.string("region", in: object)
+        policy.hostingBoundary = EntityScaffoldEnrollmentValueCodec.string("hostingBoundary", in: object)
+        policy.allowedRegions = strings("allowedRegions")
+        policy.allowedHostingBoundaries = strings("allowedHostingBoundaries")
+        policy.revision = UUID().uuidString
+        if let placements = object["placements"] {
+            policy.placements = try JSONDecoder().decode([Placement].self, from: JSONEncoder().encode(placements))
+        }
+        if let copies = object["localCopies"] {
+            policy.localCopies = try JSONDecoder().decode([LocalCopy].self, from: JSONEncoder().encode(copies))
+        }
+        try policy.validate(owner: owner)
+        return policy
+    }
+
+    func value() -> ValueType {
+        // Both types use the same ordinary JSON object/array/scalar encoding.
+        var snapshot = self
+        snapshot.placements = effectivePlacements
+        snapshot.localCopies = localCopies ?? []
+        return (try? JSONDecoder().decode(ValueType.self, from: JSONEncoder().encode(snapshot))) ?? .null
+    }
+}
diff --git a/Sources/App/Cells/EntityScaffoldEnrollment/EntityScaffoldDataAccessCell.swift b/Sources/App/Cells/EntityScaffoldEnrollment/EntityScaffoldDataAccessCell.swift
new file mode 100644
--- /dev/null
+++ b/Sources/App/Cells/EntityScaffoldEnrollment/EntityScaffoldDataAccessCell.swift
@@ -0,0 +1,62 @@
+import CellBase
+import Foundation
+
+/// Scaffold-scoped ingress for identities that do not own the home enrollment
+/// Cell. It forwards the original requester, never the owner's authority.
+/// The owner UUID is only a routing hint into this scaffold's existing vault.
+final class EntityScaffoldDataAccessCell: GeneralCell {
+    static let cellName = "EntityScaffoldDataAccess"
+    static let operation = "entityData.perform"
+
+    required init(owner: Identity) async {
+        await super.init(owner: owner)
+        try? await ensureRuntimeReady()
+    }
+
+    required init(from decoder: Decoder) throws { try super.init(from: decoder) }
+
+    override func installCellRuntimeBindingsForAccess() async throws {
+        await registerSet(key: Self.operation, owner: storedOwnerIdentity,
+            input: EntityScaffoldDataRequest.exploreSchema,
+            returns: EntityScaffoldDataRequest.resultSchema,
+            permissions: ["-w--"], description: .string("Forwards a signed enrolled-scaffold operation to its owner's canonical enrollment authority.")) { [weak self] requester, payload in
+                guard let self else { return .null }
+                return await self.perform(payload, requester: requester)
+            }
+    }
+
+    override func validateCellSpecificAccess(_ requestedAccess: String, at keypath: String, for identity: Identity) async -> Bool {
+        // This only admits a proof-bearing caller to the ingress. It grants no
+        // entity read/write authority; the target Cell checks the signed link,
+        // scope, home policy, expiry and nonce for every operation.
+        requestedAccess == "-w--" && keypath == Self.operation
+            ? await verifyRequesterIdentityControl(identity) : false
+    }
+
+    private func perform(_ value: ValueType, requester: Identity) async -> ValueType {
+        do {
+            let request = try EntityScaffoldDataRequest.decode(value)
+            guard request.payload.scaffoldIdentityUUID == requester.uuid,
+                  await verifyRequesterIdentityControl(requester),
+                  let vault = CellBase.defaultIdentityVault,
+                  let owner = await vault.identity(forUUID: request.payload.ownerIdentityUUID),
+                  await vault.identityExistInVault(owner),
+                  let resolver = CellBase.defaultCellResolver,
+                  let enrollment = try await resolver.cellAtEndpoint(
+                    endpoint: EntityScaffoldEnrollmentContract.endpoint, requester: owner
+                  ) as? EntityScaffoldEnrollmentCell else { return Self.denied }
+            let key: String
+            switch request.payload.operation {
+            case "read": key = EntityScaffoldEnrollmentContract.Keys.entityDataGet
+            case "write": key = EntityScaffoldEnrollmentContract.Keys.entityDataSet
+            default: return Self.denied
+            }
+            return try await enrollment.set(keypath: key, value: value, requester: requester) ?? Self.denied
+        } catch { return Self.denied }
+    }
+
+    private static var denied: ValueType {
+        .object(["status": .string("denied"), "error": .object([
+            "code": .string("entity-access-denied"), "message": .string("No current enrolled entity authority accepted this operation.")])])
+    }
+}

{
  "VStack": {
    "spacing": 14,
    "elements": [
      {
        "VStack": {
          "spacing": 10,
          "elements": [
            {
              "Text": {
                "text": "Mine roller",
                "modifiers": {
                  "foregroundColor": "#172033",
                  "fontStyle": "title2",
                  "fontWeight": "700"
                }
              }
            },
            {
              "Text": {
                "text": "Roller er bevis som andre celler kan sjekke. De gir ingen tilgang til dataene dine.",
                "modifiers": {
                  "foregroundColor": "#556273",
                  "fontSize": 14
                }
              }
            }
          ],
          "modifiers": {
            "padding": 16,
            "background": "#FFFFFF",
            "cornerRadius": 12,
            "borderWidth": 1,
            "borderColor": "#E2E8F0",
            "maxWidthInfinity": true
          }
        }
      },
      {
        "VStack": {
          "spacing": 10,
          "elements": [
            {
              "List": {
                "elements": [],
                "keypath": "myRole.state.roles",
                "selectionMode": "none",
                "modifiers": {
                  "itemSpacing": 8
                },
                "flowElementSkeleton": {
                  "VStack": {
                    "spacing": 2,
                    "elements": [
                      {
                        "HStack": {
                          "spacing": 8,
                          "elements": [
                            {
                              "Text": {
                                "keypath": "title",
                                "modifiers": {
                                  "foregroundColor": "#172033",
                                  "fontWeight": "700"
                                }
                              }
                            },
                            {
                              "Spacer": {}
                            },
                            {
                              "Text": {
                                "keypath": "status",
                                "modifiers": {
                                  "foregroundColor": "#0F766E",
                                  "fontSize": 13
                                }
                              }
                            }
                          ]
                        }
                      },
                      {
                        "Text": {
                          "keypath": "issuer",
                          "modifiers": {
                            "foregroundColor": "#556273",
                            "fontSize": 13
                          }
                        }
                      },
                      {
                        "Text": {
                          "keypath": "validity",
                          "modifiers": {
                            "foregroundColor": "#556273",
                            "fontSize": 13
                          }
                        }
                      },
                      {
                        "Text": {
                          "keypath": "usedBy",
                          "modifiers": {
                            "foregroundColor": "#172033",
                            "fontSize": 13
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "modifiers": {
            "padding": 16,
            "background": "#FFFFFF",
            "cornerRadius": 12,
            "borderWidth": 1,
            "borderColor": "#E2E8F0",
            "maxWidthInfinity": true
          }
        }
      },
      {
        "VStack": {
          "spacing": 10,
          "elements": [
            {
              "Text": {
                "text": "Rollen er trukket tilbake",
                "modifiers": {
                  "foregroundColor": "#B91C1C",
                  "fontStyle": "headline"
                }
              }
            },
            {
              "Text": {
                "keypath": "myRole.state.revokedNote",
                "modifiers": {
                  "foregroundColor": "#172033",
                  "fontSize": 14
                }
              }
            }
          ],
          "modifiers": {
            "padding": 16,
            "background": "#FFFFFF",
            "cornerRadius": 12,
            "borderWidth": 1,
            "borderColor": "#FCA5A5",
            "maxWidthInfinity": true,
            "visibility": {
              "when": {
                "equals": true,
                "keypath": "myRole.state.hasRevoked",
                "scope": "root"
              }
            }
          }
        }
      }
    ]
  }
}

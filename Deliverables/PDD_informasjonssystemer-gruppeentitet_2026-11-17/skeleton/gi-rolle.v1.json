{
  "VStack": {
    "spacing": 14,
    "elements": [
      {
        "VStack": {
          "spacing": 10,
          "elements": [
            {
              "Text": {
                "text": "Gi rolle i Informasjonssystemer",
                "modifiers": {
                  "foregroundColor": "#172033",
                  "fontStyle": "title2",
                  "fontWeight": "700"
                }
              }
            },
            {
              "VStack": {
                "spacing": 4,
                "elements": [
                  {
                    "Text": {
                      "text": "Mottaker (invitasjonskode eller HAVEN-identitet)",
                      "modifiers": {
                        "foregroundColor": "#556273",
                        "fontSize": 13
                      }
                    }
                  },
                  {
                    "TextField": {
                      "sourceKeypath": "group.state.newRole.recipient",
                      "targetKeypath": "group.newRole.recipient.set",
                      "placeholder": "f.eks. K7QX-2M"
                    }
                  }
                ]
              }
            },
            {
              "Text": {
                "keypath": "group.state.newRole.recipientResolved",
                "modifiers": {
                  "foregroundColor": "#0F766E",
                  "fontSize": 13
                }
              }
            },
            {
              "VStack": {
                "spacing": 4,
                "elements": [
                  {
                    "Text": {
                      "text": "Rolle",
                      "modifiers": {
                        "foregroundColor": "#556273",
                        "fontSize": 13
                      }
                    }
                  },
                  {
                    "Picker": {
                      "keypath": "group.state.newRole.roles",
                      "optionLabelKeypath": "label",
                      "selectionStateKeypath": "group.state.newRole.selectedRole",
                      "selectionValueKeypath": "id",
                      "selectionPayloadMode": "item_id",
                      "placeholder": "Velg rolle"
                    }
                  }
                ]
              }
            },
            {
              "VStack": {
                "spacing": 4,
                "elements": [
                  {
                    "Text": {
                      "text": "Kull",
                      "modifiers": {
                        "foregroundColor": "#556273",
                        "fontSize": 13
                      }
                    }
                  },
                  {
                    "Picker": {
                      "keypath": "group.state.newRole.cohorts",
                      "optionLabelKeypath": "label",
                      "selectionStateKeypath": "group.state.newRole.selectedCohort",
                      "selectionValueKeypath": "id",
                      "selectionPayloadMode": "item_id",
                      "placeholder": "Velg kull"
                    }
                  }
                ]
              }
            },
            {
              "VStack": {
                "spacing": 4,
                "elements": [
                  {
                    "Text": {
                      "text": "Gyldig til",
                      "modifiers": {
                        "foregroundColor": "#556273",
                        "fontSize": 13
                      }
                    }
                  },
                  {
                    "TextField": {
                      "sourceKeypath": "group.state.newRole.validUntil",
                      "targetKeypath": "group.newRole.validUntil.set",
                      "placeholder": "dd.mm.åååå"
                    }
                  }
                ]
              }
            }
          ],
          "modifiers": {
            "padding": 16,
            "background": "#FFFFFF",
            "cornerRadius": 12,
            "borderWidth": 1,
            "borderColor": "#E2E8F0",
            "maxWidthInfinity": true
          }
        }
      },
      {
        "VStack": {
          "spacing": 10,
          "elements": [
            {
              "Text": {
                "text": "Dette signerer gruppa",
                "modifiers": {
                  "foregroundColor": "#172033",
                  "fontStyle": "headline"
                }
              }
            },
            {
              "Text": {
                "keypath": "group.state.newRole.preview",
                "modifiers": {
                  "foregroundColor": "#172033",
                  "fontSize": 14
                }
              }
            },
            {
              "Text": {
                "keypath": "group.state.newRole.rule",
                "modifiers": {
                  "foregroundColor": "#556273",
                  "fontSize": 13
                }
              }
            },
            {
              "HStack": {
                "spacing": 8,
                "modifiers": {
                  "wrap": true
                },
                "elements": [
                  {
                    "Button": {
                      "keypath": "group.newRole.submit",
                      "label": "Godkjenn og gi rolle",
                      "payload": {}
                    }
                  },
                  {
                    "Button": {
                      "keypath": "group.newRole.cancel",
                      "label": "Avbryt",
                      "payload": {},
                      "modifiers": {
                        "background": "#FFFFFF",
                        "borderColor": "#CBD5E1",
                        "borderWidth": 1,
                        "cornerRadius": 6,
                        "foregroundColor": "#334155"
                      }
                    }
                  }
                ]
              }
            }
          ],
          "modifiers": {
            "padding": 16,
            "background": "#FFFFFF",
            "cornerRadius": 12,
            "borderWidth": 1,
            "borderColor": "#E2E8F0",
            "maxWidthInfinity": true
          }
        }
      }
    ]
  }
}

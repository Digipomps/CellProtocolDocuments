     }
 
+    @discardableResult
     func register(requesterUUID: String, jsonPayload: Any) -> Int {
         let providers = ChatScopedAIProviderRouter.descriptors(fromJSONObject: jsonPayload)
-        providersByRequester[requesterUUID] = providers
+        store(providers, for: requesterUUID)
         return providers.count
     }
 
     func providers(for requesterUUID: String) -> [ChatScopedAIProviderDescriptor] {
-        providersByRequester[requesterUUID] ?? []
+        if let cached = providersByRequester[requesterUUID] {
+            return cached
+        }
+        guard persistenceEnabled, hydratedRequesters.contains(requesterUUID) == false else {
+            return []
+        }
+        hydratedRequesters.insert(requesterUUID)
+        let loaded = readFromDisk(requesterUUID: requesterUUID) ?? []
+        providersByRequester[requesterUUID] = loaded
+        return loaded
     }
 
     func clear(requesterUUID: String) {
         providersByRequester[requesterUUID] = []
+        hydratedRequesters.insert(requesterUUID)
+        guard persistenceEnabled, let url = storageURL(requesterUUID: requesterUUID) else { return }
+        try? FileManager.default.removeItem(at: url)
+    }
+
+    /// Kun for test: toemmer minnelaget uten aa roere disken, slik at neste
+    /// `providers(for:)` maa lese fra disk.
+    func dropInMemoryCache() {
+        providersByRequester.removeAll()
+        hydratedRequesters.removeAll()
+    }
+
+    // MARK: - Persistens
+
+    private func store(_ providers: [ChatScopedAIProviderDescriptor], for requesterUUID: String) {
+        providersByRequester[requesterUUID] = providers
+        hydratedRequesters.insert(requesterUUID)
+        guard persistenceEnabled else { return }
+        writeToDisk(providers, requesterUUID: requesterUUID)
+    }
+
+    private func writeToDisk(_ providers: [ChatScopedAIProviderDescriptor], requesterUUID: String) {
+        guard let url = storageURL(requesterUUID: requesterUUID) else { return }
+        do {
+            try FileManager.default.createDirectory(
+                at: url.deletingLastPathComponent(),
+                withIntermediateDirectories: true
+            )
+            let data = try JSONEncoder().encode(providers)
+            try data.write(to: url, options: .atomic)
+        } catch {
+            // Persistens er best effort. En feil her skal aldri hindre at
+            // registreringen virker i denne prosessen.
+        }
+    }
+
+    private func readFromDisk(requesterUUID: String) -> [ChatScopedAIProviderDescriptor]? {
+        guard let url = storageURL(requesterUUID: requesterUUID),
+              let data = try? Data(contentsOf: url) else {
+            return nil
+        }
+        return try? JSONDecoder().decode([ChatScopedAIProviderDescriptor].self, from: data)
+    }
+
+    private func storageURL(requesterUUID: String) -> URL? {
+        let sanitized = requesterUUID.filter { $0.isLetter || $0.isNumber || $0 == "-" || $0 == "_" }
+        guard sanitized.isEmpty == false else { return nil }
+        let rootPath = (CellBase.documentRootPath ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+        let root = rootPath.isEmpty
+            ? FileManager.default.temporaryDirectory.appendingPathComponent("CellScaffoldPersonalCopilot", isDirectory: true)
+            : URL(fileURLWithPath: rootPath, isDirectory: true)
+        return root
+            .appendingPathComponent("PersonalCopilot", isDirectory: true)
+            .appendingPathComponent("chat-providers", isDirectory: true)
+            .appendingPathComponent("\(sanitized).json")
     }
 }

+  const row = page.locator(".skeleton-list-row").filter({ hasText: item.title }).first();
+  await expect(row).toBeVisible({ timeout: config.actionTimeoutMs });
+  const openButton = row.getByRole("button", { name: "Open" });
+  await expect(openButton).toBeVisible({ timeout: config.actionTimeoutMs });
+  await openButton.click();
+
+  const drawer = page.getByRole("dialog", { name: "Work item details" });
+  await expect(drawer).toBeVisible({ timeout: config.actionTimeoutMs });
+  await expect(drawer.getByText(item.title).first()).toBeVisible({ timeout: config.actionTimeoutMs });
+  await drawer.getByRole("button", { name: "Set priority P0" }).click();
+  await waitForWorkItem(context, config, item.id, (entry) => entry.priority === "P0", "priority P0 from detail drawer");
+
+  let activityVerified = false;
+  for (let attempt = 0; attempt < 100; attempt += 1) {
+    const state = assertOK(await postAction(context, config, "workItems.state", null), "workItems.state");
+    const activity = state.selectedItem && Array.isArray(state.selectedItem.recentActivity)
+      ? state.selectedItem.recentActivity
+      : [];
+    if (activity.some((entry) => entry && entry.kind === "priority-changed")) {
+      activityVerified = true;
+      break;

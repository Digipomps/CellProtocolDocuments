+/// Register over AI-providere som er registrert inne i en forespoerrers chat-scope.
+///
+/// Tidligere var dette et rent in-memory-dictionary. En registrering doede da ved
+/// omstart av serveren og ble ikke delt mellom prosesser, slik at Butler Chat
+/// falt tilbake til `chat.local-rules` uten at noen hadde gjort noe galt.
+///
+/// Persistensen ligger bevisst i en EGEN, liten fil per forespoerrer — ikke i
+/// `state.chatDeclaredAIProvidersByRequester` i Personal Co-Pilot-tilstanden.
+/// `PersonalCopilotCloudStore.registerChatAssistantProviders` holder den veien
+/// lagringsfri med vilje, fordi `save()` der serialiserer HELE den store
+/// tilstandsfilen. Denne fila er noen faa kilobyte og kan skrives per
+/// registrering uten den kostnaden.
 actor ChatScopedAIProviderRegistry {
     static let shared = ChatScopedAIProviderRegistry()
 
     private var providersByRequester = [String: [ChatScopedAIProviderDescriptor]]()
+    /// Forespoerrere vi allerede har forsoekt aa lese fra disk for. Hindrer at et
+    /// tomt register gir én diskoperasjon per melding.
+    private var hydratedRequesters = Set<String>()
 
+    private let persistenceEnabled: Bool
+
+    init(persistenceEnabled: Bool = true) {
+        self.persistenceEnabled = persistenceEnabled
+    }
+
+    @discardableResult
     func register(requesterUUID: String, payload: ValueType) -> Int {
         let providers = ChatScopedAIProviderRouter.descriptors(from: payload)
-        providersByRequester[requesterUUID] = providers
+        store(providers, for: requesterUUID)

+                    purposes: context.purposeRefs.map { .init(token: $0, label: $0, weight: context.weights[$0] ?? 0) },
+                    interests: context.interests.map { .init(token: $0, label: $0, weight: context.weights[$0] ?? 0) }
+                )
+                if let projectedValue = try? projected.value(), PerspectiveLibraryProjection.decode(projectedValue) != nil {
+                    context.source = source
+                    return context
+                }
+            }
+            return ChatPurposeContext(purposeRefs: [], interests: [], weights: [:], source: source, libraryProjectionStatus: .unavailable)
+        }
+        if let value, case let .object(object) = value, PerspectiveLibraryProjection.recognizes(object) {
+            guard let projection = PerspectiveLibraryProjection.decode(value) else {
+                return ChatPurposeContext(purposeRefs: [], interests: [], weights: [:], source: source, libraryProjectionStatus: .unavailable)
+            }
+            return ChatPurposeContext(
+                purposeRefs: projection.purposes.map(\.token),
+                interests: projection.interests.map(\.token),
+                weights: Dictionary(uniqueKeysWithValues: (projection.purposes + projection.interests).map { ($0.token, $0.weight) }),
+                source: source, libraryProjectionStatus: projection.status
+            )
+        }
         var builder = ContextBuilder()
         builder.collect(value, hint: nil, inheritedWeight: nil)
         return builder.build(source: source)

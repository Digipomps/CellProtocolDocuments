     static func from(value: ValueType?, source: String) -> ChatPurposeContext {
+        // Raw graph bodies and pinned logical references need the shared CP adapter. Never flatten
+        // them through ContextBuilder, even if a caller attaches a legacy status or v0 view marker.
+        if let value, case let .object(object) = value, PerspectiveLibraryProjection.requiresSharedGraphAdapter(object) {

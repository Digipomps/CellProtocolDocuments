+    }
+
+    private static func decodeTaxonomySeed(_ value: ValueType) -> ArendalsukaInterestTaxonomySeed? {
+        let object = Self.object(value)
+        let subcategories: [ArendalsukaTaxonomySubcategory] = list(object["subcategories"]).compactMap { entry in
+            let row = Self.object(entry)
+            guard let id = string(row["subcategoryID"]),
+                  let topCategory = string(row["topCategory"]),
+                  let name = string(row["name"]) else { return nil }
+            return ArendalsukaTaxonomySubcategory(
+                subcategoryID: id,
+                topCategory: topCategory,
+                topicGroup: string(row["topicGroup"]),
+                name: name,
+                sessionCount: intValue(row["sessionCount"]) ?? 0
+            )
+        }
+        guard subcategories.isEmpty == false else { return nil }
+
+        let eventSeries: [ArendalsukaEventSeries] = list(object["eventSeries"]).compactMap { entry in
+            let row = Self.object(entry)
+            guard let id = string(row["seriesID"]), let name = string(row["name"]) else { return nil }
+            return ArendalsukaEventSeries(seriesID: id, name: name, organizerHint: string(row["organizerHint"]))
+        }
+
+        var sessionSubcategoryIDs: [String: [String]] = [:]
+        if case let .object(rawSessionSubcategoryIDs)? = object["sessionSubcategoryIDs"] {
+            for (sessionID, idsValue) in rawSessionSubcategoryIDs {
+                sessionSubcategoryIDs[sessionID] = stringList(idsValue) ?? []
+            }
+        }
+
+        var sessionSeriesIDs: [String: [String]] = [:]
+        if case let .object(rawSessionSeriesIDs)? = object["sessionSeriesIDs"] {
+            for (sessionID, idsValue) in rawSessionSeriesIDs {
+                sessionSeriesIDs[sessionID] = stringList(idsValue) ?? []
+            }
+        }
+
+        let deliberatelyUntagged = Set(stringList(object["deliberatelyUntaggedSessionIDs"]) ?? [])
+
+        return ArendalsukaInterestTaxonomySeed(
+            subcategories: subcategories,
+            eventSeries: eventSeries,
+            sessionSubcategoryIDs: sessionSubcategoryIDs,
+            sessionSeriesIDs: sessionSeriesIDs,
+            deliberatelyUntaggedSessionIDs: deliberatelyUntagged
+        )
+    }
+
+    private static func intValue(_ value: ValueType?) -> Int? {
+        guard case let .integer(int)? = value else { return nil }
+        return int
+    }
+

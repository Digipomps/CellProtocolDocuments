+                "subcategoriesCreated": .integer(createdSubcategories),
+                "subcategoriesUpdated": .integer(updatedSubcategories),
+                "eventSeriesReceived": .integer(eventSeriesValues.count),
+                "eventSeriesCreated": .integer(createdEventSeries),
+                "eventSeriesUpdated": .integer(updatedEventSeries),
+                "sessionSubcategoryLinksReceived": .integer(sessionSubcategoryLinkValues.count),
+                "sessionSubcategoryLinksCreated": .integer(createdSessionSubcategoryLinks),
+                "sessionSubcategoryLinksUpdated": .integer(updatedSessionSubcategoryLinks),
+                "sessionEventSeriesLinksReceived": .integer(sessionEventSeriesLinkValues.count),
+                "sessionEventSeriesLinksCreated": .integer(createdSessionEventSeriesLinks),
+                "sessionEventSeriesLinksUpdated": .integer(updatedSessionEventSeriesLinks),
+                "sessionStatusReceived": .integer(sessionStatusValues.count),
+                "totalSubcategoryCount": .integer(totalSubcategories),
+                "totalEventSeriesCount": .integer(totalEventSeries),
+                "totalSessionSubcategoryLinkCount": .integer(totalSessionSubcategoryLinks),
+                "totalSessionEventSeriesLinkCount": .integer(totalSessionEventSeriesLinks),
+                "totalSessionStatusCount": .integer(totalSessionStatus)
+            ]
+            lastStatus = "Imported taxonomy snapshot batch: \(createdSubcategories) new subcategory(s), \(createdEventSeries) new event series, \(createdSessionSubcategoryLinks) new session-subcategory link(s). Totals: \(totalSubcategories) subcategories, \(totalEventSeries) event series."

diff --git a/Public/css/porthole-webo.css b/Public/css/porthole-webo.css
index a92542aa..965e5db6 100644
--- a/Public/css/porthole-webo.css
+++ b/Public/css/porthole-webo.css
@@ -2332,12 +2332,34 @@ body.panel-resizing * {
   padding-bottom: max(7px, env(safe-area-inset-bottom));
 }
 
+/* Every configuration renders inside .skeleton-host, a scrollable box
+ * nested within the bordered .canvas preview card -- "sticky" only pins to
+ * that inner box's edge, not the actual browser window, so on a short page
+ * (e.g. Arendalsuka Matches with few results) the bar floats right below
+ * the last content element instead of sitting flush with the bottom of the
+ * screen. Fixed positioning escapes that nesting entirely and anchors to
+ * the real viewport edge. Scoped to .canvas rather than .canvas.product-view
+ * because NavigationBar is currently Arendalsuka-only (Program/Matches/
+ * Chat) regardless of which configurations porthole-webo.js's
+ * isProductSurfaceConfigurationName() happens to list. */
+.canvas .skeleton-navigation-bar.is-bottom-anchored {
+  position: fixed;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  width: min(1120px, 100%);
+  margin: 0 auto;
+  border-radius: 16px 16px 0 0;
+}
+
 .skeleton-navigation-bar-item {
   appearance: none;
   display: inline-flex;
   flex: 1 1 0;
+  flex-direction: column;
   align-items: center;
   justify-content: center;
+  gap: 2px;
   min-width: 0;
   min-height: 44px;
   box-sizing: border-box;
@@ -2354,6 +2376,14 @@ body.panel-resizing * {
   cursor: pointer;
 }
 
+.skeleton-navigation-bar-item-icon {
+  flex: none;
+}
+
+.skeleton-navigation-bar-item.has-icon .skeleton-navigation-bar-item-label {
+  font-size: 12px;
+}
+
 .skeleton-navigation-bar-item:hover:not(:disabled) {
   border-color: rgba(127, 214, 208, 0.36);
   background: rgba(127, 214, 208, 0.08);

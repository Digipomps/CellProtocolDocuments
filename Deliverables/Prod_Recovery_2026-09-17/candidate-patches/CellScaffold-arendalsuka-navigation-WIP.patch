+
+    /// Ingests `speaker.json`/`speaker_appearances.json`-shaped arrays (the
+    /// pipeline's clean `speaker`/`speaker_appearances` table exports) into
+    /// the actual persisted cell via `atlas.ingestSpeakerSnapshot`.
+    public static func runSpeakersAgainstPersistedCell(
+        speakersPath: String,
+        appearancesPath: String,
+        restoreUUID: String,
+        identityDomain: String = "arendalsuka-public-landing"
+    ) async throws -> Object {
+        let (resolver, cell, owner) = try await restorePersistedAtlasCell(restoreUUID: restoreUUID, identityDomain: identityDomain)
+
+        func loadList(_ path: String) throws -> [ValueType] {

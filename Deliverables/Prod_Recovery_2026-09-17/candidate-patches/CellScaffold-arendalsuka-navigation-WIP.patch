+    /// Ingests the curated topic taxonomy — subcategories, event series, and
+    /// their session links — from the `taxonomy_subcategory`/`event_series`/
+    /// `session_subcategory`/`session_event_series`/`taxonomy_generation_status`
+    /// source-of-truth tables (see `arendalsuka-data-pipeline` skill's
+    /// `references/schema.md`). Unlike stands/OSM POIs, the taxonomy is not
+    /// static: it's derived from session content and regenerated whenever the
+    /// program changes, so this is the live update path. The `Bundle.module`
+    /// static resource in `ArendalsukaInterestTaxonomy.swift` remains only a
+    /// fallback seed for fresh environments where nothing has been ingested
+    /// yet — see `taxonomySeedValue()` and `ArendalsukaMatchingCell`'s
+    /// consumption. Every key (`subcategories`/`eventSeries`/
+    /// `sessionSubcategoryLinks`/`sessionEventSeriesLinks`/`sessionStatus`) is
+    /// optional and independently batchable, mirroring `ingestSpeakerSnapshot`.
+    private func ingestTaxonomy(payload: Object, requester: Identity) -> ValueType {
+        let collectionKeys = ["subcategories", "eventSeries", "sessionSubcategoryLinks", "sessionEventSeriesLinks", "sessionStatus"]
+        for key in collectionKeys {
+            if let value = payload[key] {
+                guard case .list = value else { return .string("error: taxonomy collections must be lists") }
+            }
+        }
+        let importedAt = Date()
+        let source = EventPlatformValueDecoding.string(payload["source"]) ?? "arendalsuka-taxonomy-pipeline"
+
+        let subcategoryValues = EventPlatformValueDecoding.list(payload["subcategories"])
+        let eventSeriesValues = EventPlatformValueDecoding.list(payload["eventSeries"])
+        let sessionSubcategoryLinkValues = EventPlatformValueDecoding.list(payload["sessionSubcategoryLinks"])
+        let sessionEventSeriesLinkValues = EventPlatformValueDecoding.list(payload["sessionEventSeriesLinks"])
+        let sessionStatusValues = EventPlatformValueDecoding.list(payload["sessionStatus"])
+
+        let subcategoryCandidates = subcategoryValues.compactMap { value in
+            Self.taxonomySubcategoryRecord(from: EventPlatformValueDecoding.object(value), source: source, importedAt: importedAt)
+        }
+        let eventSeriesCandidates = eventSeriesValues.compactMap { value in
+            Self.eventSeriesRecord(from: EventPlatformValueDecoding.object(value), source: source, importedAt: importedAt)
+        }
+        let sessionSubcategoryLinkCandidates = sessionSubcategoryLinkValues.compactMap { value in
+            Self.sessionSubcategoryLinkRecord(from: EventPlatformValueDecoding.object(value), importedAt: importedAt)
+        }
+        let sessionEventSeriesLinkCandidates = sessionEventSeriesLinkValues.compactMap { value in
+            Self.sessionEventSeriesLinkRecord(from: EventPlatformValueDecoding.object(value), importedAt: importedAt)

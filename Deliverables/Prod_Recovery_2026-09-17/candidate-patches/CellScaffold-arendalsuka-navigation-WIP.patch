+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright (c) 2026 Stiftelsen Digipomps and HAVEN contributors
+
+@testable import App
+import Foundation
+import XCTest
+
+final class ArendalsukaLocalMatchTestSeedSafetyTests: XCTestCase {
+    func testSeedRequiresTestingEnvironmentAndDedicatedMarkedRuntime() throws {
+        let root = FileManager.default.temporaryDirectory.appendingPathComponent("MatchSeedSafety-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: root) }
+        let marker = root.appendingPathComponent(".haven-synthetic-test-runtime")
+        let environment = ["VAPOR_ENV": "testing", "CELL_SCAFFOLD_RUNTIME_ROOT": root.path]
+        XCTAssertThrowsError(try ArendalsukaLocalMatchTestSeedRunner.requireIsolatedTestRuntime(environment: [:]))
+        XCTAssertThrowsError(try ArendalsukaLocalMatchTestSeedRunner.requireIsolatedTestRuntime(environment: environment))
+        try "wrong-marker\n".write(to: marker, atomically: true, encoding: .utf8)
+        XCTAssertThrowsError(try ArendalsukaLocalMatchTestSeedRunner.requireIsolatedTestRuntime(environment: environment))
+        try "haven-synthetic-test-runtime-v1\n".write(to: marker, atomically: true, encoding: .utf8)
+        XCTAssertNoThrow(try ArendalsukaLocalMatchTestSeedRunner.requireIsolatedTestRuntime(environment: environment))
+        for disallowed in ["production", "staging", "development", ""] {
+            var value = environment; value["VAPOR_ENV"] = disallowed
+            XCTAssertThrowsError(try ArendalsukaLocalMatchTestSeedRunner.requireIsolatedTestRuntime(environment: value))
+        }
+        for disallowed in ["/", FileManager.default.homeDirectoryForCurrentUser.path, "relative/test"] {
+            var value = environment; value["CELL_SCAFFOLD_RUNTIME_ROOT"] = disallowed
+            XCTAssertThrowsError(try ArendalsukaLocalMatchTestSeedRunner.requireIsolatedTestRuntime(environment: value))
+        }
+        let moved = root.appendingPathComponent("marker-source")
+        try FileManager.default.moveItem(at: marker, to: moved)
+        try FileManager.default.createSymbolicLink(at: marker, withDestinationURL: moved)
+        XCTAssertThrowsError(try ArendalsukaLocalMatchTestSeedRunner.requireIsolatedTestRuntime(environment: environment))
+    }
+}

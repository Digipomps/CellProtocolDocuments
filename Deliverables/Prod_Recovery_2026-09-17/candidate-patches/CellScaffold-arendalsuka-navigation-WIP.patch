index 00000000..78a406cb
--- /dev/null
+++ b/Sources/App/Support/ArendalsukaLocalMatchTestSeedRunner.swift
@@ -0,0 +1,340 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright (c) 2026 Stiftelsen Digipomps and HAVEN contributors
+
+import Foundation
+@_spi(CellRuntimeRecovery) import CellBase
+import CellVapor
+import ScaffoldKit
+
+/// Local developer tool: writes real Arendalsuka matching-profile data
+/// (purpose, interests, matching consent, display-name override, stilling)
+/// for already-registered local test accounts, by driving the exact same
+/// `ArendalsukaProfileCell`/`ArendalsukaParticipantProfileCell` actions the
+/// real guided onboarding chat dialogue (`GuidedOnboardingCell`,
+/// scriptID "arendalsuka-participant-v1"/"arendalsuka-participant-profile-v1")
+/// would call - this is a substitute for walking through that chat flow by
+/// hand, not a different write path.
+///
+/// A test account is identified by its `FidoUser` row's own id and its
+/// already-minted `identity_id` (both readable straight out of `db.sqlite`
+/// after registering via the normal password-registration UI - see
+/// `fido_users.id` / `fido_users.identity_id`). Passing `identityId` directly
+/// lets this script skip Fluent/the database entirely: it mirrors
+/// `FidoUser.userIdentity()` (`BrowserClientIdentityVault(identityDomain:
+/// fidoUserID).identity(for: webUser)`) using a throwaway object, exactly the
+/// identity a live authenticated request for that account would resolve.
+///
+/// Local developer tool only: must run as a plain executable, never under
+/// XCTest (`CellScaffoldRuntimeStorageRoot.isRunningTests` guards this).
+/// Never touches Staging - operates purely on this worktree's local
+/// `~/CellsContainer` (or `CELL_SCAFFOLD_RUNTIME_ROOT` if set).
+public enum ArendalsukaLocalMatchTestSeedRunner {
+    public struct ParticipantSeed: Decodable {
+        public let fidoUserID: String
+        public let identityID: String
+        public let username: String
+        public let displayNameOverride: String?
+        public let stilling: String?
+        public let purpose: String?
+        public let interests: [String]?
+        public let matchingConsent: Bool?
+        // Separate gate from matchingConsent: ConferenceConnectionHubCell only
+        // includes a profile in participantDirectory (what
+        // ArendalsukaMatchingCell.recommendedParticipants reads) once its
+        // requesterUUID is in directoryVisibleRequesterUUIDs -
+        // ArendalsukaConnectionHubCell.requiresExplicitParticipantDirectoryVisibility
+        // is true, so ensureParticipantProfile's implicit auto-visibility
+        // branch never fires here; it needs the explicit
+        // ArendalsukaParticipantProgramCell.setMeetingVisibility(true) call
+        // below, same as the "Vis meg for andre..." toggle in the app.
+        public let meetingVisibility: Bool?
+    }
+
+    public struct ParticipantResult: Sendable {
+        public let username: String
+        public let identityUUID: String
+        public let appliedFields: [String]
+    }
+
+    public enum RunnerError: Error, CustomStringConvertible {
+        case runningUnderTests
+        case fileNotFound(String)
+        case invalidFormat(String)
+        case connectionHubOwnerNotFound(String)
+        case restoreFailed(String)
+        case persistFailed
+        case identityResolutionFailed(String)
+        case actionFailed(String, String)
+        case isolatedTestRuntimeRequired
+
+        public var description: String {
+            switch self {
+            case .isolatedTestRuntimeRequired:
+                return "Requires VAPOR_ENV=testing and an explicit CELL_SCAFFOLD_RUNTIME_ROOT with a .haven-synthetic-test-runtime marker containing haven-synthetic-test-runtime-v1."
+            case .runningUnderTests:
+                return "Refusing to seed real local storage from an XCTest process."
+            case .fileNotFound(let path):
+                return "Input file not found: \(path)"
+            case .invalidFormat(let path):
+                return "\(path) did not decode to the expected participant-seed JSON array shape."
+            case .connectionHubOwnerNotFound(let domain):
+                return "No existing owner identity found for identity domain '\(domain)' in VaporIdentityVault.shared. The live server has not bootstrapped ArendalsukaConnectionHubCell yet."
+            case .restoreFailed(let detail):
+                return "Could not restore the persisted ArendalsukaConnectionHubCell: \(detail)"
+            case .persistFailed:
+                return "Seeding succeeded in memory, but re-persisting the updated ArendalsukaConnectionHubCell snapshot failed."
+            case .identityResolutionFailed(let username):
+                return "Could not resolve a real Identity for test account '\(username)' - check its fidoUserID/identityID in db.sqlite."
+            case .actionFailed(let username, let detail):
+                return "Seeding action failed for '\(username)': \(detail)"
+            }
+        }
+    }
+
+    private final class SeedWebUser: BrowserClientIdentityUser {
+        var username: String
+        var identityId: String?
+        init(username: String, identityId: String) {
+            self.username = username
+            self.identityId = identityId
+        }
+    }
+
+    /// Restores the actual persisted `ArendalsukaConnectionHubCell` singleton
+    /// the live `Run` server holds (scaffoldUnique - one instance for the
+    /// whole app), then for each participant resolves their real per-identity
+    /// `ArendalsukaProfileCell`/`ArendalsukaParticipantProfileCell` proxies
+    /// (identityUnique - created fresh on first access for a brand-new test
+    /// account) and calls their real set* actions, exactly as the guided
+    /// onboarding chat dialogue would. Re-persists the hub afterward.
+    public static func runAgainstPersistedCell(
+        participantsPath: String,
+        connectionHubUUID: String,
+        connectionHubIdentityDomain: String = "Arendalsuka",
+        readOnly: Bool = false
+    ) async throws -> [ParticipantResult] {
+        try requireIsolatedTestRuntime(environment: ProcessInfo.processInfo.environment)
+        guard CellScaffoldRuntimeStorageRoot.isRunningTests == false else {
+            throw RunnerError.runningUnderTests
+        }
+        guard FileManager.default.fileExists(atPath: participantsPath) else {
+            throw RunnerError.fileNotFound(participantsPath)
+        }
+        let data = try Data(contentsOf: URL(fileURLWithPath: participantsPath))
+        let participants: [ParticipantSeed]
+        do {
+            participants = try JSONDecoder().decode([ParticipantSeed].self, from: data)
+        } catch {
+            throw RunnerError.invalidFormat(participantsPath)
+        }
+
+        CellBase.documentRootPath = CellScaffoldRuntimeStorageRoot.cellsDirectory().path
+
+        let resolver = CellResolver.sharedInstance
+        if resolver.tcUtility == nil {
+            resolver.tcUtility = TypedCellUtility(storage: LargeStackCellStorage())
+        }
+        if let existingUtility = resolver.tcUtility {
+            CellBase.typedCellUtility = existingUtility
+        }
+        CellBase.defaultCellResolver = resolver
+
+        let vault = await VaporIdentityVault.shared.initialize()
+        CellBase.defaultIdentityVault = vault
+
+        guard let hubOwner = await vault.identity(for: connectionHubIdentityDomain, makeNewIfNotFound: false) else {
+            throw RunnerError.connectionHubOwnerNotFound(connectionHubIdentityDomain)
+        }
+
+        try await resolver.addCellResolve(
+            name: ArendalsukaConnectionHubCell.cellName,
+            cellScope: .scaffoldUnique,
+            persistency: .persistant,
+            identityDomain: connectionHubIdentityDomain,
+            type: ArendalsukaConnectionHubCell.self
+        )
+        let hubRestoreResult = await resolver.restorePersistedNamedScaffoldCell(
+            uuid: connectionHubUUID,
+            named: ArendalsukaConnectionHubCell.cellName,
+            as: ArendalsukaConnectionHubCell.self,
+            requester: hubOwner,
+            authorization: CellResolverRecoveryAuthorization()
+        )
+        guard case let .restored(restoredEmit) = hubRestoreResult,
+              let hubCell = restoredEmit as? ArendalsukaConnectionHubCell else {
+            throw RunnerError.restoreFailed(String(describing: hubRestoreResult))
+        }
+        await hubCell.ensurePortholeRuntimeBindings(requester: hubOwner)
+
+        try await resolver.addCellResolve(
+            name: ArendalsukaProfileContract.cellName,
+            cellScope: .identityUnique,
+            persistency: .persistant,
+            type: ArendalsukaProfileCell.self
+        )
+        try await resolver.addCellResolve(
+            name: ArendalsukaParticipantProfileContract.cellName,
+            cellScope: .identityUnique,
+            persistency: .persistant,
+            type: ArendalsukaParticipantProfileCell.self
+        )
+        try await resolver.addCellResolve(
+            name: ArendalsukaParticipantProgramContract.cellName,
+            cellScope: .identityUnique,
+            persistency: .persistant,
+            type: ArendalsukaParticipantProgramCell.self
+        )
+
+        var results: [ParticipantResult] = []
+        for participant in participants {
+            let webUser = SeedWebUser(username: participant.username, identityId: participant.identityID)
+            let identityVault = BrowserClientIdentityVault(identityDomain: participant.fidoUserID)
+            let requester: Identity
+            do {
+                requester = try await identityVault.identity(for: webUser)
+            } catch {
+                throw RunnerError.identityResolutionFailed(participant.username)
+            }
+            guard requester.uuid == participant.identityID else {
+                throw RunnerError.identityResolutionFailed(participant.username)
+            }
+
+            if readOnly {
+                let hubState = try? await hubCell.get(keypath: "state", requester: requester)
+                print("--- \(participant.username) (\(requester.uuid)) hub state ---")
+                print(String(describing: hubState))
+                results.append(ParticipantResult(username: participant.username, identityUUID: requester.uuid, appliedFields: ["debug-read-only"]))
+                continue
+            }
+
+            var applied: [String] = []
+
+            guard let profileCell = try await resolver.cellAtEndpoint(
+                endpoint: ArendalsukaProfileContract.endpoint,
+                requester: requester
+            ) as? Meddle else {
+                throw RunnerError.identityResolutionFailed(participant.username)
+            }
+
+            if let purpose = participant.purpose {
+                try await set(
+                    profileCell,
+                    keypath: ArendalsukaProfileContract.setPurposeKeypath,
+                    value: .object(["purpose": .string(purpose)]),
+                    requester: requester,
+                    username: participant.username
+                )
+                applied.append("purpose")
+            }
+            if let interests = participant.interests {
+                try await set(
+                    profileCell,
+                    keypath: ArendalsukaProfileContract.setInterestsKeypath,
+                    value: .object(["interests": .list(interests.map(ValueType.string))]),
+                    requester: requester,
+                    username: participant.username
+                )
+                applied.append("interests")
+            }
+            if let matchingConsent = participant.matchingConsent {
+                try await set(
+                    profileCell,
+                    keypath: ArendalsukaProfileContract.setMatchingConsentKeypath,
+                    value: .object(["isGranted": .bool(matchingConsent)]),
+                    requester: requester,
+                    username: participant.username
+                )
+                applied.append("matchingConsent")
+            }
+
+            guard let participantProfileCell = try await resolver.cellAtEndpoint(
+                endpoint: ArendalsukaParticipantProfileContract.endpoint,
+                requester: requester
+            ) as? Meddle else {
+                throw RunnerError.identityResolutionFailed(participant.username)
+            }
+
+            if let displayNameOverride = participant.displayNameOverride {
+                try await set(
+                    participantProfileCell,
+                    keypath: ArendalsukaParticipantProfileContract.setDisplayNameOverrideKeypath,
+                    value: .object(["displayNameOverride": .string(displayNameOverride)]),
+                    requester: requester,
+                    username: participant.username
+                )
+                applied.append("displayNameOverride")
+            }
+            if let stilling = participant.stilling {
+                try await set(
+                    participantProfileCell,
+                    keypath: ArendalsukaParticipantProfileContract.setStillingKeypath,
+                    value: .object(["stilling": .string(stilling)]),
+                    requester: requester,
+                    username: participant.username
+                )
+                applied.append("stilling")
+            }
+
+            if let meetingVisibility = participant.meetingVisibility {
+                guard let participantProgramCell = try await resolver.cellAtEndpoint(
+                    endpoint: ArendalsukaParticipantProgramContract.endpoint,
+                    requester: requester
+                ) as? Meddle else {
+                    throw RunnerError.identityResolutionFailed(participant.username)
+                }
+                try await set(
+                    participantProgramCell,
+                    keypath: ArendalsukaParticipantProgramContract.setMeetingVisibilityKeypath,
+                    value: .bool(meetingVisibility),
+                    requester: requester,
+                    username: participant.username
+                )
+                applied.append("meetingVisibility")
+            }
+
+            results.append(ParticipantResult(username: participant.username, identityUUID: requester.uuid, appliedFields: applied))
+        }
+
+        let persisted = await resolver.persistCellSnapshot(hubCell)
+        guard persisted else {
+            throw RunnerError.persistFailed
+        }
+
+        return results
+    }
+
+    private static func set(
+        _ cell: Meddle,
+        keypath: String,
+        value: ValueType,
+        requester: Identity,
+        username: String
+    ) async throws {
+        let result = try await cell.set(keypath: keypath, value: value, requester: requester)
+        guard case let .object(state)? = result, case .bool(true)? = state["isAvailable"] else {
+            throw RunnerError.actionFailed(username, "\(keypath) did not acknowledge an available state")
+        }
+    }
+
+    /// Validate the explicit fixture boundary before opening any identity vault.
+    static func requireIsolatedTestRuntime(environment: [String: String]) throws {
+        guard environment["VAPOR_ENV"] == "testing",
+              let path = environment["CELL_SCAFFOLD_RUNTIME_ROOT"], path.hasPrefix("/"),
+              path.trimmingCharacters(in: .whitespacesAndNewlines) == path else {
+            throw RunnerError.isolatedTestRuntimeRequired
+        }
+        let root = URL(fileURLWithPath: path, isDirectory: true).resolvingSymlinksInPath().standardizedFileURL
+        let home = FileManager.default.homeDirectoryForCurrentUser.resolvingSymlinksInPath().standardizedFileURL
+        guard root.path != "/", root.path != home.path,
+              root.path != home.appendingPathComponent("CellsContainer").path else {
+            throw RunnerError.isolatedTestRuntimeRequired
+        }
+        let marker = root.appendingPathComponent(".haven-synthetic-test-runtime")
+        guard let metadata = try? marker.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey]),
+              metadata.isRegularFile == true, metadata.isSymbolicLink != true,
+              let contents = try? String(contentsOf: marker, encoding: .utf8),
+              contents == "haven-synthetic-test-runtime-v1\n" else {
+            throw RunnerError.isolatedTestRuntimeRequired
+        }
+    }
+}

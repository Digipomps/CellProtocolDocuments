+    /// read via the `taxonomySeed` keypath) over the bundled `Bundle.module`
+    /// fallback seed. The taxonomy is derived from session content and
+    /// regenerated whenever the program changes, so the bundled static
+    /// resource - which only updates on a full rebuild+redeploy - is a
+    /// fresh-environment fallback only, never the primary source once a
+    /// snapshot has been ingested.
+    private func resolvedTaxonomySeed(requester: Identity) async -> ArendalsukaInterestTaxonomySeed? {
+        if let atlas = await resolveCell(endpoint: ArendalsukaMatchingContract.eventAtlasEndpoint, requester: requester) {

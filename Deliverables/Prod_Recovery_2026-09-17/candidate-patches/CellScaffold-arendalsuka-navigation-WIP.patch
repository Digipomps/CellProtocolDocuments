diff --git a/Sources/ArendalsukaMatchTestSeed/main.swift b/Sources/ArendalsukaMatchTestSeed/main.swift
new file mode 100644
index 00000000..335e1a37
--- /dev/null
+++ b/Sources/ArendalsukaMatchTestSeed/main.swift
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright (c) 2026 Stiftelsen Digipomps and HAVEN contributors
+
+import Foundation
+import App
+
+private let usage = """
+Usage: ArendalsukaMatchTestSeed --participants PATH --connection-hub-uuid UUID [--identity-domain DOMAIN]
+
+Local developer tool: seeds real Arendalsuka matching-profile data (purpose,
+interests, matching consent, display-name override, stilling) for
+already-registered local test accounts, driving the same
+ArendalsukaProfileCell/ArendalsukaParticipantProfileCell actions the guided
+onboarding chat dialogue would call. Requires VAPOR_ENV=testing and an explicit
+CELL_SCAFFOLD_RUNTIME_ROOT containing a .haven-synthetic-test-runtime file whose
+contents are "haven-synthetic-test-runtime-v1" followed by a newline. Use only a
+dedicated synthetic fixture runtime with the local server stopped.
+
+--participants PATH must be a JSON array of objects shaped like:
+  {
+    "fidoUserID": "<fido_users.id>",
+    "identityID": "<fido_users.identity_id>",
+    "username": "<fido_users.username>",
+    "displayNameOverride": "Erik Hansen",
+    "stilling": "Bærekraftsrådgiver",
+    "purpose": "...",
+    "interests": ["...", "..."],
+    "matchingConsent": true
+  }
+Register each test account first via the normal password-registration UI,
+then read its id/identity_id straight out of db.sqlite:
+  sqlite3 db.sqlite "SELECT id, username, identity_id FROM fido_users;"
+
+--connection-hub-uuid UUID  The persisted ArendalsukaConnectionHubCell's UUID,
+                            from the live server's boot log "Named emitters"
+                            list: (ArendalsukaConnectionHub,<uuid>)
+--identity-domain NAME      Identity vault context for the hub's owner,
+                            default "Arendalsuka" (ArendalsukaConnectionHubCell
+                            .identityDomainName)
+"""
+
+private func sanitized(_ value: String?) -> String? {
+    guard let trimmed = value?.trimmingCharacters(in: .whitespacesAndNewlines),
+          trimmed.isEmpty == false else {
+        return nil
+    }
+    return trimmed
+}
+
+do {
+    var participantsPath: String?
+    var connectionHubUUID: String?
+    var identityDomain = "Arendalsuka"
+    var showHelp = false
+    var readOnly = false
+
+    let arguments = Array(CommandLine.arguments.dropFirst())
+    var index = 0
+    while index < arguments.count {
+        let argument = arguments[index]
+        switch argument {
+        case "-h", "--help":
+            showHelp = true
+        case "--debug-read-only":
+            readOnly = true
+        case "--participants":
+            index += 1
+            guard index < arguments.count else {
+                throw NSError(domain: "ArendalsukaMatchTestSeed", code: 1, userInfo: [NSLocalizedDescriptionKey: "Missing value for --participants"])
+            }
+            participantsPath = arguments[index]
+        case "--connection-hub-uuid":
+            index += 1
+            guard index < arguments.count else {
+                throw NSError(domain: "ArendalsukaMatchTestSeed", code: 1, userInfo: [NSLocalizedDescriptionKey: "Missing value for --connection-hub-uuid"])
+            }
+            connectionHubUUID = arguments[index]
+        case "--identity-domain":
+            index += 1
+            guard index < arguments.count else {
+                throw NSError(domain: "ArendalsukaMatchTestSeed", code: 1, userInfo: [NSLocalizedDescriptionKey: "Missing value for --identity-domain"])
+            }
+            identityDomain = arguments[index]
+        default:
+            throw NSError(domain: "ArendalsukaMatchTestSeed", code: 1, userInfo: [NSLocalizedDescriptionKey: "Unknown argument: \(argument)"])
+        }
+        index += 1
+    }
+
+    if showHelp {
+        print(usage)
+        exit(0)
+    }
+
+    guard let participantsPath = sanitized(participantsPath) else {
+        FileHandle.standardError.write(Data("Missing required --participants PATH\n\n".utf8))
+        FileHandle.standardError.write(Data(usage.utf8))
+        exit(64)
+    }
+    guard let connectionHubUUID = sanitized(connectionHubUUID) else {
+        FileHandle.standardError.write(Data("Missing required --connection-hub-uuid UUID\n\n".utf8))
+        FileHandle.standardError.write(Data(usage.utf8))
+        exit(64)
+    }
+
+    print("Restoring persisted ArendalsukaConnectionHub \(connectionHubUUID) (identity domain \(identityDomain)) and seeding from \(participantsPath)...")
+    let results = try await ArendalsukaLocalMatchTestSeedRunner.runAgainstPersistedCell(
+        participantsPath: participantsPath,
+        connectionHubUUID: connectionHubUUID,
+        connectionHubIdentityDomain: identityDomain,
+        readOnly: readOnly
+    )
+
+    for result in results {
+        print("  \(result.username) (\(result.identityUUID)): applied \(result.appliedFields.joined(separator: ", "))")
+    }
+    print("Done. \(results.count) participant(s) seeded.")
+    print("Restart the local `Run` server (swift run Run ...) so it picks up the updated cell state.")
+} catch {
+    FileHandle.standardError.write(Data("ArendalsukaMatchTestSeed error: \(String(reflecting: error))\n".utf8))
+    exit(64)
+}

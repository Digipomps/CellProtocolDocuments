+            _ = try await cell.set(keypath: "atlas.ingestTaxonomy", value: update, requester: owner)
+            let restored = try JSONDecoder().decode(ArendalsukaEventAtlasCell.self, from: oldSnapshot)
+            await restored.ensurePortholeRuntimeBindings(requester: owner)
+            let replayed = try await restored.get(keypath: "taxonomySeed", requester: owner)
+            let rows = listObjects(asObject(replayed)?["subcategories"])
+            XCTAssertEqual(rows.count, 1)
+            XCTAssertEqual(asInt(rows.first?["sessionCount"]), 2, "The acknowledged journal update must survive restoring an older snapshot")
+
+            var corrupt = try XCTUnwrap(JSONSerialization.jsonObject(with: oldSnapshot) as? [String: Any])
+            corrupt["taxonomySubcategoriesByID"] = "invalid-new-field"
+            XCTAssertThrowsError(try JSONDecoder().decode(ArendalsukaEventAtlasCell.self, from: JSONSerialization.data(withJSONObject: corrupt)))
+            let journalBefore = try Data(contentsOf: URL(fileURLWithPath: journalPath))
+            for invalid: Object in [
+                ["subcategories": .string("not-a-list")],
+                ["subcategories": .list([.object(["name": .string("missing-id")])])],
+                ["sessionStatus": .list([.object(["session_id": .string("synthetic-session"), "subcategory_count": .integer(-1)])])]
+            ] {
+                let payload = try await importAccessPayload(invalid, actionKeypath: "atlas.ingestTaxonomy", issuer: owner)
+                let rejected = try await cell.set(keypath: "atlas.ingestTaxonomy", value: payload, requester: owner)
+                XCTAssertTrue(asString(rejected)?.hasPrefix("error:") == true)
+                XCTAssertEqual(try Data(contentsOf: URL(fileURLWithPath: journalPath)), journalBefore)
+            }
+        }
+    }

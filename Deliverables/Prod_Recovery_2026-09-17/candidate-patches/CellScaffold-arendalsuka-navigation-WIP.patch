+            totalEventSeries = eventSeriesByID.count
+            totalSessionSubcategoryLinks = sessionSubcategoryLinksByID.count
+            totalSessionEventSeriesLinks = sessionEventSeriesLinksByID.count
+            totalSessionStatus = taxonomySessionStatusByID.count

+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright (c) 2026 Stiftelsen Digipomps and HAVEN contributors
+
+@testable import App
+import XCTest
+@_spi(Testing) import CellBase
+import CellVapor
+
+final class ArendalsukaParticipantConversationTests: IsolatedCellTestCase {
+    func testConfirmedMeetingConversationIsSharedAcrossBothParticipantsEvenWithSeparateVaults() async throws {
+        let previousDebugAccess = CellBase.debugValidateAccessForEverything
+        let previousResolver = CellBase.defaultCellResolver
+        let previousVault = CellBase.defaultIdentityVault
+        let previousTypedCellUtility = CellBase.typedCellUtility
+        CellBase.debugValidateAccessForEverything = false
+        defer {
+            CellBase.debugValidateAccessForEverything = previousDebugAccess
+            CellBase.defaultCellResolver = previousResolver
+            CellBase.defaultIdentityVault = previousVault
+            CellBase.typedCellUtility = previousTypedCellUtility
+        }
+
+        let resolver = CellResolver.sharedInstance
+        CellBase.defaultCellResolver = resolver
+        let typedCellUtility = TypedCellUtility(storage: LargeStackCellStorage())
+        resolver.tcUtility = typedCellUtility
+        CellBase.typedCellUtility = typedCellUtility
+
+        // Mirror production: each participant's browser session owns its OWN
+        // identity vault instance, not a shared one. If conversationRequester's
+        // domain->identity derivation is not actually deterministic across
+        // separate vault instances, the two participants will silently resolve
+        // to two different ChatCell instances.
+        let aliceVault = BrowserClientIdentityVault(identityDomain: "arendalsuka-chat-alice-\(UUID().uuidString)")
+        let bobVault = BrowserClientIdentityVault(identityDomain: "arendalsuka-chat-bob-\(UUID().uuidString)")
+        CellBase.defaultIdentityVault = aliceVault
+
+        try await registerResolveIfNeeded(
+            resolver,
+            name: "EntityAnchor",
+            type: EntityAnchorCell.self,
+            cellScope: .identityUnique,
+            persistency: .ephemeral,
+            identityDomain: "private"
+        )
+        try await registerResolveIfNeeded(
+            resolver,
+            name: "Chat",
+            type: ChatCell.self,
+            cellScope: .identityUnique,
+            persistency: .persistant
+        )
+        try await registerResolveIfNeeded(
+            resolver,
+            name: ArendalsukaConnectionHubCell.cellName,
+            type: ArendalsukaConnectionHubCell.self,
+            cellScope: .scaffoldUnique,
+            persistency: .persistant,
+            identityDomain: ArendalsukaConnectionHubCell.identityDomainName
+        )
+
+        guard let alice = await aliceVault.identity(for: "arendalsuka-conversation-alice-\(UUID().uuidString)", makeNewIfNotFound: true),
+              let bob = await bobVault.identity(for: "arendalsuka-conversation-bob-\(UUID().uuidString)", makeNewIfNotFound: true) else {
+            return XCTFail("Expected signable participant identities from two separate vaults")
+        }
+        alice.displayName = "Ada Nord"
+        bob.displayName = "Bjørn Sør"
+
+        guard let hub = try await resolver.cellAtEndpoint(
+            endpoint: ArendalsukaParticipantProgramContract.meetingHubEndpoint,
+            requester: alice
+        ) as? Meddle else {
+            return XCTFail("Expected to resolve the shared Arendalsuka connection hub")
+        }
+
+        _ = try await hub.set(keypath: "setParticipantDirectoryVisibility", value: .bool(true), requester: alice)
+        _ = try await hub.set(keypath: "setParticipantDirectoryVisibility", value: .bool(true), requester: bob)
+
+        _ = try await hub.set(
+            keypath: "createMeetingRequest",
+            value: .object([
+                "counterpartRequesterUUID": .string(bob.uuid),
+                "counterpartDisplayName": .string(bob.displayName),
+                "purposeRef": .string(ArendalsukaParticipantProgramContract.meetingPurposeRef),
+                "message": .string("Skal vi møtes etter debatten?")
+            ]),
+            requester: alice
+        )
+
+        let aliceOutgoingState = try await hub.get(keypath: "state", requester: alice)
+        guard case let .object(aliceOutgoingObject) = aliceOutgoingState,
+              let persistedRequestID = firstListObjectValue(in: aliceOutgoingObject, keypath: "requests", field: "id") else {
+            return XCTFail("Expected a persisted outgoing meeting request id")
+        }
+
+        _ = try await hub.set(
+            keypath: "respondMeetingRequest",
+            value: .object([
+                "requestId": .string(persistedRequestID),
+                "status": .string("accepted"),
+                "actorRequesterUUID": .string(alice.uuid)
+            ]),
+            requester: bob
+        )
+
+        let aliceHubState = try await hub.get(keypath: "state", requester: alice)
+        let bobHubState = try await hub.get(keypath: "state", requester: bob)
+        guard case let .object(aliceHubObject) = aliceHubState,
+              case let .object(bobHubObject) = bobHubState,
+              let meetingId = firstListObjectValue(in: aliceHubObject, keypath: "confirmedMeetings", field: "id"),
+              let bobMeetingId = firstListObjectValue(in: bobHubObject, keypath: "confirmedMeetings", field: "id") else {
+            return XCTFail("Expected both participants to see one confirmed meeting")
+        }
+        XCTAssertEqual(meetingId, bobMeetingId)
+
+        let aliceCell = await ArendalsukaParticipantProgramCell(owner: alice)
+        let bobCell = await ArendalsukaParticipantProgramCell(owner: bob)
+
+        let aliceAfterSelect = try await aliceCell.set(
+            keypath: ArendalsukaParticipantProgramContract.selectConversationKeypath,
+            value: .string(meetingId),
+            requester: alice
+        )
+        guard case let .object(aliceAfterSelectObject) = aliceAfterSelect,
+              let aliceConversation = Self.object(aliceAfterSelectObject["conversation"]) else {
+            return XCTFail("Expected Alice's state to include an open conversation after selection")
+        }
+        XCTAssertEqual(Self.bool(aliceConversation["isOpen"]), true)
+        XCTAssertEqual(Self.bool(aliceConversation["isAvailable"]), true, "Alice's conversation should resolve to an available ChatCell backend")
+
+        _ = try await aliceCell.set(
+            keypath: ArendalsukaParticipantProgramContract.setConversationDraftKeypath,
+            value: .string("Hei fra Alice!"),
+            requester: alice
+        )
+        _ = try await aliceCell.set(
+            keypath: ArendalsukaParticipantProgramContract.sendConversationMessageKeypath,
+            value: .object([:]),
+            requester: alice
+        )
+
+        let bobAfterSelect = try await bobCell.set(
+            keypath: ArendalsukaParticipantProgramContract.selectConversationKeypath,
+            value: .string(meetingId),
+            requester: bob
+        )
+        guard case let .object(bobAfterSelectObject) = bobAfterSelect,
+              let bobConversation = Self.object(bobAfterSelectObject["conversation"]) else {
+            return XCTFail("Expected Bob's state to include an open conversation after selection")
+        }
+        XCTAssertEqual(Self.bool(bobConversation["isOpen"]), true)
+        XCTAssertEqual(Self.bool(bobConversation["isAvailable"]), true, "Bob's conversation should resolve to an available ChatCell backend")
+
+        let bobMessages = Self.list(bobConversation["messages"]).compactMap(Self.object)
+        XCTAssertEqual(
+            bobMessages.count,
+            1,
+            "Bob should see Alice's message in the shared per-pair conversation, not an empty thread"
+        )
+        XCTAssertEqual(bobMessages.first.flatMap { Self.string($0["text"]) }, "Hei fra Alice!")
+        XCTAssertEqual(bobMessages.first.flatMap { Self.bool($0["isMine"]) }, false)
+
+        // And Alice, re-reading her own state, should see her own message too.
+        let aliceState = try await aliceCell.get(keypath: "state", requester: alice)
+        guard case let .object(aliceStateObject) = aliceState,
+              let aliceConversationAfterSend = Self.object(aliceStateObject["conversation"]) else {
+            return XCTFail("Expected Alice's refreshed state to include the conversation")
+        }
+        let aliceMessages = Self.list(aliceConversationAfterSend["messages"]).compactMap(Self.object)
+        XCTAssertEqual(aliceMessages.count, 1)
+        XCTAssertEqual(aliceMessages.first.flatMap { Self.bool($0["isMine"]) }, true)
+    }
+
+    private static func object(_ value: ValueType?) -> Object? {
+        guard case let .object(object)? = value else { return nil }
+        return object
+    }
+
+    private static func list(_ value: ValueType?) -> [ValueType] {
+        guard case let .list(list)? = value else { return [] }
+        return list
+    }
+
+    private static func string(_ value: ValueType?) -> String? {
+        guard case let .string(string)? = value else { return nil }
+        return string
+    }
+
+    private static func bool(_ value: ValueType?) -> Bool? {
+        guard case let .bool(bool)? = value else { return nil }
+        return bool
+    }
+
+    private func registerResolveIfNeeded(
+        _ resolver: CellResolver,
+        name: String,
+        type: GeneralCell.Type,
+        cellScope: CellUsageScope = .identityUnique,
+        persistency: Persistancy = .ephemeral,
+        identityDomain: String = "scaffold"
+    ) async throws {
+        do {
+            try await resolver.addCellResolve(
+                name: name,
+                cellScope: cellScope,
+                persistency: persistency,
+                identityDomain: identityDomain,
+                type: type
+            )
+        } catch {
+            guard String(describing: error) == "duplicatedEndpointName" else {
+                throw error
+            }
+        }
+    }
+
+    private func firstListObjectValue(in object: Object, keypath: String, field: String) -> String? {
+        guard let value = valueAt(in: object, keypath: keypath),
+              case let .list(list) = value,
+              case let .object(first)? = list.first,
+              case let .string(string)? = first[field] else {
+            return nil
+        }
+        return string
+    }
+
+    private func valueAt(in object: Object, keypath: String) -> ValueType? {
+        let parts = keypath.split(separator: ".").map(String.init)
+        var current: ValueType = .object(object)
+        for part in parts {
+            guard case let .object(currentObject) = current,
+                  let next = currentObject[part] else {
+                return nil
+            }
+            current = next
+        }
+        return current
+    }
+}

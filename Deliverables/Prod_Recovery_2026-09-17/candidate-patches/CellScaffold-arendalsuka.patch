+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright (c) 2026 Stiftelsen Digipomps and HAVEN contributors
+
+import Foundation
+import CellBase
+
+/// "Min profil": the participant's own, participant-controlled Arendalsuka
+/// profile - name override, stilling, photo, favorites sharing, and position
+/// sharing. Distinct from medvirkerprofil (organizer-generated, read-only
+/// speaker bio) and from ArendalsukaMatching's "For Deg" surface (which only
+/// *reads* interests/purpose this profile's sibling cell, ArendalsukaProfileCell,
+/// captures).
+///
+/// Live GPS sharing is exposed on the backend contract
+/// (`profile.setPositionSharing` with `mode: "live"`) but has no button here:
+/// continuously reading the device's coordinates and posting them
+/// periodically needs bespoke client-side JavaScript (the browser Geolocation
+/// API), which is renderer work beyond what a CellConfiguration/skeleton can
+/// express - same category of gap as `FileUpload`'s bespoke upload handling
+/// in skeleton-runtime.js. That wiring is a deliberate follow-up, not done
+/// here.
+enum ArendalsukaParticipantProfileConfigurationFactory {
+    static func makeCellConfiguration() -> CellConfiguration {
+        var configuration = CellConfiguration(name: "Arendalsuka Min Profil")
+        configuration.description = "Deltakerens egen, deltakerstyrte Arendalsuka-profil: navn, stilling, bilde, delte favoritter og posisjonsdeling."
+        configuration.discovery = CellConfigurationDiscovery(
+            sourceCellEndpoint: ArendalsukaParticipantProfileContract.endpoint,
+            sourceCellName: "ArendalsukaParticipantProfileCell",
+            purpose: "Arendalsuka deltakerprofil",
+            purposeDescription: "La en deltaker style navn, stilling, profilbilde, delte favoritter og posisjonsdeling for seg selv.",
+            interests: [
+                "arendalsuka",
+                "profil",
+                "deltaker",
+                "posisjon",
+                "favoritter",
+                "purposeRef=arendalsuka.social-networking.meet"
+            ],
+            menuSlots: ["lowerMid"]
+        )
+        var profileReference = CellReference(endpoint: ArendalsukaParticipantProfileContract.endpoint, label: "arendalsukaParticipantProfile")
+        profileReference.setKeysAndValues = [KeyValue(key: ArendalsukaParticipantProfileContract.stateKeypath, value: nil)]
+        configuration.addReference(profileReference)
+        var programReference = CellReference(endpoint: ArendalsukaParticipantProgramContract.endpoint, label: "arendalsukaParticipant")
+        programReference.setKeysAndValues = [KeyValue(key: ArendalsukaParticipantProgramContract.stateKeypath, value: nil)]
+        configuration.addReference(programReference)
+        configuration.skeleton = .VStack(makeSkeleton())
+        return configuration
+    }
+
+    private static func makeSkeleton() -> SkeletonVStack {
+        SkeletonVStack(elements: [
+            styledSection("Min profil", background: "#f4f4ef", border: "#c1c9bf", content: [
+                styledLabel("Navnet og stillingen din vises til andre deltakere først når du skrur på matching-samtykke i formål/interesser-innstillingene.", fontSize: 12, weight: "regular", color: "#64748B"),
+                fieldLabel("Navn (valgfritt, overstyrer kontonavnet ditt her)"),
+                labeledTextField(
+                    sourceKeypath: "arendalsukaParticipantProfile.state.displayNameOverride",
+                    targetKeypath: "arendalsukaParticipantProfile.\(ArendalsukaParticipantProfileContract.setDisplayNameOverrideKeypath)",
+                    placeholder: "F.eks. Cissi"
+                ),
+                fieldLabel("Stilling"),
+                labeledTextField(
+                    sourceKeypath: "arendalsukaParticipantProfile.state.stilling",
+                    targetKeypath: "arendalsukaParticipantProfile.\(ArendalsukaParticipantProfileContract.setStillingKeypath)",
+                    placeholder: "F.eks. Rådgiver, digital politikk"
+                )
+            ]),
+            styledSection("Profilbilde", background: "#f4f4ef", border: "#c1c9bf", content: [
+                // No live preview: SkeletonImage only supports a static url/name,
+                // not a runtime keypath binding, so an uploaded data URI can't be
+                // rendered back here with today's skeleton format.
+                fileUpload(),
+                styledKeyText("arendalsukaParticipantProfile.state.photoStatus", fontSize: 13, weight: "regular", color: "#316342"),
+                contextButton("arendalsukaParticipantProfile.\(ArendalsukaParticipantProfileContract.setPhotoKeypath)", label: "Fjern profilbilde", payload: .string(""))
+            ]),
+            styledSection("Del favoritter", background: "#f4f4ef", border: "#c1c9bf", content: [
+                styledLabel("Vis programmet du har lagret i din agenda på profilen din for deltakere du deler matching med.", fontSize: 12, weight: "regular", color: "#64748B"),
+                .Toggle(favoritesToggle())
+            ]),
+            styledSection("Del posisjon", background: "#f4f4ef", border: "#c1c9bf", content: [
+                styledLabel("Velg én måte å dele hvor du er på - eller la det stå av.", fontSize: 12, weight: "regular", color: "#64748B"),
+                styledKeyText("arendalsukaParticipantProfile.state.positionSharing.mode", fontSize: 13, weight: "semibold", color: "#316342"),
+                contextButton(
+                    "arendalsukaParticipantProfile.\(ArendalsukaParticipantProfileContract.setPositionSharingKeypath)",
+                    label: "Av",
+                    payload: .object(["mode": .string("off")])
+                ),
+                fieldLabel("Skriv inn hvor du er"),
+                labeledTextField(
+                    sourceKeypath: "arendalsukaParticipantProfile.state.positionSharing.manualLabel",
+                    targetKeypath: "arendalsukaParticipantProfile.\(ArendalsukaParticipantProfileContract.setManualPositionLabelKeypath)",
+                    placeholder: "F.eks. Ved Torvscenen"
+                ),
+                fieldLabel("Sjekk inn et sted fra programkartet"),
+                .Picker(checkinPicker())
+            ])
+        ], spacing: 16)
+    }
+
+    // MARK: - Field builders
+
+    private static func labeledTextField(sourceKeypath: String, targetKeypath: String, placeholder: String) -> SkeletonElement {
+        var field = SkeletonTextField(
+            sourceKeypath: sourceKeypath,
+            targetKeypath: targetKeypath,
+            placeholder: placeholder
+        )
+        field.modifiers = compactControlModifiers()
+        return .TextField(field)
+    }
+
+    private static func fieldLabel(_ text: String) -> SkeletonElement {
+        styledLabel(text, fontSize: 12, weight: "semibold", color: "#1a1c19")
+    }
+
+    private static func fileUpload() -> SkeletonElement {
+        var upload = SkeletonFileUpload(
+            title: "Last opp profilbilde",
+            helperText: "PNG, JPEG eller WebP, maks 320 KB.",
+            actionKeypath: "arendalsukaParticipantProfile.\(ArendalsukaParticipantProfileContract.setPhotoKeypath)",
+            acceptedContentTypes: ["image/png", "image/jpeg", "image/webp"],
+            allowsMultiple: false,
+            supportsDrop: true,
+            maxSizeBytes: 320 * 1_024,
+            uploadMode: "base64",
+            submitOnSelection: true
+        )
+        upload.modifiers = compactControlModifiers()
+        return .FileUpload(upload)
+    }
+
+    private static func favoritesToggle() -> SkeletonToggle {
+        SkeletonToggle(
+            label: "Del mine lagrede arrangementer",
+            keypath: "arendalsukaParticipantProfile.\(ArendalsukaParticipantProfileContract.setFavoritesSharingKeypath)"
+        )
+    }
+
+    private static func checkinPicker() -> SkeletonPicker {
+        var picker = SkeletonPicker(
+            placeholder: "Velg et sted",
+            keypath: "arendalsukaParticipant.state.mapRows",
+            optionLabelKeypath: "title",
+            selectionActionKeypath: "arendalsukaParticipantProfile.\(ArendalsukaParticipantProfileContract.setCheckedInVenueKeypath)",
+            selectionPayloadMode: .item,
+            allowsEmptySelection: true
+        )
+        picker.modifiers = compactControlModifiers()
+        return picker
+    }
+
+    // MARK: - Shared styling (mirrors ArendalsukaEventAtlasConfigurationFactory's Summer Solstice palette)
+
+    private static func styledSection(
+        _ title: String,
+        background: String,
+        border: String,
+        content: SkeletonElementList
+    ) -> SkeletonElement {
+        var header = SkeletonText(text: title)
+        header.modifiers = headingModifiers()
+        var section = SkeletonSection(header: .Text(header), content: content)
+        section.modifiers = containerModifiers(background: background, border: border)
+        return .Section(section)
+    }
+
+    private static func styledKeyText(_ keypath: String, fontSize: Double, weight: String, color: String) -> SkeletonElement {
+        var modifiers = SkeletonModifiers()
+        modifiers.fontSize = fontSize
+        modifiers.fontWeight = weight
+        modifiers.foregroundColor = color
+        var text = SkeletonText(keypath: keypath)
+        text.modifiers = modifiers
+        return .Text(text)
+    }
+
+    private static func styledLabel(_ literalText: String, fontSize: Double, weight: String, color: String) -> SkeletonElement {
+        var modifiers = SkeletonModifiers()
+        modifiers.fontSize = fontSize
+        modifiers.fontWeight = weight
+        modifiers.foregroundColor = color
+        var text = SkeletonText(text: literalText)
+        text.modifiers = modifiers
+        return .Text(text)
+    }
+
+    private static func headingModifiers() -> SkeletonModifiers {
+        var modifiers = SkeletonModifiers()
+        modifiers.fontSize = 18
+        modifiers.fontWeight = "bold"
+        modifiers.foregroundColor = "#1a1c19"
+        return modifiers
+    }
+
+    private static func compactControlModifiers() -> SkeletonModifiers {
+        var modifiers = SkeletonModifiers()
+        modifiers.foregroundColor = "#1a1c19"
+        modifiers.background = "#ffffff"

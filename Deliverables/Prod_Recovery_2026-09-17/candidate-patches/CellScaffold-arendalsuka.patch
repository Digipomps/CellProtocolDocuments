+    static let endpoint = "cell:///ArendalsukaParticipantProfile"
+
+    static let stateKeypath = "state"
+    static let skeletonConfigurationKeypath = "skeletonConfiguration"
+    static let setDisplayNameOverrideKeypath = "profile.setDisplayNameOverride"
+    static let setStillingKeypath = "profile.setStilling"
+    static let setPhotoKeypath = "profile.setPhoto"
+    /// Named to match its own state-read field (`state.favoritesSharingEnabled`),
+    /// not a `profile.` action-style name: SkeletonToggle uses one `keypath`
+    /// for both dispatching the write and (via resolveKeypath against the
+    /// referenced state) reflecting the live isOn value back into the
+    /// checkbox, so the two must be the same path - see
+    /// ArendalsukaParticipantProgramCell.setMeetingVisibilityKeypath for the
+    /// established precedent of this convention.
+    static let setFavoritesSharingKeypath = "state.favoritesSharingEnabled"
+    static let setPositionSharingKeypath = "profile.setPositionSharing"
+    /// Single-value convenience wrappers around setPositionSharing, shaped for
+    /// a plain TextField/Picker submission (one field, one write) rather than
+    /// the multi-field composite payload setPositionSharing itself expects -
+    /// the skeleton form can't compose several live field values into one
+    /// action payload at submit time.
+    static let setManualPositionLabelKeypath = "profile.setManualPositionLabel"
+    static let setCheckedInVenueKeypath = "profile.setCheckedInVenue"
+}
+
+/// Owns the write-path for a participant's *self-controlled* Arendalsuka
+/// profile - name override, stilling, photo, favorites sharing, and position
+/// sharing. Distinct from `ArendalsukaProfileCell` (interests/purpose/matching
+/// consent) and from medvirkerprofil (an organizer-generated, read-only
+/// speaker bio card reached by tapping a name on a session) - this is the
+/// participant's own, participant-controlled surface. Holds no persisted
+/// state of its own: a thin, per-identity proxy in front of
+/// `ArendalsukaConnectionHubCell`, the same pattern `ArendalsukaProfileCell`
+/// already uses.
+///
+/// `isVerified` is deliberately not writable here. It is reserved for a
+/// future BankID/Vipps-backed identity verification flow (not yet scoped)
+/// and always reads as `false` in the meantime - never a stand-in claim of
+/// verification.
+final class ArendalsukaParticipantProfileCell: GeneralCell, PortholeRuntimeBindingEnsuring {
+    static let cellName = ArendalsukaParticipantProfileContract.cellName
+
+    required init(owner: Identity) async {
+        await super.init(owner: owner)
+        self.identityDomain = "ArendalsukaParticipant"
+        try? await ensureRuntimeReady()
+    }
+
+    required init(from decoder: Decoder) throws {
+        try super.init(from: decoder)
+    }
+
+    override func installCellRuntimeBindingsForAccess() async throws {
+        await setupPermissions(owner: storedOwnerIdentity)
+        await setupRuntime(owner: storedOwnerIdentity)
+    }
+
+    func ensurePortholeRuntimeBindings(requester: Identity) async {
+        try? await ensureRuntimeReady()
+    }
+
+    private func setupPermissions(owner: Identity) async {
+        agreementTemplate.addGrant("r---", for: ArendalsukaParticipantProfileContract.stateKeypath)
+        agreementTemplate.addGrant("r---", for: ArendalsukaParticipantProfileContract.skeletonConfigurationKeypath)
+        [
+            ArendalsukaParticipantProfileContract.setDisplayNameOverrideKeypath,
+            ArendalsukaParticipantProfileContract.setStillingKeypath,
+            ArendalsukaParticipantProfileContract.setPhotoKeypath,
+            ArendalsukaParticipantProfileContract.setFavoritesSharingKeypath,
+            ArendalsukaParticipantProfileContract.setPositionSharingKeypath,
+            ArendalsukaParticipantProfileContract.setManualPositionLabelKeypath,
+            ArendalsukaParticipantProfileContract.setCheckedInVenueKeypath
+        ].forEach {
+            agreementTemplate.addGrant("rw--", for: $0)
+        }
+    }
+
+    // This proxy returns the updated projection. Observable changes are emitted
+    // by the shared hub on its existing conference-connections flow; the proxy
+    // does not advertise separate events it never emits.
+    private func setupRuntime(owner: Identity) async {
+        await registerGet(
+            key: ArendalsukaParticipantProfileContract.stateKeypath,
+            owner: owner,
+            returns: Self.stateSchema,
+            permissions: ["r---"],
+            description: .string("Read this participant's self-controlled Arendalsuka profile: name override, stilling, photo, favorites sharing and position sharing.")
+        ) { [weak self] requester in
+            guard let self else { return .null }
+            guard await self.validateAccess("r---", at: ArendalsukaParticipantProfileContract.stateKeypath, for: requester) else { return .string("denied") }
+            return await self.stateValue(requester: requester)
+        }
+
+        await registerGet(
+            key: ArendalsukaParticipantProfileContract.skeletonConfigurationKeypath,
+            owner: owner,
+            returns: ExploreContract.schema(type: "cellConfiguration"),
+            permissions: ["r---"],
+            description: .string("Read the Arendalsuka Min Profil CellConfiguration.")
+        ) { requester in
+            guard await self.validateAccess("r---", at: ArendalsukaParticipantProfileContract.skeletonConfigurationKeypath, for: requester) else { return .string("denied") }
+            return .cellConfiguration(ArendalsukaParticipantProfileConfigurationFactory.makeCellConfiguration())
+        }
+
+        await registerSet(
+            key: ArendalsukaParticipantProfileContract.setDisplayNameOverrideKeypath,
+            owner: owner,
+            input: Self.scalarOrFieldSchema("displayNameOverride", type: "string", description: "Overrides the display name shown to other participants. An empty string falls back to the account's own display name."),
+            returns: Self.actionResultSchema,
+            permissions: ["rw--"],
+            description: .string("Set a display-name override for this conference, without changing the account's own display name.")
+        ) { [weak self] requester, payload in
+            guard let self else { return .null }
+            guard await self.validateAccess("rw--", at: ArendalsukaParticipantProfileContract.setDisplayNameOverrideKeypath, for: requester) else { return .string("denied") }
+            return await self.setDisplayNameOverride(value: payload, requester: requester)
+        }
+
+        await registerSet(
+            key: ArendalsukaParticipantProfileContract.setStillingKeypath,
+            owner: owner,
+            input: Self.scalarOrFieldSchema("stilling", type: "string", description: "Replaces this participant's stilling (job title / role description)."),
+            returns: Self.actionResultSchema,
+            permissions: ["rw--"],
+            description: .string("Set this participant's stilling.")
+        ) { [weak self] requester, payload in
+            guard let self else { return .null }
+            guard await self.validateAccess("rw--", at: ArendalsukaParticipantProfileContract.setStillingKeypath, for: requester) else { return .string("denied") }
+            return await self.setStilling(value: payload, requester: requester)
+        }
+
+        await registerSet(
+            key: ArendalsukaParticipantProfileContract.setPhotoKeypath,
+            owner: owner,
+            input: ExploreContract.oneOfSchema(options: [
+                Self.scalarOrFieldSchema("photoDataURI", type: "string", description: "A small data:image/...;base64,... photo; an empty string clears it."),
+                ExploreContract.objectSchema(
+                    properties: ["mimeType": ExploreContract.schema(type: "string"), "dataBase64": ExploreContract.schema(type: "string")],
+                    requiredKeys: ["mimeType", "dataBase64"],
+                    description: "Native FileUpload payload."
+                ),
+                ExploreContract.objectSchema(
+                    properties: [
+                        "kind": ExploreContract.schema(type: "string"),
+                        "fieldID": ExploreContract.schema(type: "string"),
+                        "temporaryPayload": ExploreContract.objectSchema(properties: [
+                            "mimeType": ExploreContract.schema(type: "string"),
+                            "dataBase64": ExploreContract.schema(type: "string")
+                        ], requiredKeys: ["mimeType", "dataBase64"])
+                    ], requiredKeys: ["kind", "fieldID"],
+                    description: "Web FileUpload envelope; opening the picker without a temporary payload does not mutate the photo."
+                )
+            ]),
+            returns: Self.actionResultSchema,
+            permissions: ["rw--"],
+            description: .string("Set or clear this participant's profile photo.")
+        ) { [weak self] requester, payload in
+            guard let self else { return .null }
+            guard await self.validateAccess("rw--", at: ArendalsukaParticipantProfileContract.setPhotoKeypath, for: requester) else { return .string("denied") }
+            return await self.setPhoto(value: payload, requester: requester)
+        }
+
+        await registerSet(
+            key: ArendalsukaParticipantProfileContract.setFavoritesSharingKeypath,
+            owner: owner,
+            input: Self.scalarOrFieldSchema("isEnabled", type: "boolean", description: "Enables or disables sharing this participant's saved/favorited sessions on their profile."),
+            returns: Self.actionResultSchema,
+            permissions: ["rw--"],
+            description: .string("Enable or disable favorites sharing. When enabling, snapshots the participant's currently saved sessions from ArendalsukaParticipantProgramCell.")
+        ) { [weak self] requester, payload in
+            guard let self else { return .null }
+            guard await self.validateAccess("rw--", at: ArendalsukaParticipantProfileContract.setFavoritesSharingKeypath, for: requester) else { return .string("denied") }
+            return await self.setFavoritesSharing(value: payload, requester: requester)
+        }
+
+        await registerSet(
+            key: ArendalsukaParticipantProfileContract.setPositionSharingKeypath,
+            owner: owner,
+            input: ExploreContract.objectSchema(
+                properties: [
+                    "mode": ExploreContract.schema(type: "string"),
+                    "manualLabel": ExploreContract.schema(type: "string"),
+                    "checkedInVenueFeatureID": ExploreContract.schema(type: "string"),
+                    "checkedInVenueLabel": ExploreContract.schema(type: "string"),
+                    "latitude": Self.coordinateSchema,
+                    "longitude": Self.coordinateSchema
+                ],
+                requiredKeys: ["mode"],
+                description: "Sets the participant's position-sharing mode: off, live (device coordinates, reported periodically by the client), manual (a free-text label the participant wrote), or checkin (a venue featureID from the program map)."
+            ),
+            returns: Self.actionResultSchema,
+            permissions: ["rw--"],
+            description: .string("Set this participant's position-sharing mode and its mode-specific data.")
+        ) { [weak self] requester, payload in
+            guard let self else { return .null }
+            guard await self.validateAccess("rw--", at: ArendalsukaParticipantProfileContract.setPositionSharingKeypath, for: requester) else { return .string("denied") }
+            return await self.setPositionSharing(value: payload, requester: requester)
+        }
+
+        await registerSet(
+            key: ArendalsukaParticipantProfileContract.setManualPositionLabelKeypath,
+            owner: owner,
+            input: ExploreContract.schema(type: "string"),
+            returns: Self.actionResultSchema,
+            permissions: ["rw--"],
+            description: .string("Single-field convenience for setting position sharing to manual mode with this label - a thin wrapper over profile.setPositionSharing for plain form fields.")
+        ) { [weak self] requester, payload in
+            guard let self else { return .null }
+            guard await self.validateAccess("rw--", at: ArendalsukaParticipantProfileContract.setManualPositionLabelKeypath, for: requester) else { return .string("denied") }
+            return await self.setPositionSharing(
+                value: .object(["mode": .string("manual"), "manualLabel": payload ?? .string("")]),
+                requester: requester
+            )
+        }
+
+        await registerSet(
+            key: ArendalsukaParticipantProfileContract.setCheckedInVenueKeypath,
+            owner: owner,
+            input: ExploreContract.objectSchema(
+                properties: [
+                    "featureID": ExploreContract.schema(type: "string"),
+                    "label": ExploreContract.schema(type: "string")
+                ],
+                description: "A venue featureID/label pair, e.g. one selected from the program map's venue list."
+            ),
+            returns: Self.actionResultSchema,
+            permissions: ["rw--"],
+            description: .string("Single-field convenience for setting position sharing to checkin mode at this venue - a thin wrapper over profile.setPositionSharing for a Picker's selected item.")
+        ) { [weak self] requester, payload in
+            guard let self else { return .null }
+            guard await self.validateAccess("rw--", at: ArendalsukaParticipantProfileContract.setCheckedInVenueKeypath, for: requester) else { return .string("denied") }
+            // Accepts either the profile's own {featureID, label} shape, a row
+            // object straight from ArendalsukaParticipantProgramCell's mapRows
+            // (EventPlatformStateRows: {id, title, ...}), or the Picker's own
+            // selection envelope ({selectionMode, trigger, selectedIndex,
+            // selected: {id, title, ...}}) that skeleton-runtime.js's
+            // SkeletonPicker actually dispatches for selectionPayloadMode
+            // "item" - the real row lives under "selected", not top-level.
+            let container = Self.object(payload)
+            let venue = container["selected"].map(Self.object) ?? container
+            let featureID = venue["featureID"] ?? venue["id"] ?? .string("")
+            let label = venue["label"] ?? venue["title"] ?? .string("")
+            return await self.setPositionSharing(
+                value: .object([
+                    "mode": .string("checkin"),
+                    "checkedInVenueFeatureID": featureID,
+                    "checkedInVenueLabel": label
+                ]),
+                requester: requester
+            )
+        }
+    }
+
+    // MARK: - Proxying to ArendalsukaConnectionHubCell
+
+    private func resolveHub(requester: Identity) async -> Meddle? {
+        guard let resolver = CellBase.defaultCellResolver else { return nil }
+        return try? await resolver.cellAtEndpoint(
+            endpoint: ArendalsukaParticipantProgramContract.meetingHubEndpoint,
+            requester: requester
+        ) as? Meddle
+    }
+
+    private func setDisplayNameOverride(value: ValueType?, requester: Identity) async -> ValueType {
+        guard let hub = await resolveHub(requester: requester) else {
+            return .string("error: profile service is unavailable")
+        }
+        guard let override = Self.string(Self.object(value)["displayNameOverride"]) ?? Self.string(value) else {
+            return .string("error: display name override requires a string value")
+        }
+        let result = try? await hub.set(keypath: "setDisplayNameOverride", value: .string(override), requester: requester)
+        if let errorText = Self.string(result), errorText.hasPrefix("error") || errorText == "denied" {
+            return .string(errorText)
+        }
+        guard case .object? = result else {
+            return .string("error: profile update was not acknowledged")
+        }
+        return await stateValue(requester: requester)
+    }
+
+    private func setStilling(value: ValueType?, requester: Identity) async -> ValueType {
+        guard let hub = await resolveHub(requester: requester) else {
+            return .string("error: profile service is unavailable")
+        }
+        guard let stilling = Self.string(Self.object(value)["stilling"]) ?? Self.string(value) else {
+            return .string("error: stilling requires a string value")
+        }
+        let result = try? await hub.set(keypath: "setStilling", value: .string(stilling), requester: requester)
+        if let errorText = Self.string(result), errorText.hasPrefix("error") || errorText == "denied" {
+            return .string(errorText)
+        }
+        guard case .object? = result else {
+            return .string("error: profile update was not acknowledged")
+        }
+        return await stateValue(requester: requester)
+    }
+
+    /// Accepts either a ready `photoDataURI` string (programmatic callers) or
+    /// the FileUpload skeleton element's native upload payload
+    /// (`mimeType` + `dataBase64`, no data-URI prefix - see
+    /// `filesToTemporaryAttachmentPayload` in skeleton-runtime.js), which this
+    /// proxy assembles into a `data:image/...;base64,...` URI before handing
+    /// it to the hub. The hub's own representation stays a single
+    /// self-describing string either way.
+    private func setPhoto(value: ValueType?, requester: Identity) async -> ValueType {
+        guard let hub = await resolveHub(requester: requester) else {
+            return .string("error: profile service is unavailable")
+        }
+        let outer = Self.object(value)
+        if outer["kind"] == .string("pick"), outer["temporaryPayload"] == nil,
+           Self.string(outer["fieldID"])?.isEmpty == false {
+            return await stateValue(requester: requester)
+        }
+        let payload = outer["temporaryPayload"].map(Self.object) ?? outer
+        let photo: String
+        if let explicit = Self.string(payload["photoDataURI"]) ?? Self.string(value) {
+            photo = explicit
+        } else if let mimeType = Self.string(payload["mimeType"]), mimeType.hasPrefix("image/"),
+                  let base64 = Self.string(payload["dataBase64"]), base64.isEmpty == false {
+            photo = "data:\(mimeType);base64,\(base64)"
+        } else {
+            return .string("error: photo requires a data URI or image upload")
+        }
+        let result = try? await hub.set(keypath: "setPhoto", value: .string(photo), requester: requester)
+        if let errorText = Self.string(result), errorText.hasPrefix("error") || errorText == "denied" {
+            return .string(errorText)
+        }
+        guard case .object? = result else {
+            return .string("error: profile update was not acknowledged")
+        }
+        return await stateValue(requester: requester)
+    }
+
+    /// When enabling, reads the participant's own saved sessions from
+    /// `ArendalsukaParticipantProgramCell` and snapshots them into the hub.
+    /// The hub itself deliberately knows nothing about that cell - this proxy
+    /// is where that cross-cell read belongs.
+    private func setFavoritesSharing(value: ValueType?, requester: Identity) async -> ValueType {
+        guard let hub = await resolveHub(requester: requester) else {
+            return .string("error: profile service is unavailable")
+        }
+        guard let isEnabled = Self.boolValue(Self.object(value)["isEnabled"]) ?? Self.boolValue(value) else {
+            return .string("error: favorites sharing requires a boolean value")
+        }
+
+        var sessionIds: [String] = []
+        if isEnabled {
+            guard let resolver = CellBase.defaultCellResolver,
+                  let program = try? await resolver.cellAtEndpoint(
+                      endpoint: ArendalsukaParticipantProgramContract.endpoint,
+                      requester: requester
+                  ) as? Meddle,
+                  let programState = try? await program.get(keypath: ArendalsukaParticipantProgramContract.stateKeypath, requester: requester),
+                  case let .object(state) = programState,
+                  case let .object(agenda)? = state["agenda"],
+                  let savedIDs = Self.stringListValue(agenda["savedSessionIDs"]) else {
+                return .string("error: saved sessions could not be read; favorites sharing was not changed")
+            }
+            sessionIds = savedIDs
+        }
+
+        let result = try? await hub.set(
+            keypath: "setFavoritesSharing",
+            value: .object(["isEnabled": .bool(isEnabled), "sessionIds": .list(sessionIds.map(ValueType.string))]),
+            requester: requester
+        )
+        if let errorText = Self.string(result), errorText.hasPrefix("error") || errorText == "denied" {
+            return .string(errorText)
+        }
+        guard case .object? = result else {
+            return .string("error: profile update was not acknowledged")
+        }
+        return await stateValue(requester: requester)
+    }
+
+    private func setPositionSharing(value: ValueType?, requester: Identity) async -> ValueType {
+        guard let hub = await resolveHub(requester: requester) else {
+            return .string("error: profile service is unavailable")
+        }
+        let payload = Self.object(value)
+        guard let mode = payload["mode"] else {
+            return .string("error: position sharing requires an explicit mode")
+        }
+        var forwarded: Object = ["mode": mode]
+        for key in ["manualLabel", "checkedInVenueFeatureID", "checkedInVenueLabel", "latitude", "longitude"] {
+            if let fieldValue = payload[key] {
+                forwarded[key] = fieldValue
+            }
+        }
+        let result = try? await hub.set(keypath: "setPositionSharing", value: .object(forwarded), requester: requester)
+        if let errorText = Self.string(result), errorText.hasPrefix("error") || errorText == "denied" {
+            return .string(errorText)
+        }
+        guard case .object? = result else {
+            return .string("error: profile update was not acknowledged")
+        }
+        return await stateValue(requester: requester)
+    }
+
+    private func stateValue(requester: Identity) async -> ValueType {
+        guard let hub = await resolveHub(requester: requester),
+              let raw = try? await hub.get(keypath: "state", requester: requester),
+              case let .object(hubState) = raw else {
+            return .object([
+                "source": .string("ArendalsukaParticipantProfileCell"),
+                "isAvailable": .bool(false),
+                "isMatchingConsentGranted": .bool(false),
+                "displayNameOverride": .string(""),
+                "stilling": .string(""),
+                "photoDataURI": .null,
+                "photoStatus": .string("Ingen profilbilde lagret"),
+                "isVerified": .bool(false),
+                "favoritesSharingEnabled": .bool(false),
+                "sharedFavoriteSessionIds": .list([]),
+                "positionSharing": .object(["mode": .string("off")])
+            ])
+        }
+        return .object([
+            "source": .string("ArendalsukaParticipantProfileCell"),
+            "isAvailable": .bool(true),
+            "isMatchingConsentGranted": hubState["isMatchingConsentGranted"] ?? .bool(false),
+            "displayNameOverride": hubState["myDisplayNameOverride"] ?? .string(""),
+            "stilling": hubState["myStilling"] ?? .string(""),
+            "photoDataURI": hubState["myPhotoDataURI"] ?? .null,
+            "photoStatus": .string(Self.string(hubState["myPhotoDataURI"])?.isEmpty == false ? "Profilbilde lagret" : "Ingen profilbilde lagret"),
+            "isVerified": .bool(false),
+            "favoritesSharingEnabled": hubState["myFavoritesSharingEnabled"] ?? .bool(false),
+            "sharedFavoriteSessionIds": hubState["mySharedFavoriteSessionIds"] ?? .list([]),
+            "positionSharing": hubState["myPositionSharing"] ?? .object(["mode": .string("off")])
+        ])
+    }
+
+    private static func scalarOrFieldSchema(_ field: String, type: String, description: String) -> ValueType {
+        ExploreContract.oneOfSchema(options: [
+            ExploreContract.schema(type: type),
+            ExploreContract.objectSchema(
+                properties: [field: ExploreContract.schema(type: type)], requiredKeys: [field]
+            )
+        ], description: description)
+    }
+
+    private static var coordinateSchema: ValueType {
+        ExploreContract.oneOfSchema(options: [ExploreContract.schema(type: "float"), ExploreContract.schema(type: "integer")])
+    }
+
+    private static func nullableSchema(type: String) -> ValueType {
+        ExploreContract.oneOfSchema(options: [ExploreContract.schema(type: type), ExploreContract.schema(type: "null")])
+    }
+
+    private static var actionResultSchema: ValueType {
+        ExploreContract.oneOfSchema(options: [stateSchema, ExploreContract.schema(type: "string", description: "Explicit error or access denial.")])
+    }
+
+    private static var stateSchema: ValueType {
+        ExploreContract.objectSchema(
+            properties: [
+                "source": ExploreContract.schema(type: "string"),
+                "isAvailable": ExploreContract.schema(type: "boolean"),
+                "isMatchingConsentGranted": ExploreContract.schema(type: "boolean"),
+                "displayNameOverride": ExploreContract.schema(type: "string"),
+                "stilling": ExploreContract.schema(type: "string"),
+                "photoDataURI": Self.nullableSchema(type: "string"),
+                "photoStatus": ExploreContract.schema(type: "string"),
+                "isVerified": ExploreContract.schema(type: "boolean"),
+                "favoritesSharingEnabled": ExploreContract.schema(type: "boolean"),
+                "sharedFavoriteSessionIds": ExploreContract.listSchema(item: ExploreContract.schema(type: "string")),
+                "positionSharing": ExploreContract.objectSchema(
+                    properties: [
+                        "mode": ExploreContract.schema(type: "string"),
+                        "manualLabel": Self.nullableSchema(type: "string"),
+                        "checkedInVenueFeatureID": Self.nullableSchema(type: "string"),
+                        "checkedInVenueLabel": Self.nullableSchema(type: "string"),
+                        "latitude": ExploreContract.oneOfSchema(options: [Self.coordinateSchema, ExploreContract.schema(type: "null")]),
+                        "longitude": ExploreContract.oneOfSchema(options: [Self.coordinateSchema, ExploreContract.schema(type: "null")]),
+                        "updatedAt": Self.nullableSchema(type: "string")
+                    ], requiredKeys: ["mode"]
+                )
+            ],
+            requiredKeys: ["source", "isAvailable", "isMatchingConsentGranted", "isVerified"],
+            description: "This participant's self-controlled Arendalsuka profile."
+        )
+    }
+
+    private static func object(_ value: ValueType?) -> Object {
+        guard case let .object(object)? = value else { return [:] }
+        return object
+    }
+
+    private static func string(_ value: ValueType?) -> String? {
+        guard case let .string(string)? = value else { return nil }
+        return string
+    }
+
+    private static func boolValue(_ value: ValueType?) -> Bool? {
+        guard case let .bool(bool)? = value else { return nil }
+        return bool
+    }
+
+    private static func stringListValue(_ value: ValueType?) -> [String]? {
+        guard case let .list(list)? = value else { return nil }
+        return list.compactMap { element -> String? in
+            guard case let .string(text) = element else { return nil }
+            let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
+            return trimmed.isEmpty ? nil : trimmed
+        }
+    }
+}

+
+    private func setPhoto(
+        value: ValueType?,
+        requester: Identity
+    ) async -> ValueType {
+        guard Self.supportsRichParticipantProfile,
+              let photo = rawStringValue(value) ?? rawStringValue(objectValue(value)["photoDataURI"]) else {
+            return .string("error: photo requires a string value")
+        }
+        let trimmed = photo.trimmingCharacters(in: .whitespacesAndNewlines)
+        if trimmed.isEmpty == false {
+            guard trimmed.hasPrefix("data:image/") else {
+                return .string("error: photo must be a data:image/... URI")
+            }
+            guard trimmed.utf8.count <= ((Self.maximumPhotoBytes + 2) / 3) * 4 + 32 else {
+                return .string("error: photo must be at most \(Self.maximumPhotoBytes / 1_024) KB")
+            }
+            let parts = trimmed.split(separator: ",", maxSplits: 1, omittingEmptySubsequences: false)
+            guard parts.count == 2,
+                  ["data:image/png;base64", "data:image/jpeg;base64", "data:image/webp;base64"].contains(String(parts[0])),
+                  let bytes = Data(base64Encoded: String(parts[1])), bytes.isEmpty == false else {
+                return .string("error: photo requires a base64 PNG, JPEG or WebP image")
+            }
+            guard bytes.count <= Self.maximumPhotoBytes else {
+                return .string("error: photo must be at most \(Self.maximumPhotoBytes / 1_024) KB")
+            }
+        }

+    /// Builds a local actor from one row of the `stand` source-of-truth table
+    /// (fields match its JSON export verbatim: `organization`, `stand_location`,
+    /// `stand_description`, `latitude`, `longitude`, `occupant_entry_id`, `status`).
+    /// `stand_location` is Arendalsuka's own internal zone/number label (e.g.
+    /// "Torvet - 135"), not a real street address - stored as-is in `address`.
+    private static func localActorRecord(
+        fromStand object: Object,
+        sourceID: String,
+        importedAt: Date
+    ) -> ArendalsukaLocalActorRecord? {
+        guard let name = EventPlatformValueDecoding.string(object["organization"]), name.isEmpty == false else {
+            return nil
+        }
+        let location = EventPlatformValueDecoding.string(object["stand_location"]) ?? ""
+        let description = EventPlatformValueDecoding.string(object["stand_description"]) ?? ""
+        let latitude = ArendalsukaEventAtlasFormatting.double(object["latitude"])
+        let longitude = ArendalsukaEventAtlasFormatting.double(object["longitude"])
+        let occupantEntryID = EventPlatformValueDecoding.int(object["occupant_entry_id"]).map(String.init)
+            ?? EventPlatformValueDecoding.string(object["occupant_entry_id"])
+        let externalSourceID = "arendalsuka-stand:\(occupantEntryID ?? "\(normalizedActorName(name))-\(normalizedActorName(location))")"
+        let status = EventPlatformValueDecoding.string(object["status"]) ?? "booked"
+        let summary = description.isEmpty ? "Stand: \(location)" : description
+        let derived = ArendalsukaPurposeClassifier.classify(
+            title: name,
+            category: ArendalsukaActorKind.stand.rawValue,
+            format: "",
+            tags: ["arendalsuka-stand", status],
+            rawText: summary
+        )
+        let purposeRefs = ArendalsukaEventAtlasFormatting.normalizedUnique(
+            coordinationPurposeRefs(for: .stand) + derived.purposeRefs
+        )
+        let interests = ArendalsukaEventAtlasFormatting.normalizedUnique(
+            ["arendalsuka", "stand"] + derived.interests
+        )
+        return ArendalsukaLocalActorRecord(
+            id: "actor-stand-\(occupantEntryID ?? normalizedActorName(name))",
+            kind: .stand,
+            name: name,
+            summary: summary,
+            address: location,
+            latitude: latitude,
+            longitude: longitude,
+            openingHours: "",
+            claimStatus: "unclaimed-source-import",
+            ownerContact: "",
+            source: externalSourceID,
+            sourceURL: nil,
+            sourceProvenance: "Imported from Arendalsuka's own public stands GeoJSON API via \(sourceID); location label is an internal Arendalsuka zone/number scheme, not a real street address.",
+            licenseNote: nil,
+            externalSourceID: externalSourceID,
+            duplicateOfActorID: nil,
+            purposeRefs: purposeRefs,
+            interests: interests,
+            offers: [],
+            liveStatus: "source-imported",
+            updatedAt: importedAt
+        )
+    }

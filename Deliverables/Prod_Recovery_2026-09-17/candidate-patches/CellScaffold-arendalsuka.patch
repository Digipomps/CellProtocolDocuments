+    /// Ingests exhibitor stands from the `stand` source-of-truth table (see
+    /// `arendalsuka-data-pipeline` skill's `references/schema.md`) — deduplicated
+    /// exhibitor stands with coordinates from Arendalsuka's own public stands
+    /// GeoJSON API. Mirrors `ingestOSMPOIs`'s shape and dedup/claim-protection
+    /// behavior; stands become `ArendalsukaLocalActorRecord`s with `kind: .stand`
+    /// alongside OSM-imported venues/restaurants/bars/shops.
+    private func ingestStands(payload: Object, requester: Identity) -> ValueType {
+        let now = Date()
+        let sourceID = EventPlatformValueDecoding.string(payload["sourceID"]) ?? "source-arendalsuka-stands"
+        let standValues = EventPlatformValueDecoding.list(payload["stands"])
+        var candidates: [ArendalsukaLocalActorRecord] = []
+        var skippedUnnamed = 0
+
+        for value in standValues {
+            let object = EventPlatformValueDecoding.object(value)
+            guard let actor = Self.localActorRecord(fromStand: object, sourceID: sourceID, importedAt: now) else {
+                skippedUnnamed += 1
+                continue
+            }
+            candidates.append(actor)
+        }
+
+        var created = 0
+        var updated = 0
+        var skippedClaimedDuplicates = 0
+        var skippedDuplicateRows: [Object] = []
+        var importedRows: [Object] = []
+        var importedActors: [ArendalsukaLocalActorRecord] = []
+
+        var importFailed = false
+        stateQueue.sync {
+            var draftActors = localActorsByID
+            var draftSelectedActorID = selectedActorID
+            for candidate in candidates {
+                if let existingSource = draftActors.values.first(where: { $0.source == candidate.source || $0.externalSourceID == candidate.externalSourceID }) {
+                    if Self.actorIsClaimed(existingSource) {
+                        skippedClaimedDuplicates += 1
+                        skippedDuplicateRows.append(Self.duplicateRow(candidate: candidate, existing: existingSource, reason: "external_source_matches_claimed_actor"))
+                        continue
+                    }
+                    let merged = Self.mergedSourceImportedActor(existing: existingSource, candidate: candidate)
+                    draftActors[existingSource.id] = merged
+                    updated += 1
+                    importedActors.append(merged)
+                    importedRows.append(merged.rowObject)
+                    continue
+                }
+
+                if let duplicate = Self.bestDuplicate(for: candidate, in: Array(draftActors.values)) {
+                    if Self.actorIsClaimed(duplicate) {
+                        skippedClaimedDuplicates += 1
+                        skippedDuplicateRows.append(Self.duplicateRow(candidate: candidate, existing: duplicate, reason: "name_or_nearby_match_claimed_actor"))
+                        continue
+                    }
+                    let merged = Self.mergedSourceImportedActor(existing: duplicate, candidate: candidate)
+                    draftActors[duplicate.id] = merged
+                    updated += 1
+                    importedActors.append(merged)
+                    importedRows.append(merged.rowObject)
+                    continue
+                }
+
+                draftActors[candidate.id] = candidate
+                if draftSelectedActorID == nil {
+                    draftSelectedActorID = candidate.id
+                }
+                created += 1
+                importedActors.append(candidate)
+                importedRows.append(candidate.rowObject)
+            }
+
+            if importedActors.isEmpty == false {
+                let journal = Self.appendLocalDataImportJournalEntry(LocalDataImportJournalEntry(
+                    action: "ingestStands", source: sourceID, recordedAt: now, localActors: importedActors
+                ))
+                localDataJournalStatus = journal.status
+                localDataJournalPath = journal.path
+                localDataJournalEntryCount += journal.entryDelta
+                localDataJournalLoadedAt = journal.recordedAt
+                guard journal.status == "journal_appended" else {
+                    lastStatus = "Stand import failed: local data journal could not be written."
+                    importFailed = true
+                    return
+                }
+            }
+            localActorsByID = draftActors
+            selectedActorID = draftSelectedActorID
+
+            lastImportReport = [
+                "source": .string(sourceID),
+                "sourceKind": .string("arendalsuka_stands_geojson_api"),
+                "importedAt": .string(ArendalsukaEventAtlasFormatting.isoString(now)),
+                "received": .integer(standValues.count),
+                "candidateCount": .integer(candidates.count),
+                "created": .integer(created),
+                "updated": .integer(updated),
+                "skippedUnnamed": .integer(skippedUnnamed),
+                "skippedClaimedDuplicates": .integer(skippedClaimedDuplicates),
+                "duplicateRows": .list(skippedDuplicateRows.map(ValueType.object)),
+                "importedRows": .list(importedRows.map(ValueType.object)),
+                "claimPolicy": .string("Stand actors are unclaimed-source-import pages and never overwrite claimed actor pages."),
+                "licenseBoundary": .string("Location label (e.g. \"Torvet - 135\") is Arendalsuka's own internal zone/number scheme, not a real street address.")
+            ]
+            lastStatus = "Imported stands: \(created) created, \(updated) updated, \(skippedClaimedDuplicates) claimed duplicate(s) skipped, \(skippedUnnamed) unnamed skipped."
+        }
+
+        guard importFailed == false else {
+            return .string("error: stand import was not committed because journal persistence failed")
+        }
+
+        emit(kind: "arendalsuka.stands.ingested", payload: lastImportReportValue(), requester: requester)
+        return stateValue(requester: requester)
+    }
+

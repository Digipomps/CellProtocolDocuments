+    /// Serialize, persist and read back the full profile before acknowledging.
+    /// A failed write restores the prior in-memory profile and emits no success.
+    private func updateRichParticipantProfile(
+        requester: Identity,
+        eventTitle: String,
+        mutation: (inout SharedParticipantProfile) -> Void
+    ) async -> ValueType {
+        guard let bindingKey = identityBindingKey(for: requester) else {
+            return .string("error: identity is not bound")
+        }
+        guard let emitRichProfileChange else {
+            return .string("error: profile change notification runtime is unavailable")
+        }
+        await profileMutationLock.acquire()
+        _ = await ensureParticipantProfile(for: requester)
+        let previous = stateQueue.sync { () -> SharedParticipantProfile? in
+            guard var profile = participantProfilesByRequesterUUID[bindingKey] else { return nil }
+            let original = profile
+            mutation(&profile)
+            participantProfilesByRequesterUUID[bindingKey] = profile
+            return original
+        }
+        guard previous != nil,
+              await persistParticipantProfileSnapshotIfNeeded(
+                  bindingKey: bindingKey,
+                  requesterUUID: requester.uuid
+              ) else {
+            stateQueue.sync { participantProfilesByRequesterUUID[bindingKey] = previous }
+            await profileMutationLock.release()
+            return .string("error: local resolver snapshot persistence failed")
+        }
+        // This shared feed carries only an invalidation. Profile values and
+        // requester identifiers must remain in the authorized state projection.
+        var event = FlowElement(title: "conference.connection.\(eventTitle)",
+                                content: .object(["refresh": .bool(true)]),
+                                properties: FlowElement.Properties(type: .event, contentType: .object))
+        event.topic = "conference-connections"
+        emitRichProfileChange(event)
+        let response = await stateValue(requester: requester)
+        await profileMutationLock.release()
+        return response
+    }
+
+    /// Overrides the display name shown to other participants in this
+    /// conference, without touching the underlying Identity's own
+    /// `displayName` (which may be reused across other, unrelated contexts).
+    /// An empty override falls back to the Identity's own display name.
+    private func setDisplayNameOverride(
+        value: ValueType?,
+        requester: Identity
+    ) async -> ValueType {
+        guard Self.supportsRichParticipantProfile,
+              let override = rawStringValue(value) ?? rawStringValue(objectValue(value)["displayNameOverride"]) else {
+            return .string("error: display name override requires a string value")
+        }
+        let trimmed = override.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard trimmed.utf8.count <= 120 else {
+            return .string("error: display name override must be at most 120 UTF-8 bytes")
+        }
+
+        return await updateRichParticipantProfile(
+            requester: requester,
+            eventTitle: "participant_display_name_override_changed"
+        ) { profile in
+            profile.displayNameOverride = trimmed
+        }
+    }

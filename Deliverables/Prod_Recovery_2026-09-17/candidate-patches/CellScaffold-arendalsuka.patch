+final class ArendalsukaParticipantProfileCellTests: IsolatedCellTestCase {
+    func testRendererPayloadsAndRuntimeResultsMatchContractsAndHubFlow() async throws {
+        let previousDebugAccess = CellBase.debugValidateAccessForEverything
+        CellBase.debugValidateAccessForEverything = false
+        defer { CellBase.debugValidateAccessForEverything = previousDebugAccess }
+        let resolver = CellResolver.sharedInstance
+        CellBase.defaultCellResolver = resolver
+        let vault = BrowserClientIdentityVault(identityDomain: "profile-contract-\(UUID().uuidString)")
+        CellBase.defaultIdentityVault = vault
+        try await resolver.addCellResolve(
+            name: "EntityAnchor", cellScope: .identityUnique, persistency: .ephemeral,
+            identityDomain: "private", type: EntityAnchorCell.self
+        )
+        try await resolver.addCellResolve(
+            name: ArendalsukaConnectionHubCell.cellName, cellScope: .scaffoldUnique,
+            persistency: .ephemeral, identityDomain: ArendalsukaConnectionHubCell.identityDomainName,
+            type: ArendalsukaConnectionHubCell.self
+        )
+        let owner = await makeCellProtocolTestIdentity("profile-contract-owner", in: vault)
+        let profile = await ArendalsukaParticipantProfileCell(owner: owner)
+        _ = try await profile.get(keypath: "state", requester: owner)
+        let resolved = try await resolver.cellAtEndpoint(
+            endpoint: ArendalsukaParticipantProgramContract.meetingHubEndpoint, requester: owner
+        )
+        let hub = try XCTUnwrap(resolved as? ArendalsukaConnectionHubCell)
+        let changed = expectation(description: "hub emits acknowledged profile change")
+        let feed = try await hub.flow(requester: owner)
+        var observed: FlowElement?
+        let subscription = feed.sink(receiveCompletion: { _ in }, receiveValue: { event in
+            guard event.title == "conference.connection.participant_stilling_changed" else { return }
+            observed = event
+            changed.fulfill()
+        })
+        let cases: [(String, ValueType)] = [
+            ("profile.setDisplayNameOverride", .string("Ada")),
+            ("profile.setStilling", .object(["stilling": .string("Deltaker")])),
+            ("profile.setPhoto", .object(["mimeType": .string("image/png"), "dataBase64": .string("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+a7p8AAAAASUVORK5CYII=")])),
+            ("profile.setPhoto", .string("")),
+            ("profile.setPhoto", .object(["kind": .string("pick"), "fieldID": .string("profile-photo")])),
+            ("profile.setPhoto", .object(["kind": .string("pick"), "fieldID": .string("profile-photo"), "temporaryPayload": .object(["mimeType": .string("image/png"), "dataBase64": .string("aGVsbG8=")])])),
+            ("state.favoritesSharingEnabled", .bool(false)),
+            ("profile.setManualPositionLabel", .string("Ved kaien")),
+            ("profile.setPositionSharing", .object(["mode": .string("live"), "latitude": .float(58.46), "longitude": .float(8.77)])),
+            ("profile.setCheckedInVenue", .object(["selected": .object(["id": .string("venue-1"), "title": .string("Torget")])])),
+            ("profile.setPositionSharing", .object(["mode": .string("off")])),
+            ("profile.setPhoto", .string("https://invalid.example/photo.png"))
+        ]
+        for (key, payload) in cases {
+            let contract = try await profile.contract(for: key, method: .set, requester: owner)
+            let fields = try XCTUnwrap(ExploreContract.object(from: contract))
+            let input = ExploreContractValidator.validate(value: payload, against: fields[ExploreContract.Field.input])
+            XCTAssertTrue(input.ok, "\(key) input: \(input.issues)")
+            let result = try await profile.set(keypath: key, value: payload, requester: owner)
+            if payload == .string("https://invalid.example/photo.png") {
+                XCTAssertTrue(asStringValue(result)?.hasPrefix("error:") == true)
+            } else {
+                let updated = try XCTUnwrap(ExploreContract.object(from: result), "\(key) must return the updated profile")
+                XCTAssertEqual(asBool(updated, "isAvailable"), true)
+            }
+            let output = ExploreContractValidator.validate(value: result, against: fields[ExploreContract.Field.returns])
+            XCTAssertTrue(output.ok, "\(key) output: \(output.issues)")
+            XCTAssertTrue(ExploreContract.flowEffects(from: contract).isEmpty, "The proxy must not promise hub events on its own feed")
+        }
+        await fulfillment(of: [changed], timeout: 2)
+        withExtendedLifetime(subscription) {}
+        let event = try XCTUnwrap(observed)
+        guard case let .object(eventPayload) = event.content else {
+            return XCTFail("Expected a value-free profile invalidation")
+        }
+        XCTAssertEqual(Set(eventPayload.keys), ["refresh"], "Shared invalidations must not carry private profile values")
+        XCTAssertEqual(eventPayload["refresh"], .bool(true))
+        let canInjectFeed = await hub.validateAccess("-w--", at: "feed", for: owner)
+        XCTAssertFalse(canInjectFeed, "Profile actions must not grant arbitrary feed injection")
+        let hubContract = try await hub.contract(for: "setStilling", method: .set, requester: owner)
+        let topics = ExploreContract.flowEffects(from: hubContract).compactMap {
+            ExploreContract.string(from: $0[ExploreContract.Field.topic])
+        }
+        XCTAssertEqual(topics, [event.topic])
+
+        // A missing agenda cannot be represented as successful sharing of an
+        // empty list. The user's consent setting must remain unchanged.
+        let unavailable = try await profile.set(keypath: "state.favoritesSharingEnabled", value: .bool(true), requester: owner)
+        XCTAssertTrue(asStringValue(unavailable)?.hasPrefix("error:") == true)
+        let state = try await profile.get(keypath: "state", requester: owner)
+        let stateFields = try XCTUnwrap(ExploreContract.object(from: state))
+        XCTAssertEqual(asBool(stateFields, "favoritesSharingEnabled"), false)
+        let readContract = try await profile.contract(for: "state", method: .get, requester: owner)
+        let readFields = try XCTUnwrap(ExploreContract.object(from: readContract))
+        XCTAssertTrue(ExploreContractValidator.validate(value: state, against: readFields[ExploreContract.Field.returns]).ok)
+    }

+    func testPositionSharingModesAreExclusiveAndValidated() async throws {
+        let previousDebugAccess = CellBase.debugValidateAccessForEverything
+        let previousResolver = CellBase.defaultCellResolver
+        let previousVault = CellBase.defaultIdentityVault
+        CellBase.debugValidateAccessForEverything = false
+        defer {
+            CellBase.debugValidateAccessForEverything = previousDebugAccess
+            CellBase.defaultCellResolver = previousResolver
+            CellBase.defaultIdentityVault = previousVault
+        }
+
+        let resolver = CellResolver.sharedInstance
+        CellBase.defaultCellResolver = resolver
+        let vault = BrowserClientIdentityVault(identityDomain: "arendalsuka-participant-profile-position-\(UUID().uuidString)")
+        CellBase.defaultIdentityVault = vault
+        try await resolver.addCellResolve(
+            name: "EntityAnchor",
+            cellScope: .identityUnique,
+            persistency: .ephemeral,
+            identityDomain: "private",
+            type: EntityAnchorCell.self
+        )
+        try await resolver.addCellResolve(
+            name: ArendalsukaConnectionHubCell.cellName,
+            cellScope: .scaffoldUnique,
+            persistency: .ephemeral,
+            identityDomain: ArendalsukaConnectionHubCell.identityDomainName,
+            type: ArendalsukaConnectionHubCell.self
+        )
+
+        guard let participant = await makeParticipant("arendalsuka-participant-profile-position-owner", vault: vault) else {
+            return XCTFail("Expected a signable participant identity")
+        }
+        let profile = await ArendalsukaParticipantProfileCell(owner: participant)
+
+        // Manual mode requires a non-empty label.
+        let emptyManual = try await profile.set(
+            keypath: "profile.setPositionSharing",
+            value: .object(["mode": .string("manual")]),
+            requester: participant
+        )
+        XCTAssertEqual(asStringValue(emptyManual), "error: manualLabel must be 1-120 UTF-8 bytes")
+
+        let manualSet = try await profile.set(
+            keypath: "profile.setPositionSharing",
+            value: .object(["mode": .string("manual"), "manualLabel": .string("Ved Torvscenen")]),
+            requester: participant
+        )
+        guard let manualSet, case let .object(manualObject) = manualSet,
+              case let .object(manualPosition)? = manualObject["positionSharing"] else {
+            return XCTFail("Expected position sharing state after setting manual mode")
+        }
+        XCTAssertEqual(asString(manualPosition, "mode"), "manual")
+        XCTAssertEqual(asString(manualPosition, "manualLabel"), "Ved Torvscenen")
+
+        // Switching to checkin clears the stale manual label.
+        let checkinSet = try await profile.set(
+            keypath: "profile.setPositionSharing",
+            value: .object([
+                "mode": .string("checkin"),
+                "checkedInVenueFeatureID": .string("venue-torvscenen-abc12345"),
+                "checkedInVenueLabel": .string("Torvscenen")
+            ]),
+            requester: participant
+        )
+        guard let checkinSet, case let .object(checkinObject) = checkinSet,
+              case let .object(checkinPosition)? = checkinObject["positionSharing"] else {
+            return XCTFail("Expected position sharing state after checking in")
+        }
+        XCTAssertEqual(asString(checkinPosition, "mode"), "checkin")
+        XCTAssertEqual(asString(checkinPosition, "checkedInVenueFeatureID"), "venue-torvscenen-abc12345")
+        XCTAssertNil(checkinPosition["manualLabel"])
+
+        // checkin requires a featureID.
+        let missingFeatureID = try await profile.set(
+            keypath: "profile.setPositionSharing",
+            value: .object(["mode": .string("checkin")]),
+            requester: participant
+        )
+        XCTAssertEqual(asStringValue(missingFeatureID), "error: checkedInVenueFeatureID is required for checkin mode")
+
+        // Live mode requires valid coordinates and clears the stale check-in.
+        let liveSet = try await profile.set(
+            keypath: "profile.setPositionSharing",
+            value: .object(["mode": .string("live"), "latitude": .float(58.4595), "longitude": .float(8.7660)]),
+            requester: participant
+        )
+        guard let liveSet, case let .object(liveObject) = liveSet,
+              case let .object(livePosition)? = liveObject["positionSharing"] else {
+            return XCTFail("Expected position sharing state after enabling live mode")
+        }
+        XCTAssertEqual(asString(livePosition, "mode"), "live")
+        XCTAssertNil(livePosition["checkedInVenueFeatureID"])
+        guard case let .float(latitude)? = livePosition["latitude"] else {
+            return XCTFail("Expected a float latitude")
+        }
+        XCTAssertEqual(latitude, 58.4595, accuracy: 0.0001)
+
+        let invalidLatitude = try await profile.set(
+            keypath: "profile.setPositionSharing",
+            value: .object(["mode": .string("live"), "latitude": .float(9999), "longitude": .float(8.766)]),
+            requester: participant
+        )
+        XCTAssertEqual(asStringValue(invalidLatitude), "error: live mode requires valid latitude/longitude")
+
+        // Turning sharing off clears everything.
+        let offSet = try await profile.set(
+            keypath: "profile.setPositionSharing",
+            value: .object(["mode": .string("off")]),
+            requester: participant
+        )
+        guard let offSet, case let .object(offObject) = offSet,
+              case let .object(offPosition)? = offObject["positionSharing"] else {
+            return XCTFail("Expected position sharing state after turning sharing off")
+        }
+        XCTAssertEqual(asString(offPosition, "mode"), "off")
+        XCTAssertNil(offPosition["latitude"])
+    }

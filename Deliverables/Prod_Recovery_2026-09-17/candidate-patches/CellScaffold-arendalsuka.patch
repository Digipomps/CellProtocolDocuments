+    private func importAccessPayload(
+        _ payload: Object,
+        actionKeypath: String,
+        issuer: Identity,
+        subject: Identity? = nil
+    ) async throws -> ValueType {
+        var secured = payload
+        let artifact = try await CapabilityInvitationProofSupport.generateArtifact(
+            invitationID: "arendalsuka-import-\(UUID().uuidString)",
+            resource: ArendalsukaAtlasImportAccessContract.resource(),
+            actionKeypath: actionKeypath,
+            capabilities: [ArendalsukaAtlasImportAccessContract.capabilityRef],
+            purpose: ArendalsukaAtlasImportAccessContract.purposeRef,
+            issuer: issuer,
+            subject: subject ?? issuer
+        )
+        secured["importAccess"] = .object([
+            "proofArtifact": CapabilityInvitationProofSupport.valueType(from: artifact)
+        ])
+        return .object(secured)
+    }
+
+    private func asInt(_ object: Object, _ key: String) -> Int? {
+        guard case let .integer(value)? = object[key] else { return nil }
+        return value
+    }
+
+    private func asBool(_ object: Object, _ key: String) -> Bool? {
+        guard case let .bool(value)? = object[key] else { return nil }
+        return value
+    }
+
+    private func asString(_ object: Object, _ key: String) -> String? {
+        guard case let .string(value)? = object[key] else { return nil }
+        return value
+    }
+
+    private func asStringList(_ object: Object, _ key: String) -> [String]? {
+        guard case let .list(values)? = object[key] else { return nil }
+        return values.compactMap { if case let .string(text) = $0 { text } else { nil } }
+    }
+
+    private func asStringValue(_ value: ValueType?) -> String? {
+        guard case let .string(text)? = value else { return nil }
+        return text
+    }
+}

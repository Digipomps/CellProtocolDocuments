+test('reordered JSON object fields preserve a document and its pending image read', async ({ page }) => {
+  const skeleton = { Visualization: { kind: 'richDocument', keypath: 'document.current', actionKeypath: 'document.change' } };
+  const snapshot = { schema: 'haven.document.v1', documentId: 'json-order-proof', revision: 0, sequence: 0,
+    ops: [{ insert: 'Preserved document\n' }], events: [], comments: [], presence: [], messages: [], help: [] };
+  let reorder = false;
+  const reverseObjectFields = value => Array.isArray(value) ? value.map(reverseObjectFields)
+    : value && typeof value === 'object' ? Object.fromEntries(Object.entries(value).reverse().map(([key, nested]) => [key, reverseObjectFields(nested)])) : value;
+  await page.route('**/*', async route => {
+    const pathname = new URL(route.request().url()).pathname;
+    if (pathname === '/') return route.fulfill({ contentType: 'text/html; charset=utf-8', body:
+      '<!doctype html><html><head><link rel="stylesheet" href="/css/porthole-webo.css"></head><body><main id="porthole-webo-app"></main><script src="/vendor/quill/quill.js"></script><script src="/js/skeleton-runtime.js"></script><script src="/js/porthole-webo.js"></script></body></html>' });
+    if (pathname === '/browserhead/porthole/bootstrap') {
+      const bootstrap = bootstrapWith(reorder ? reverseObjectFields(skeleton) : skeleton);
+      bootstrap.portholeState.state = { document: { current: snapshot } };
+      return route.fulfill({ contentType: 'application/json', body: JSON.stringify(bootstrap) });
+    }
+    if (pathname.startsWith('/js/') || pathname.startsWith('/vendor/') || pathname === '/css/porthole-webo.css' || pathname === '/css/rich-document.css') {
+      return route.fulfill({ path: path.join(publicDir, pathname), contentType: pathname.endsWith('.css') ? 'text/css' : 'application/javascript; charset=utf-8' });
+    }
+    return route.abort();
+  });
+  await page.goto('https://document-order.test/');
+  await expect(page.locator('.ql-editor')).toHaveAttribute('contenteditable', 'true');
+  await page.evaluate(snapshot => {
+    window.documentBeforeRefresh = document.querySelector('.ql-container');
+    window.documentCommands = [];
+    requestActionPayload = async (key, payload) => {
+      documentCommands.push(payload);
+      if (payload.kind === 'delta') {
+        const Delta = Quill.import('delta'); snapshot.ops = new Delta(snapshot.ops).compose(new Delta(payload.ops)).ops;
+        snapshot.revision++; snapshot.events.push({ revision: snapshot.revision, command: payload });
+      }
+      snapshot.sequence++;
+      return { result: { status: 'accepted', current: structuredClone(snapshot) } };
+    };
+    const NativeFileReader = FileReader;
+    window.FileReader = class extends NativeFileReader {
+      readAsDataURL(file) { window.finishDocumentImageRead = () => super.readAsDataURL(file); }
+    };
+  }, snapshot);
+  const png = Buffer.from(await page.evaluate(() => {
+    const canvas = document.createElement('canvas'); canvas.width = 32; canvas.height = 16;
+    canvas.getContext('2d').fillRect(0, 0, 32, 16); return canvas.toDataURL('image/png').split(',')[1];
+  }), 'base64');
+  await page.locator('input[type=file]').setInputFiles({ name: 'pending.png', mimeType: 'image/png', buffer: png });
+  await page.waitForFunction(() => typeof finishDocumentImageRead === 'function');
+  reorder = true;
+  await page.evaluate(() => refreshBootstrap({ silent: true }));

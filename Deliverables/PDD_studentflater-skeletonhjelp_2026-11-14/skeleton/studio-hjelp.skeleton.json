{
  "VStack": {
    "spacing": 16,
    "elements": [
      {
        "Text": {
          "text": "Cell Configuration Studio",
          "modifiers": {
            "styleRole": "title"
          }
        }
      },
      {
        "Section": {
          "header": {
            "Text": {
              "text": "Lag flaten med hjelp"
            }
          },
          "content": [
            {
              "Text": {
                "text": "Beskriv hva flaten skal vise og hva du vil kunne gjøre der. Modellen lager et utkast, Studio sjekker det, og ingenting lagres før du trykker Lagre."
              }
            },
            {
              "TextArea": {
                "sourceKeypath": "configurationStudio.state.assist.description",
                "targetKeypath": "configurationStudio.setAssistDescription",
                "placeholder": "For eksempel: et panel som viser gjøremålene mine med frist, og lar meg krysse dem av"
              }
            },
            {
              "Text": {
                "keypath": "configurationStudio.state.assist.modelText"
              }
            },
            {
              "HStack": {
                "spacing": 8,
                "wrap": true,
                "elements": [
                  {
                    "Button": {
                      "keypath": "configurationStudio.assistDraft",
                      "label": "Lag utkast"
                    }
                  },
                  {
                    "Button": {
                      "keypath": "configurationStudio.discardDraft",
                      "label": "Forkast utkastet"
                    }
                  }
                ]
              }
            },
            {
              "List": {
                "keypath": "configurationStudio.state.assist.messages",
                "flowElementSkeleton": {
                  "VStack": {
                    "elements": [
                      {
                        "Text": {
                          "keypath": "title",
                          "modifiers": {
                            "styleRole": "headline"
                          }
                        }
                      },
                      {
                        "Text": {
                          "keypath": "text"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      {
        "Section": {
          "header": {
            "Text": {
              "text": "Sjekk av flaten"
            }
          },
          "content": [
            {
              "Text": {
                "keypath": "configurationStudio.state.reachability.summary"
              }
            },
            {
              "List": {
                "keypath": "configurationStudio.state.reachability.findings",
                "flowElementSkeleton": {
                  "VStack": {
                    "elements": [
                      {
                        "Text": {
                          "keypath": "title",
                          "modifiers": {
                            "styleRole": "headline"
                          }
                        }
                      },
                      {
                        "Text": {
                          "keypath": "detail"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      {
        "Section": {
          "header": {
            "Text": {
              "text": "Forhåndsvisning"
            }
          },
          "content": [
            {
              "Text": {
                "keypath": "configurationStudio.state.previewCaption"
              }
            },
            {
              "Reference": {
                "keypath": "preview"
              }
            }
          ]
        }
      },
      {
        "Section": {
          "header": {
            "Text": {
              "text": "Redaktører"
            }
          },
          "content": [
            {
              "List": {
                "keypath": "configurationStudio.state.coedit.editors",
                "flowElementSkeleton": {
                  "VStack": [
                    {
                      "HStack": {
                        "spacing": 8,
                        "elements": [
                          {
                            "Text": {
                              "keypath": "name"
                            }
                          },
                          {
                            "Text": {
                              "keypath": "roleText"
                            }
                          },
                          {
                            "Text": {
                              "keypath": "lastChangeText"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            },
            {
              "Text": {
                "keypath": "configurationStudio.state.coedit.revisionText"
              }
            },
            {
              "List": {
                "keypath": "configurationStudio.state.coedit.conflicts",
                "flowElementSkeleton": {
                  "VStack": {
                    "elements": [
                      {
                        "Text": {
                          "keypath": "title",
                          "modifiers": {
                            "styleRole": "headline"
                          }
                        }
                      },
                      {
                        "Text": {
                          "keypath": "text"
                        }
                      },
                      {
                        "Button": {
                          "keypath": "configurationStudio.reloadSelectedConfiguration",
                          "label": "Hent siste versjon"
                        }
                      }
                    ]
                  }
                }
              }
            },
            {
              "HStack": {
                "spacing": 8,
                "wrap": true,
                "elements": [
                  {
                    "TextField": {
                      "sourceKeypath": "configurationStudio.state.coedit.inviteDraft",
                      "targetKeypath": "configurationStudio.setInviteDraft",
                      "placeholder": "Navn eller HAVEN-adresse"
                    }
                  },
                  {
                    "Button": {
                      "keypath": "configurationStudio.inviteEditor",
                      "label": "Inviter til å redigere"
                    }
                  }
                ]
              }
            },
            {
              "HStack": {
                "spacing": 8,
                "wrap": true,
                "elements": [
                  {
                    "Button": {
                      "keypath": "configurationStudio.saveDraftVersion",
                      "label": "Lagre ny versjon"
                    }
                  },
                  {
                    "Button": {
                      "keypath": "configurationStudio.shareToChat",
                      "label": "Del lenke i en samtale"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
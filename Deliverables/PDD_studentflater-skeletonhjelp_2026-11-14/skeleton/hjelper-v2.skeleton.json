{
  "VStack": {
    "spacing": 14,
    "elements": [
      {
        "Text": {
          "text": "Hjelper",
          "modifiers": {
            "fontSize": 22,
            "fontWeight": "semibold",
            "foregroundColor": "#0f172a"
          }
        }
      },
      {
        "List": {
          "keypath": "workbenchHelper.state.messages",
          "flowElementSkeleton": {
            "VStack": {
              "spacing": 4,
              "elements": [
                {
                  "Text": {
                    "keypath": "who",
                    "modifiers": {
                      "fontSize": 13,
                      "fontWeight": "semibold",
                      "foregroundColor": "#64748b"
                    }
                  }
                },
                {
                  "Text": {
                    "keypath": "text",
                    "modifiers": {
                      "foregroundColor": "#0f172a"
                    }
                  }
                }
              ],
              "modifiers": {
                "backgroundKeypath": "bg",
                "borderColor": "#e2e8f0",
                "borderWidth": 1,
                "cornerRadius": 12,
                "padding": 14
              }
            }
          }
        }
      },
      {
        "HStack": {
          "spacing": 10,
          "wrap": true,
          "elements": [
            {
              "Button": {
                "keypath": "workbenchHelper.openStudioWithRequest",
                "label": "Åpne Studio med denne beskrivelsen",
                "modifiers": {
                  "background": "#1d4ed8",
                  "foregroundColor": "#ffffff",
                  "cornerRadius": 8,
                  "fontWeight": "semibold"
                }
              }
            }
          ]
        }
      }
    ],
    "modifiers": {
      "maxWidthInfinity": true
    }
  }
}
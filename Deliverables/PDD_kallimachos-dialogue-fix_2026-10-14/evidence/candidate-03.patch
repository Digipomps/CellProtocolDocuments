+// Test-only observation of synthetic/public model output. The production HTTP
+// adapter and request are unchanged; no prompt bodies or requester IDs saved.
+private final class DialogueObservedLocalProvider: AIGatewayInvokingProvider {
+    private let base = AIGatewayOpenAICompatibleProvider()
+    private let outputPath: String?
+    private var outputs: [[String: Any]] = []
+    init(outputPath: String?) { self.outputPath = outputPath }
+    func validateEgress(route: AIGatewayProviderRoute) throws { try base.validateEgress(route: route) }
+    func invoke(route: AIGatewayProviderRoute, request: AIGatewayInvokeRequest, secret: AIGatewayResolvedSecret?) async throws -> AIGatewayProviderOutput {
+        let result = try await base.invoke(route: route, request: request, secret: secret)
+        if let outputPath {
+            outputs.append(["providerID": result.providerID, "model": result.model, "outputText": result.outputText])
+            try JSONSerialization.data(withJSONObject: outputs, options: [.sortedKeys, .prettyPrinted]).write(to: URL(fileURLWithPath: outputPath), options: .atomic)
+        }
+        return result
+    }

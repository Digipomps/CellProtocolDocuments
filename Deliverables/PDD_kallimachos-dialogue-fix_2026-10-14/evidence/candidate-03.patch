+private actor DialogueTestLatch {
+    private var open = false
+    private var continuation: CheckedContinuation<Void, Never>?
+    func wait() async {
+        if open { return }
+        await withCheckedContinuation { continuation = $0 }
+    }
+    func release() {
+        open = true
+        continuation?.resume()
+        continuation = nil
+    }
+}

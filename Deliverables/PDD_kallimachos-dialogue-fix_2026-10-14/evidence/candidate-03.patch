new file mode 100644
index 00000000..e835056c
--- /dev/null
+++ b/Sources/App/Cells/AI/KallimachosDialogueContext.swift
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright (c) 2026 Stiftelsen Digipomps and HAVEN contributors
+
+import Foundation
+
+/// purpose://candidate.kallimachos-dialogue-fix.context
+/// Context helps resolve the question; it is never evidence or authority.
+struct KallimachosDialogueTurn: Codable, Equatable {
+    var requester: String
+    var relation: String
+    var question: String
+    var summary: String
+    var topics: [String]
+}
+
+enum KallimachosDialogueContext {
+    static let interfaces = ["Emit", "Absorb", "Meddle", "Explore", "GroupProtocol"]
+
+    static func topics(in text: String) -> [String] {
+        interfaces.compactMap { name -> (String, String.Index)? in
+            guard let range = text.range(of: "\\b" + name + "\\b", options: [.regularExpression, .caseInsensitive]) else { return nil }
+            return (name, range.lowerBound)
+        }.sorted { $0.1 < $1.1 }.map { $0.0 }
+    }
+
+    static func turns(_ all: [KallimachosDialogueTurn], requester: String, relation: String) -> [KallimachosDialogueTurn] {
+        Array(all.filter { $0.requester == requester && $0.relation == relation }.suffix(6))
+    }
+
+    struct Resolution {
+        var query: String
+        var topics: [String]
+        var clarification: String?
+    }
+
+    static func resolve(_ question: String, history: [KallimachosDialogueTurn]) -> Resolution {
+        let explicit = topics(in: question)
+        if !explicit.isEmpty { return Resolution(query: question, topics: explicit) }
+        let lower = question.lowercased()
+        let latterWords = ["den siste", "det siste", "sistnevnte", "the latter"]
+        let formerWords = ["den første", "det første", "førstnevnte", "the former"]
+        let secondWords = ["den andre", "det andre", "the second"]
+        let latter = latterWords.contains { lower.contains($0) }
+        let former = formerWords.contains { lower.contains($0) }
+        let second = secondWords.contains { lower.contains($0) }
+        let prior = history.last?.topics ?? []
+        if latter || former || second {
+            let selected = second ? (prior.count > 1 ? prior[1] : nil) : (latter ? prior.last : prior.first)
+            guard let topic = selected else {
+                return Resolution(query: question, topics: [], clarification: "Hvilket grensesnitt viser du til? Nevn det ved navn, så kan jeg hente riktig kilde.")
+            }
+            var resolved = question
+            for phrase in latterWords + formerWords + secondWords {
+                resolved = resolved.replacingOccurrences(of: phrase, with: topic, options: .caseInsensitive)
+            }
+            return Resolution(query: resolved + " (Referansen gjelder " + topic + ".)", topics: [topic])
+        }
+        let continuation = ["gi et eksempel", "gi et lite", "kan du utdype", "utdyp", "hva betyr det", "hvordan fungerer det", "what about", "give an example", "explain that"]
+            .contains { lower.hasPrefix($0) }
+        if continuation && !prior.isEmpty {
+            return Resolution(query: question + " (Tema: " + prior.joined(separator: ", ") + ".)", topics: prior)
+        }
+        return Resolution(query: question, topics: [])
+    }
+
+    static func prompt(_ history: [KallimachosDialogueTurn]) -> String {
+        // Newest bounded turns, in chronological order. JSON escaping prevents
+        // user text from forging our field/section delimiters.
+        let records = history.map { ["question": String($0.question.prefix(800)), "previousModelSummary": String($0.summary.prefix(400)), "answerStatus": $0.summary.isEmpty ? "no-validated-answer" : "validated-summary"] }
+        guard let data = try? JSONSerialization.data(withJSONObject: records, options: [.sortedKeys]),
+              let text = String(data: data, encoding: .utf8) else { return "[]" }
+        return text
+    }
+}
+
+/// Hold the operation across awaits so changing relation/deleting while a model
+/// call is pending cannot publish or reinsert that call into another scope.
+actor KallimachosDialogueOperationGate {
+    private var busy = false
+    private var waiters: [CheckedContinuation<Void, Never>] = []
+
+    func enter() async {
+        if !busy { busy = true; return }
+        await withCheckedContinuation { waiters.append($0) }
+    }
+
+    func leave() {
+        if waiters.isEmpty { busy = false } else { waiters.removeFirst().resume() }
+    }
+}

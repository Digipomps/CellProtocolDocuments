diff --git a/Sources/App/Cells/AI/KallimachosAdvicePolicy.swift b/Sources/App/Cells/AI/KallimachosAdvicePolicy.swift
new file mode 100644
index 00000000..b2908bea
--- /dev/null
+++ b/Sources/App/Cells/AI/KallimachosAdvicePolicy.swift
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright (c) 2026 Stiftelsen Digipomps and HAVEN contributors
+
+import Foundation
+
+/// purpose://candidate.kallimachos-dialogue-fix.validation
+/// A structural and authority check, not a proof of all semantic entailments.
+enum KallimachosAdvicePolicy {
+    static let maturity = Set(["prinsipp", "spesifisert", "implementert", "testet", "prototype", "forskningsretning", "ukjent"])
+
+    static func issues(in root: [String: Any], evidenceIDs: Set<String>) -> [String] {
+        guard let advice = root["advice"] as? [String: Any],
+              let summary = advice["summary"] as? String, !summary.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+              let kind = advice["kind"] as? String,
+              ["explanation", "routing", "gap", "proposal", "self-report"].contains(kind),
+              let claims = advice["claims"] as? [[String: Any]] else { return ["invalid-advice-shape"] }
+        var issues: [String] = []
+        if summary.count > 1_200 { issues.append("summary-too-long") }
+        if !evidenceIDs.isEmpty && kind != "gap" && claims.isEmpty { issues.append("answer-without-claims") }
+        for claim in claims {
+            guard let text = claim["text"] as? String, !text.isEmpty,
+                  let level = claim["maturity"] as? String, maturity.contains(level),
+                  let ids = claim["evidenceIds"] as? [String] else {
+                issues.append("invalid-claim-shape-or-maturity")
+                continue
+            }
+            let flag = claim["uncertain"] as? NSNumber
+            let isBoolean = flag.map { String(cString: $0.objCType) == "c" } ?? false
+            let uncertain = isBoolean && flag?.boolValue == true
+            if claim["uncertain"] != nil && !isBoolean { issues.append("invalid-uncertainty") }
+            if !Set(ids).isSubset(of: evidenceIDs) { issues.append("unknown-evidence-id") }
+            if ids.isEmpty && !uncertain { issues.append("claim-without-evidence") }
+            if level == "ukjent" && !uncertain { issues.append("unknown-maturity-must-be-uncertain") }
+        }
+        if evidenceIDs.isEmpty && kind != "gap" { issues.append("gap-must-remain-gap") }
+        // Scan only the model's assertions/recommendations, not the quoted user
+        // request in understanding.restatement or the user's questions in gaps.
+        func assertionStrings(_ value: Any, path: String = "") -> [String] {
+            if ["understanding.restatement", "understanding.oneQuestionBack", "gaps[].question"].contains(path) { return [] }
+            if let string = value as? String { return [string] }
+            if let object = value as? [String: Any] { return object.flatMap { assertionStrings($0.value, path: path.isEmpty ? $0.key : path + "." + $0.key) } }
+            if let list = value as? [Any] { return list.flatMap { assertionStrings($0, path: path + "[]") } }
+            return []
+        }
+        let assertions = assertionStrings(root)
+        if assertions.contains(where: assertsAuthority) { issues.append("unsupported-action-or-authority") }
+        return Array(Set(issues)).sorted()
+    }
+
+    static func assertsAuthority(_ text: String) -> Bool {
+        // Explicitly refuted quotations are not the assistant's own claims.
+        var lower = text.lowercased().replacingOccurrences(
+            of: #"\b(?:uriktig|feil|misvisende|incorrect|false)\s+(?:å si|to say|to claim)\s*[«"'‘][^»"'’]*[»"'’]"#,
+            with: "refuted quotation", options: .regularExpression)
+
+        lower = lower.replacingOccurrences(
+            of: #"[«"‘][^»"’]*[»"’]\s+er\s+(?:feil|misvisende|uriktig)\b"#,
+            with: "refuted quotation", options: .regularExpression)
+        lower = lower.replacingOccurrences(
+            of: #"\b(?:det finnes ingen dokumentasjon på at|det er ikke dokumentert at|there is no evidence that)\s+(?:kallimachos|jeg|vi|assistenten|i|we|the assistant)\s+(?:har|kan|have|has|can)\s+"#,
+            with: "unsubstantiated event ", options: .regularExpression)
+
+        let separator = "[.!?;\\n]|,\\s*|\\b(?:men|but)\\b"
+        let range = NSRange(lower.startIndex..<lower.endIndex, in: lower)
+        let regex = try? NSRegularExpression(pattern: separator)
+        var start = 0
+        var clauses: [String] = []
+        let ns = lower as NSString
+        for match in regex?.matches(in: lower, range: range) ?? [] {
+            clauses.append(ns.substring(with: NSRange(location: start, length: match.range.location - start)))
+            start = NSMaxRange(match.range)
+        }
+        clauses.append(ns.substring(from: start))
+        return clauses.contains { clause in
+            func has(_ pattern: String) -> Bool { clause.range(of: pattern, options: .regularExpression) != nil }
+            let subject = #"\b(?:jeg|vi|we|kallimachos|assistenten|the assistant|i(?=\s+(?:have|can|will|did|am)))\b"#
+            let action = #"(?:slett\w*|delete\w*|erase\w*|fjern\w*|endre\w*|change\w*|skrev|skriver|write|written|updated|oppdatert|oppdaterer|publiser\w*|publish\w*|godkjenn\w*|approved|grant\w*|innvilg\w*|autoriser\w*|authorized|aktiver\w*|activated)"#
+            let modal = #"(?:kan|vil|skal|can|will|did|have|har)"#
+            // A negation must modify the action, not merely occur somewhere in
+            // the sentence. English "I" is a subject only before an English verb.
+            if has(subject + #"\s+(?:"# + modal + #"\s+)?(?:nå\s+|now\s+)?"# + action + #"\b"#) { return true }
+            if has(subject + #"\s+(?:har|have|has|gir|grant)\s+(?:(?:nå|full|skriftlig|now|full|write)\s+)*(?:skrivetilgang|tilgang|access|permission)\b"#) { return true }
+            if has(subject + #"\s+(?:(?:nå|allerede)\s+)?(?:har\s+)?(?:(?:nå|allerede)\s+)?(?:overtatt|tatt over)\s+(?:eierrollen|eierskapet|kontrollen)\b"#) { return true }
+            if has(subject + #"\s+(?:(?:nå|allerede)\s+)?har\s+(?:(?:nå|allerede)\s+)?(?:fullført|avsluttet)\s+(?:oppryddingen|slettingen|publiseringen)\b"#) { return true }
+            if has(#"\b(?:eierrollen|eierskapet|owner role|ownership)\s+(?:er|ble|is|was|has been)\s+(?:nå\s+|now\s+)?(?:overtatt|overført|tatt over|transferred|assumed)\b"#) { return true }
+            if has(#"\b(?:historikken|dialogene|samtalene|notatene|history|conversations|notes)(?:\s+(?:dine|your))?\s+(?:er|ble|is|was|has been|have been)\s+(?:nå\s+|now\s+)?(?:tømt|fjernet|ryddet|cleared|purged|removed)\b"#) { return true }
+            // Coordinated affirmative actions after a first-person clause.
+            if has(subject) && has(#"\b(?:og|and)\s+"# + modal + #"\s+"# + action + #"\b"#) { return true }
+            if has("^\\s*(?:(?:all|the|din|your)\\s+)?(?:historikken|historikk|history|dataene|data|tilgangen|tilgang|access|permission)\\b")
+                && has("\\b(?:er|ble|is|was|has been)\\s+(?:nå\\s+|now\\s+)?(?:slettet|deleted|erased|innvilget|granted|godkjent|approved|aktivert|enabled)\\b") { return true }
+            return has("\\bexplore\\s+(?:gir|grants|provides|tillater|allows)\\s+(?:(?:deg|meg|oss|you|me|us)\\s+)?(?:rett\\s+til|skrivetilgang|skriving|write|writing|permission|tilgang)\\b")
+        }
+    }
+}

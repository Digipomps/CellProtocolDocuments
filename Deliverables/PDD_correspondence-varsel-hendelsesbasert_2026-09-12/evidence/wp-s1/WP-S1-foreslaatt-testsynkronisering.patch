+  private func recipientFeedBarrierEvent() -> FlowElement {
+    var event = FlowElement(
+      title: "haven.assistant.correspondence.message.send",
+      content: .object([
+        "operation": .string("message.send"),
+        "message": .object(["recipientID": .string("feed-recipient")]),
+      ]), properties: FlowElement.Properties(type: .event, contentType: .object))
+    event.topic = AssistantCorrespondenceContracts.flowTopic
+    return event
+  }

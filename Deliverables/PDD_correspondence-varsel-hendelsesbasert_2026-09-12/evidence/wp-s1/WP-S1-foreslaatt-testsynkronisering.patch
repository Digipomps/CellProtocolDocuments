   func testExpiredOrRevokedGrantDeniesNewFeedAndStopsExistingSubscription() async throws {
+    // Revocation terminates a subscription. Expiry needs its own live subscription.
+    for revoke in [true, false] {
+      try await withRecipientFeedFixture { fixture in
+        let delivered = expectation(description: "Active feed delivers before authority changes")
+        let denied = expectation(description: "Existing feed terminates with StreamState.denied")
+        let recorder = AssistantCorrespondenceFlowRecorder()
+        let publisher = try await fixture.cell.flow(requester: fixture.recipient)
+        let subscription = publisher.sink(
+          receiveCompletion: { completion in
+            switch completion {
+            case .failure(StreamState.denied): denied.fulfill()
+            default: XCTFail("Expected StreamState.denied, got \(completion)")
+            }
+          },
+          receiveValue: { event in
+            recorder.append(event)
+            delivered.fulfill()
+          })
+        defer { subscription.cancel() }
+        let sent = try await submitFeedOperation(
+          "message.send", signer: fixture.sender,
+          arguments: arguments(
+            recipient: "feed-recipient", subject: "Before authority changes",
+            content: "test-only-secret-body", clientMessageID: "expiry-send"), fixture: fixture)
+        XCTAssertEqual(sent["status"]?.string, "sent")
+        await fulfillment(of: [delivered], timeout: 2)
+        let event = try XCTUnwrap(recorder.snapshot().first)
+        XCTAssertEqual(recorder.snapshot().count, 1)
+        if revoke {
+          setenv("HAVEN_ASSISTANT_CORRESPONDENCE_REVOKED_PRINCIPALS", "feed-recipient", 1)
+        } else {
+          fixture.clock.advance(by: 3601)
+        }
+        await assertFeedDenied(fixture.cell, requester: fixture.recipient)
+        try await emitOwnerFeedEvent(event, fixture: fixture)
+        await fulfillment(of: [denied], timeout: 2)
+        XCTAssertEqual(
+          recorder.snapshot().count, 1,
+          revoke ? "A live revoked feed must stop emitting" : "A live expired feed must stop emitting")
+      }
+    }
+  }

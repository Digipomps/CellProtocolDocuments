+            return XCTFail("Seal should still be present")
+        }
+        XCTAssertEqual(seal["trigger"], .string("onboarding"))
+    }
+
+    func testGenesisCannotBeRevokedOrOverwritten() async throws {
+        let (_, owner, anchor) = try await makeOwnerAndAnchor()
+        _ = try await anchor.set(keypath: "identityLinks.genesis", value: .string("onboarding"), requester: owner)
+        let linkID = "genesis-\(anchor.uuid)"
+
+        let revoke = try await anchor.set(keypath: "identityLinks.revoke", value: .string(linkID), requester: owner)
+        guard case let .object(revokeObject)? = revoke else {
+            return XCTFail("Expected an error object from revoke")
+        }
+        XCTAssertEqual(revokeObject["status"], .string("error"))
+        XCTAssertTrue((try? revokeObject["message"]?.stringValue())??.contains("cannotRevokeGenesisLink") == true)
+
+        let overwrite = try await anchor.set(
+            keypath: "identityLinks.genesis.trigger",
+            value: .string("directEdit"),
+            requester: owner
+        )
+        guard case let .object(overwriteObject)? = overwrite else {
+            return XCTFail("Expected an error object from overwrite")
+        }
+        XCTAssertEqual(overwriteObject["status"], .string("error"))
+        XCTAssertTrue((try? overwriteObject["message"]?.stringValue())??.contains("genesisKeypathIsImmutable") == true)
+
+        let sealed = try await state(anchor, requester: owner)
+        guard case let .object(seal)? = sealed["genesis"] else {
+            return XCTFail("Seal should still be present")
+        }
+        XCTAssertEqual(seal["trigger"], .string("onboarding"))
+    }
+
+    // MARK: linked identity through the real authorization path
+
+    func testLinkedSecondIdentityReadsAndWrites() async throws {
+        let (vault, owner, anchor) = try await makeOwnerAndAnchor()
+        _ = try await anchor.set(keypath: "identityLinks.genesis", value: .string("onboarding"), requester: owner)
+
+        // A second identity of the same entity, in the same vault: the Face ID identity.
+        let faceID = try XCTUnwrap(await vault.identity(for: "faceid", makeNewIfNotFound: true))
+
+        // Before any link exists, it is a stranger.
+        do {
+            _ = try await anchor.get(keypath: "person", requester: faceID)
+            XCTFail("Unlinked identity must not read entity data")
+        } catch {
+            // expected
+        }
+
+        // The owner records a link for it. Enrollment has its own tests; here
+        // the record is written through the owner's identityLinks grant.
+        let link = IdentityLinkRecord(
+            linkID: "link-faceid",
+            entityBinding: EntityBindingDescriptor(mode: .localEntityAnchor, entityAnchorReference: anchor.uuid),
+            linkedIdentity: try IdentityLinkProtocolService.descriptor(for: faceID),
+            approvedDomains: ["private"],
+            approvedIdentityContexts: [],
+            approvedScopes: EntityGenesisService.initiatorScopes,
+            issuerIdentityUUID: owner.uuid,
+            issuerType: .existingDevice,
+            status: .active,
+            linkedAt: IdentityLinkProtocolService.iso8601(Date())
+        )
+        _ = try await anchor.set(
+            keypath: "identityLinks.records.link-faceid",
+            value: try IdentityLinkProtocolService.value(from: link),
+            requester: owner
+        )
+
+        // Now it reads and writes as a representative of the entity.
+        _ = try await anchor.get(keypath: "person", requester: faceID)
+        _ = try await anchor.set(keypath: "person.nickname", value: .string("Ada"), requester: faceID)
+        XCTAssertEqual(try await anchor.get(keypath: "person.nickname", requester: owner), .string("Ada"))
+
+        // And the decision names the link, so the trace can too.
+        let decision = await anchor.authorizationDecision(requestedAccess: "r---", at: "person", for: faceID)
+        XCTAssertTrue(decision.allowed)
+        XCTAssertEqual(decision.path, .linkedIdentity)
+        XCTAssertEqual(decision.linkRef, "identitylink://link-faceid")
+    }
+
+    func testIdentityFromAnotherEntityIsRefused() async throws {
+        let (_, owner, anchor) = try await makeOwnerAndAnchor()
+        _ = try await anchor.set(keypath: "identityLinks.genesis", value: .string("onboarding"), requester: owner)
+
+        // Another entity: its own vault, its own keys.
+        let otherVault = MockIdentityVault()
+        let other = try XCTUnwrap(await otherVault.identity(for: "private", makeNewIfNotFound: true))
+
+        // Even a link record that names it does not help if the record is bound
+        // to another anchor — and a record it wrote itself can never appear
+        // here, because it has no write grant on this cell.
+        let foreignLink = IdentityLinkRecord(
+            linkID: "link-foreign",
+            entityBinding: EntityBindingDescriptor(mode: .localEntityAnchor, entityAnchorReference: "some-other-anchor"),
+            linkedIdentity: try IdentityLinkProtocolService.descriptor(for: other),
+            approvedDomains: ["private"],
+            approvedIdentityContexts: [],
+            approvedScopes: EntityGenesisService.initiatorScopes,
+            issuerIdentityUUID: other.uuid,
+            issuerType: .existingDevice,
+            status: .active,
+            linkedAt: IdentityLinkProtocolService.iso8601(Date())
+        )
+        _ = try await anchor.set(
+            keypath: "identityLinks.records.link-foreign",
+            value: try IdentityLinkProtocolService.value(from: foreignLink),
+            requester: owner
+        )
+
+        let decision = await anchor.authorizationDecision(requestedAccess: "r---", at: "person", for: other)
+        XCTAssertFalse(decision.allowed)
+        XCTAssertEqual(decision.path, .deniedNoGrant)
+        do {
+            _ = try await anchor.get(keypath: "person", requester: other)
+            XCTFail("Identity from another entity must not read entity data")
+        } catch {
+            // expected
+        }
+    }
+
+    func testLinkedIdentityWithoutKeyControlIsRefused() async throws {
+        let (vault, owner, anchor) = try await makeOwnerAndAnchor()
+        _ = try await anchor.set(keypath: "identityLinks.genesis", value: .string("onboarding"), requester: owner)
+        let faceID = try XCTUnwrap(await vault.identity(for: "faceid", makeNewIfNotFound: true))
+        let link = IdentityLinkRecord(
+            linkID: "link-faceid",
+            entityBinding: EntityBindingDescriptor(mode: .localEntityAnchor, entityAnchorReference: anchor.uuid),
+            linkedIdentity: try IdentityLinkProtocolService.descriptor(for: faceID),
+            approvedDomains: ["private"],
+            approvedIdentityContexts: [],
+            approvedScopes: EntityGenesisService.initiatorScopes,
+            issuerIdentityUUID: owner.uuid,
+            issuerType: .existingDevice,
+            status: .active,
+            linkedAt: IdentityLinkProtocolService.iso8601(Date())
+        )
+        _ = try await anchor.set(
+            keypath: "identityLinks.records.link-faceid",
+            value: try IdentityLinkProtocolService.value(from: link),
+            requester: owner
+        )
+
+        // Same UUID and public key as the linked identity, but no vault: it
+        // cannot answer the challenge. The link matches; the proof fails.
+        let claimant = Identity(faceID.uuid, displayName: "claimant", identityVault: nil)
+        claimant.publicSecureKey = faceID.publicSecureKey
+        let decision = await anchor.authorizationDecision(requestedAccess: "r---", at: "person", for: claimant)
+        XCTAssertFalse(decision.allowed)
+    }
+}
+#endif
diff --git a/Tests/CellBaseTests/EntityGenesisTests.swift b/Tests/CellBaseTests/EntityGenesisTests.swift
new file mode 100644
index 0000000..ff61ec2
--- /dev/null
+++ b/Tests/CellBaseTests/EntityGenesisTests.swift
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright (c) 2026 Stiftelsen Digipomps and HAVEN contributors
+
+import XCTest
+@testable import CellBase
+
+// purpose://candidate.entitetsdata.genesis-seals-to-initiator
+// test.entitet.genesis-once — the pure half. The cell-level half (a second
+// genesis against a sealed anchor is refused) lives in EntityAnchorGenesisTests.
+final class EntityGenesisTests: XCTestCase {
+
+    func testGenesisSealsToInitiatorAndVerifies() async throws {
+        let vault = OrganizerAccessTestIdentityVault()
+        let initiator = await vault.makeIdentity(displayName: "initiator")
+        let now = Date(timeIntervalSince1970: 1_800_000_000)
+
+        let result = try await EntityGenesisService.seal(
+            anchorID: "anchor-1",
+            initiator: initiator,
+            identityDomain: "private",
+            trigger: .addressBookImport,
+            now: now
+        )
+
+        // The record is a normal IdentityLinkRecord the authorizer can use.
+        XCTAssertEqual(result.record.linkID, "genesis-anchor-1")
+        XCTAssertEqual(result.record.entityBinding.mode, .localEntityAnchor)
+        XCTAssertEqual(result.record.entityBinding.entityAnchorReference, "anchor-1")
+        XCTAssertEqual(result.record.linkedIdentity.uuid, initiator.uuid)
+        XCTAssertEqual(result.record.issuerIdentityUUID, initiator.uuid)
+        XCTAssertEqual(result.record.issuerType, .existingDevice)
+        XCTAssertEqual(result.record.status, .active)
+        XCTAssertEqual(result.record.approvedDomains, ["private"])
+        XCTAssertEqual(Set(result.record.approvedScopes), Set(EntityGenesisService.initiatorScopes))
+
+        // The seal names the same link and carries a signature that verifies
+        // against the key in the record — not against anything in storage.
+        XCTAssertEqual(result.seal.linkID, result.record.linkID)
+        XCTAssertEqual(result.seal.trigger, .addressBookImport)
+        XCTAssertEqual(result.seal.initiatorIdentityUUID, initiator.uuid)
+        XCTAssertNotNil(result.seal.proof?.signature)
+        XCTAssertNoThrow(try EntityGenesisService.verify(seal: result.seal, record: result.record))
+    }
+
+    func testTamperedSealFailsVerification() async throws {
+        let vault = OrganizerAccessTestIdentityVault()
+        let initiator = await vault.makeIdentity(displayName: "initiator")
+        let result = try await EntityGenesisService.seal(
+            anchorID: "anchor-1",
+            initiator: initiator,
+            identityDomain: "private",
+            trigger: .onboarding
+        )
+
+        var tampered = result.seal
+        tampered.trigger = .directEdit
+        XCTAssertThrowsError(try EntityGenesisService.verify(seal: tampered, record: result.record)) { error in
+            XCTAssertEqual(error as? EntityGenesisError, .sealProofInvalid)
+        }
+
+        var stripped = result.seal
+        stripped.proof = nil
+        XCTAssertThrowsError(try EntityGenesisService.verify(seal: stripped, record: result.record)) { error in
+            XCTAssertEqual(error as? EntityGenesisError, .sealProofInvalid)
+        }
+    }
+
+    func testSealDoesNotVerifyAgainstAnotherIdentitysRecord() async throws {
+        let vault = OrganizerAccessTestIdentityVault()
+        let initiator = await vault.makeIdentity(displayName: "initiator")
+        let attacker = await vault.makeIdentity(displayName: "attacker")
+        let genuine = try await EntityGenesisService.seal(
+            anchorID: "anchor-1",
+            initiator: initiator,
+            identityDomain: "private",
+            trigger: .onboarding
+        )
+        let forged = try await EntityGenesisService.seal(
+            anchorID: "anchor-1",
+            initiator: attacker,
+            identityDomain: "private",
+            trigger: .onboarding
+        )
+
+        // Attacker swaps in their own record under the genuine seal: the seal
+        // names the initiator, the record names the attacker.
+        XCTAssertThrowsError(try EntityGenesisService.verify(seal: genuine.seal, record: forged.record)) { error in
+            XCTAssertEqual(error as? EntityGenesisError, .sealDoesNotMatchRecord("initiator"))
+        }
+    }
+
+    func testRecordBoundToAnotherAnchorIsRejected() async throws {
+        let vault = OrganizerAccessTestIdentityVault()
+        let initiator = await vault.makeIdentity(displayName: "initiator")
+        let result = try await EntityGenesisService.seal(
+            anchorID: "anchor-1",
+            initiator: initiator,
+            identityDomain: "private",
+            trigger: .onboarding
+        )
+        var moved = result.record
+        moved.entityBinding = EntityBindingDescriptor(mode: .localEntityAnchor, entityAnchorReference: "anchor-2")
+        XCTAssertThrowsError(try EntityGenesisService.verify(seal: result.seal, record: moved)) { error in
+            XCTAssertEqual(error as? EntityGenesisError, .sealDoesNotMatchRecord("entityBinding"))
+        }
+    }
+
+    func testInitiatorWithoutSigningKeyCannotSeal() async {
+        let keyless = Identity(UUID().uuidString, displayName: "keyless", identityVault: nil)
+        do {
+            _ = try await EntityGenesisService.seal(
+                anchorID: "anchor-1",
+                initiator: keyless,
+                identityDomain: "private",
+                trigger: .onboarding
+            )
+            XCTFail("Expected genesis to refuse an initiator without a signing key")
+        } catch let error as EntityGenesisError {
+            XCTAssertEqual(error, .initiatorHasNoSigningKey(keyless.uuid))
+        } catch {
+            XCTFail("Unexpected error \(error)")
+        }
+    }
+
+    func testGenesisKeypathsAreRecognisedAsImmutable() {
+        XCTAssertTrue(EntityGenesisService.isImmutableGenesisKeypath("identityLinks.genesis"))
+        XCTAssertTrue(EntityGenesisService.isImmutableGenesisKeypath("identityLinks.genesis.proof"))
+        XCTAssertFalse(EntityGenesisService.isImmutableGenesisKeypath("identityLinks.genesisX"))
+        XCTAssertFalse(EntityGenesisService.isImmutableGenesisKeypath("identityLinks.records.abc"))
+        XCTAssertTrue(EntityGenesisService.isGenesisLink("genesis-anchor-1"))
+        XCTAssertFalse(EntityGenesisService.isGenesisLink("approval-123"))
+    }
+}
diff --git a/Tests/CellBaseTests/EntityLinkAuthorizationTests.swift b/Tests/CellBaseTests/EntityLinkAuthorizationTests.swift
new file mode 100644
index 0000000..1c41a3d
--- /dev/null
+++ b/Tests/CellBaseTests/EntityLinkAuthorizationTests.swift
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright (c) 2026 Stiftelsen Digipomps and HAVEN contributors
+
+import XCTest
+@testable import CellBase
+
+// purpose://candidate.entitetsdata.authorization-resolves-entity
+// test.entitet.linked-identity-accepted and test.entitet.foreign-entity-refused,
+// the pure half. The cell-level half goes through EntityAnchorCell.validateAccess
+// in EntityAnchorGenesisTests, where the challenge-signature proof is also exercised.
+final class EntityLinkAuthorizationTests: XCTestCase {
+
+    private struct Fixture {
+        var vault: OrganizerAccessTestIdentityVault
+        var initiator: Identity
+        var faceID: Identity
+        var stranger: Identity
+        var genesis: EntityGenesisResult
+        var faceIDLink: IdentityLinkRecord
+    }
+
+    private func makeFixture(faceIDScopes: [String] = EntityGenesisService.initiatorScopes,
+                             faceIDDomains: [String] = ["private"],
+                             anchorID: String = "anchor-1") async throws -> Fixture {
+        let vault = OrganizerAccessTestIdentityVault()
+        let initiator = await vault.makeIdentity(displayName: "startup-identity")
+        let faceID = await vault.makeIdentity(displayName: "faceid-identity")
+        let stranger = await vault.makeIdentity(displayName: "someone-else")
+        let genesis = try await EntityGenesisService.seal(
+            anchorID: anchorID,
+            initiator: initiator,
+            identityDomain: "private",
+            trigger: .onboarding
+        )
+        // A link the initiator has issued to its own second identity. Enrollment
+        // has its own tests; here the record is the input.
+        let faceIDLink = IdentityLinkRecord(
+            linkID: "link-faceid",
+            entityBinding: EntityBindingDescriptor(mode: .localEntityAnchor, entityAnchorReference: anchorID),
+            linkedIdentity: try IdentityLinkProtocolService.descriptor(for: faceID),
+            approvedDomains: faceIDDomains,
+            approvedIdentityContexts: [],
+            approvedScopes: faceIDScopes,
+            issuerIdentityUUID: initiator.uuid,
+            issuerType: .existingDevice,
+            status: .active,
+            linkedAt: IdentityLinkProtocolService.iso8601(Date())
+        )
+        return Fixture(vault: vault, initiator: initiator, faceID: faceID, stranger: stranger,
+                       genesis: genesis, faceIDLink: faceIDLink)
+    }
+
+    private enum SealChoice {
+        case fixture
+        case none
+        case custom(EntityGenesisSeal)
+    }
+
+    private func authorize(_ f: Fixture, requester: Identity, access: String = "rw--",
+                           records: [IdentityLinkRecord]? = nil, anchorID: String = "anchor-1",
+                           domain: String = "private", seal: SealChoice = .fixture)
+        -> Result<EntityLinkAuthorization, EntityLinkAuthorizationRefusal> {
+        let genesisSeal: EntityGenesisSeal?
+        switch seal {
+        case .fixture: genesisSeal = f.genesis.seal
+        case .none: genesisSeal = nil
+        case .custom(let custom): genesisSeal = custom
+        }
+        return EntityLinkAuthorizer.authorize(
+            requestedAccess: access,
+            requester: requester,
+            identityDomain: domain,
+            anchorID: anchorID,
+            records: records ?? [f.genesis.record, f.faceIDLink],
+            genesisSeal: genesisSeal
+        )
+    }
+
+    // MARK: linked identity accepted
+
+    func testSecondIdentityOfSameEntityIsAccepted() async throws {
+        let f = try await makeFixture()
+        switch authorize(f, requester: f.faceID) {
+        case .success(let auth):
+            XCTAssertEqual(auth.linkID, "link-faceid")
+            XCTAssertFalse(auth.isGenesis)
+            XCTAssertEqual(auth.linkRef, "identitylink://link-faceid")
+        case .failure(let refusal):
+            XCTFail("Expected the Face ID identity to be accepted, got \(refusal)")
+        }
+    }
+
+    func testInitiatorIsAcceptedThroughGenesisLinkWhenSealVerifies() async throws {
+        let f = try await makeFixture()
+        switch authorize(f, requester: f.initiator) {
+        case .success(let auth):
+            XCTAssertTrue(auth.isGenesis)
+            XCTAssertEqual(auth.linkID, "genesis-anchor-1")
+        case .failure(let refusal):
+            XCTFail("Expected initiator through genesis link, got \(refusal)")
+        }
+    }
+
+    func testReadOnlyLinkAcceptsReadAndRefusesWrite() async throws {
+        let f = try await makeFixture(faceIDScopes: [EntityLinkScope.read.rawValue])
+        if case .failure(let r) = authorize(f, requester: f.faceID, access: "r---") {
+            XCTFail("Read should be covered, got \(r)")
+        }
+        XCTAssertEqual(
+            authorize(f, requester: f.faceID, access: "-w--").failureValue,
+            .scopeNotCovered(linkID: "link-faceid", missing: ["entity.write"])
+        )
+    }
+
+    // MARK: foreign entity refused
+
+    func testIdentityWithNoLinkIsRefused() async throws {
+        let f = try await makeFixture()
+        XCTAssertEqual(authorize(f, requester: f.stranger).failureValue, .noLinkForRequester)
+    }
+
+    func testSameUUIDWithDifferentKeyIsRefused() async throws {
+        let f = try await makeFixture()
+        // Same UUID as the Face ID identity, attacker's key.
+        let impostor = Identity(f.faceID.uuid, displayName: "impostor", identityVault: f.vault)
+        impostor.publicSecureKey = f.stranger.publicSecureKey
+        XCTAssertEqual(
+            authorize(f, requester: impostor).failureValue,
+            .linkKeyMismatch(linkID: "link-faceid")
+        )
+    }
+
+    func testRevokedLinkIsRefused() async throws {
+        let f = try await makeFixture()
+        var revoked = f.faceIDLink
+        revoked.status = .revoked
+        revoked.revokedAt = IdentityLinkProtocolService.iso8601(Date())
+        XCTAssertEqual(
+            authorize(f, requester: f.faceID, records: [f.genesis.record, revoked]).failureValue,
+            .linkNotActive(linkID: "link-faceid", status: .revoked)
+        )
+    }
+
+    func testLinkBoundToAnotherAnchorIsRefused() async throws {
+        let f = try await makeFixture()
+        var elsewhere = f.faceIDLink
+        elsewhere.entityBinding = EntityBindingDescriptor(mode: .localEntityAnchor, entityAnchorReference: "anchor-2")
+        XCTAssertEqual(
+            authorize(f, requester: f.faceID, records: [f.genesis.record, elsewhere]).failureValue,
+            .boundToAnotherEntity(linkID: "link-faceid")
+        )
+    }
+
+    func testPairwiseBindingDoesNotOpenTheAnchor() async throws {
+        let f = try await makeFixture()
+        var pairwise = f.faceIDLink
+        pairwise.entityBinding = EntityBindingDescriptor(mode: .pairwise, bindingID: "b1", audience: "register")
+        XCTAssertEqual(
+            authorize(f, requester: f.faceID, records: [f.genesis.record, pairwise]).failureValue,
+            .boundToAnotherEntity(linkID: "link-faceid")
+        )
+    }
+
+    func testWrongIdentityDomainIsRefused() async throws {
+        let f = try await makeFixture(faceIDDomains: ["scaffold"])
+        XCTAssertEqual(
+            authorize(f, requester: f.faceID).failureValue,
+            .domainNotCovered(linkID: "link-faceid", domain: "private")
+        )
+    }
+
+    func testGenesisLinkWithoutVerifiedSealIsRefused() async throws {
+        let f = try await makeFixture()
+        XCTAssertEqual(
+            authorize(f, requester: f.initiator, seal: .none).failureValue,
+            .genesisNotVerified(linkID: "genesis-anchor-1")
+        )
+        var tampered = f.genesis.seal
+        tampered.trigger = .fileUpload
+        XCTAssertEqual(
+            authorize(f, requester: f.initiator, seal: .custom(tampered)).failureValue,
+            .genesisNotVerified(linkID: "genesis-anchor-1")
+        )
+    }
+
+    func testActiveLinkWinsOverStaleRevokedOneForSameIdentity() async throws {
+        let f = try await makeFixture()
+        var stale = f.faceIDLink
+        stale.linkID = "link-faceid-old"
+        stale.status = .revoked
+        switch authorize(f, requester: f.faceID, records: [stale, f.genesis.record, f.faceIDLink]) {
+        case .success(let auth): XCTAssertEqual(auth.linkID, "link-faceid")
+        case .failure(let r): XCTFail("Active link should win, got \(r)")
+        }
+    }
+
+    func testRequiredScopesFollowPermissionString() {
+        XCTAssertEqual(EntityLinkScope.required(for: "r---"), [.read])
+        XCTAssertEqual(EntityLinkScope.required(for: "-w--"), [.write])
+        XCTAssertEqual(EntityLinkScope.required(for: "rw--"), [.read, .write])
+        XCTAssertEqual(EntityLinkScope.required(for: "----"), [])
+    }
+}
+
+private extension Result {
+    var failureValue: Failure? {
+        if case .failure(let f) = self { return f }
+        return nil
+    }
+}

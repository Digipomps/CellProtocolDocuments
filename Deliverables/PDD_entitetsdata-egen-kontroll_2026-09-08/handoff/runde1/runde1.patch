index 0000000..07ede85
--- /dev/null
+++ b/Sources/CellBase/Identity/EntityLinkAuthorization.swift
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright (c) 2026 Stiftelsen Digipomps and HAVEN contributors
+
+import Foundation
+
+// purpose://candidate.entitetsdata.authorization-resolves-entity
+//
+// The Entity is the unit of ownership. Identities are its representatives.
+// Until now the authorization path only recognised the one stored owner
+// identity, so a second identity of the same entity — the Face ID identity
+// next to the startup identity — was treated as a stranger.
+//
+// This is the lookup that fixes it. Given the identity links an anchor holds,
+// it answers: is this requester a linked representative of the entity that
+// owns the cell, and does the link cover what is being asked?
+//
+// Four checks, in the order the spec names them:
+//   1. the requester's signing key is the one in the link
+//   2. the link is active and not revoked
+//   3. the requested access is inside the link's scopes and domain
+//   4. the link binds to this anchor's entity
+//
+// What this cannot do is prove the requester *controls* that key. That is a
+// challenge-signature check the cell must run afterwards; see
+// `EntityLinkAuthorizer.authorize` documentation. A match here without that
+// proof is a claim, not evidence.
+
+public enum EntityLinkScope: String, Codable, Sendable, CaseIterable {
+    case read = "entity.read"
+    case write = "entity.write"
+    case issueLinks = "identityLinks.issue"
+
+    /// The scope a permission string needs. Permission strings follow the
+    /// existing grant format: position 0 is read, position 1 is write.
+    public static func required(for requestedAccess: String) -> Set<EntityLinkScope> {
+        var needed = Set<EntityLinkScope>()
+        let chars = Array(requestedAccess)
+        if chars.count > 0, chars[0] == "r" { needed.insert(.read) }
+        if chars.count > 1, chars[1] == "w" { needed.insert(.write) }
+        return needed
+    }
+}
+
+public enum EntityLinkAuthorizationRefusal: Equatable, Sendable {
+    case noLinkForRequester
+    case linkKeyMismatch(linkID: String)
+    case linkNotActive(linkID: String, status: IdentityLinkStatus)
+    case scopeNotCovered(linkID: String, missing: [String])
+    case domainNotCovered(linkID: String, domain: String)
+    case boundToAnotherEntity(linkID: String)
+    case genesisNotVerified(linkID: String)
+}
+
+public struct EntityLinkAuthorization: Equatable, Sendable {
+    public var linkID: String
+    public var scopes: [String]
+    public var domain: String
+    public var isGenesis: Bool
+
+    public var linkRef: String { "identitylink://\(linkID)" }
+}
+
+public enum EntityLinkAuthorizer {
+    /// Pure lookup. Returns the link that covers the request, or the first
+    /// reason it does not. Runs no cryptography except, for a genesis link,
+    /// verifying the stored seal — that one is cheap and the seal is the
+    /// root everything else hangs from.
+    ///
+    /// The caller MUST then prove key control for the requester
+    /// (`GeneralCell.verifyRequesterIdentityControl`) before granting.
+    public static func authorize(
+        requestedAccess: String,
+        requester: Identity,
+        identityDomain: String,
+        anchorID: String,
+        records: [IdentityLinkRecord],
+        genesisSeal: EntityGenesisSeal?
+    ) -> Result<EntityLinkAuthorization, EntityLinkAuthorizationRefusal> {
+        let candidates = records.filter { $0.linkedIdentity.uuid == requester.uuid }
+        guard candidates.isEmpty == false else {
+            return .failure(.noLinkForRequester)
+        }
+
+        // Several links may exist for one identity (an old revoked one next to
+        // a fresh one). The first that passes every check wins; if none does,
+        // the first candidate's refusal is reported so the reason is stable.
+        var firstRefusal: EntityLinkAuthorizationRefusal?
+        for record in candidates {
+            switch check(
+                record: record,
+                requestedAccess: requestedAccess,
+                requester: requester,
+                identityDomain: identityDomain,
+                anchorID: anchorID,
+                genesisSeal: genesisSeal
+            ) {
+            case .success(let authorization):
+                return .success(authorization)
+            case .failure(let refusal):
+                if firstRefusal == nil { firstRefusal = refusal }
+            }
+        }
+        return .failure(firstRefusal ?? .noLinkForRequester)
+    }
+
+    private static func check(
+        record: IdentityLinkRecord,
+        requestedAccess: String,
+        requester: Identity,
+        identityDomain: String,
+        anchorID: String,
+        genesisSeal: EntityGenesisSeal?
+    ) -> Result<EntityLinkAuthorization, EntityLinkAuthorizationRefusal> {
+        // 1. Same signing key, not just same UUID. UUID equality is never ownership.
+        guard let requesterKey = requester.publicSecureKey?.compressedKey,
+              requesterKey.isEmpty == false,
+              requesterKey == record.linkedIdentity.publicKey else {
+            return .failure(.linkKeyMismatch(linkID: record.linkID))
+        }
+
+        // 2. Active. A revoked or pending link grants nothing.
+        guard record.status == .active, record.revokedAt == nil else {
+            return .failure(.linkNotActive(linkID: record.linkID, status: record.status))
+        }
+
+        // 3. Scope and domain.
+        let needed = EntityLinkScope.required(for: requestedAccess)
+        let held = Set(record.approvedScopes)
+        let missing = needed.filter { !held.contains($0.rawValue) }.map(\.rawValue).sorted()
+        guard missing.isEmpty else {
+            return .failure(.scopeNotCovered(linkID: record.linkID, missing: missing))
+        }
+        guard record.approvedDomains.contains(identityDomain) else {
+            return .failure(.domainNotCovered(linkID: record.linkID, domain: identityDomain))
+        }
+
+        // 4. Bound to this anchor's entity. Pairwise and blinded bindings are
+        //    for proving membership to *others*; they do not open the anchor.
+        guard record.entityBinding.mode == .localEntityAnchor,
+              record.entityBinding.entityAnchorReference == nil
+                || record.entityBinding.entityAnchorReference == anchorID else {
+            return .failure(.boundToAnotherEntity(linkID: record.linkID))
+        }
+
+        let isGenesis = EntityGenesisService.isGenesisLink(record.linkID)
+        if isGenesis {
+            guard let seal = genesisSeal else {
+                return .failure(.genesisNotVerified(linkID: record.linkID))
+            }
+            do {
+                try EntityGenesisService.verify(seal: seal, record: record)
+            } catch {
+                return .failure(.genesisNotVerified(linkID: record.linkID))
+            }
+        }
+
+        return .success(EntityLinkAuthorization(
+            linkID: record.linkID,
+            scopes: record.approvedScopes,
+            domain: identityDomain,
+            isGenesis: isGenesis
+        ))
+    }
+}

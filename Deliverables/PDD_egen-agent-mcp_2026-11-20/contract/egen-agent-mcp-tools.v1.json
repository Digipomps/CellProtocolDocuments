{
  "schema": "haven.own-agent-mcp.tools.v1",
  "status": "utkast — PDD_egen-agent-mcp_2026-11-20, venter på G2; ikke i kode",
  "transport": "MCP over stdio; adapteren kobler seg ut til CellScaffold /bridgehead/session",
  "tools": [
    {"name": "haven_docs_search", "access": "read", "source": "HavenDocsMCP (uendret)", "needsDelegation": false},
    {"name": "haven_docs_read", "access": "read", "source": "HavenDocsMCP (uendret)", "needsDelegation": false},
    {"name": "haven_my_documents_list", "access": "read", "purposeRef": "purpose://candidate.egen-agent-mcp.read-documents",
     "output": {"items": [{"cell": "cell:///<uuid>", "documentID": "string", "title": "string", "version": "int", "owner": "self|<visningsnavn>"}]}},
    {"name": "haven_document_read", "access": "read", "purposeRef": "purpose://candidate.egen-agent-mcp.read-documents",
     "input": {"cell": "string", "documentID": "string"},
     "output": {"cell": "string", "documentID": "string", "version": "int", "text": "string", "withheld": ["string"]}},
    {"name": "haven_draft_save", "access": "write", "readOnlyHint": false, "destructiveHint": false, "purposeRef": "purpose://candidate.egen-agent-mcp.write-back",
     "input": {"title": "string", "text": "string", "basedOn": "cell:///<uuid> (valgfri)"},
     "output": {"cell": "string", "documentID": "string", "status": "draft"}},
    {"name": "haven_chat_read", "access": "read", "purposeRef": "purpose://candidate.egen-agent-mcp.others-consent",
     "input": {"cell": "string", "limit": "int ≤ 50"},
     "output": {"messages": [{"author": "self|<visningsnavn>", "text": "string"}], "withheldCount": "int", "withheldReason": "recipient_not_allowed"}},
    {"name": "haven_research_data_get", "access": "read", "purposeRef": "purpose://candidate.egen-agent-mcp.research-data-level",
     "input": {"cell": "string", "level": "N0|N1|N2|N3|N4"}}
  ],
  "refusalCodes": [
    "delegation_missing", "extension_revoked", "extension_expired", "agreement_not_met",
    "recipient_not_allowed", "research_level_exceeded", "write_not_allowed", "not_available"
  ],
  "agentDelegation": {
    "fields": ["version", "delegationID", "principalIdentityUUID", "agentPublicKey", "agentFingerprint", "deviceLabel", "platform",
               "recipient (local|anthropic|openai)", "cells [{cell, grants [keypath, permission], researchLevel?}]",
               "createdAt", "validUntil", "revocationReference", "proof (studentens signatur + fersk passkey-bevis)"],
    "rule": "En delegering gir aldri mer enn rektor selv har i cellens Agreement, og aldri skrivetilgang utover å lage utkast i egne celler."
  },
  "conditions": {
    "DelegatedAgentCondition": "Spørreren er agentnøkkelen i en gyldig, ikke trukket AgentDelegation; rektor oppfyller resten av Agreementet; tillatelsen ligger innenfor både delegeringen og Agreementet.",
    "RecipientCondition": "allowedRecipients: [local, anthropic, openai, ...] og valgfri region. Mangler vilkåret, får en agent nei."
  }
}

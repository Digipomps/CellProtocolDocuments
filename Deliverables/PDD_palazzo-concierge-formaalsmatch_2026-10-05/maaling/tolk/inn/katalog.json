{
 "versjon": "emner-v1-forslag-20261007",
 "formaal": [
  {
   "id": "spise",
   "maal": "Retten er servert til gjesten",
   "former": "«jeg vil ha …», «jeg har lyst på …», «kan jeg få …», «noe med …»"
  },
  {
   "id": "drikke",
   "maal": "Drikken er servert til gjesten",
   "former": "«noe å drikke», «har dere eplemost», «hva kan jeg drikke»"
  },
  {
   "id": "vite",
   "maal": "Gjesten har fått svaret fra husets data",
   "former": "«hva er …», «fortell om …», «hvilke … har dere», «har dere …»"
  },
  {
   "id": "unngaa",
   "maal": "Gjesten har fått merkingen og beskrivelsen for det hun spør om, og er vist til personalet",
   "former": "«jeg tåler ikke …», «jeg er allergisk mot …», «jeg spiser ikke …», «uten …»"
  },
  {
   "id": "bord",
   "maal": "Gjesten har fått vite hvordan hun bestiller bord",
   "former": "«bestille bord», «booke», «reservere»"
  },
  {
   "id": "aapningstid",
   "maal": "Gjesten har fått åpningstiden, eller beskjed om at den må bekreftes",
   "former": "«når åpner dere», «åpningstider», «har dere åpent»"
  },
  {
   "id": "selv",
   "maal": "(ikke et formål) Gjesten forteller bare noe om seg selv, hva hun liker eller ikke liker, uten å be om noe",
   "former": "«jeg er veldig glad i …», «… er ikke helt min greie»"
  },
  {
   "id": "ingen",
   "maal": "Setningen ber ikke om noe av det over: småprat, noe utenfor huset, eller uforståelig",
   "former": ""
  }
 ],

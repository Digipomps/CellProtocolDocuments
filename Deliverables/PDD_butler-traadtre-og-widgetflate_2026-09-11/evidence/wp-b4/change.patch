+++ b/Public/css/porthole-webo.css
@@ -2378,6 +2378,31 @@ body.panel-resizing * {
   align-items: center;
 }
 
+/* WP-B4 paritet med CellApple: en stakk har alltid full bredde i en kolonne
+   (.frame(maxWidth: .infinity)); maxWidthInfinity fyller bredden i en kolonne og
+   maxHeightInfinity høyden i en rad. Fast bredde/høyde på elementet vinner fortsatt. */
+[data-axis="column"] > .skeleton-hstack,
+[data-axis="column"] > .skeleton-vstack,
+[data-axis="column"] > [data-fill-width="true"],
+.skeleton-scroll-view:not(.scroll-axis-horizontal) > .skeleton-hstack,
+.skeleton-scroll-view:not(.scroll-axis-horizontal) > .skeleton-vstack,
+.skeleton-scroll-view:not(.scroll-axis-horizontal) > [data-fill-width="true"],
+[data-axis="row"] > [data-fill-height="true"] {
+  align-self: stretch;
+}
+
+/* WP-B4 paritet: TextArea med egen boks i skjelettet — feltet inni har ingen egen ramme. */
+.skeleton-textarea-boxed > .skeleton-textarea {
+  border: 0 !important;
+  border-radius: 0 !important;
+  background: transparent !important;
+  box-shadow: none !important;
+}
+
+.skeleton-textarea-boxed:focus-within {
+  box-shadow: 0 0 0 2px rgba(127, 214, 208, 0.28);
+}
+
 .skeleton-vstack[hidden],
 .skeleton-hstack[hidden],
 .skeleton-grid[hidden],
@@ -4802,27 +4827,28 @@ body.skeleton-presentation-scroll-locked {

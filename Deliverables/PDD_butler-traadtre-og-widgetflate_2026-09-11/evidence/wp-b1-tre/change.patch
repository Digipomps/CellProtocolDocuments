     // §5 test.tree-model: stable root, three levels, shared tool, transactional cycle rejection.
+    func testTreeRowsCarryLevelInsetAndStateBackground() throws {
+        var tree = PersonalCopilotHelperTree.migrating(helperRows: [
+            ["id": .string("docs-rag"), "title": .string("Kilder")]
+        ])
+        XCTAssertNil(tree.apply(action: "open", payload: .object([:])))
+        guard case let .object(projected)? = tree.project(into: [:])["helperTree"],
+              case let .list(rows)? = projected["visibleRows"] else {
+            return XCTFail("Expected visibleRows")
+        }
+        let objects = rows.compactMap { value -> Object? in if case let .object(row) = value { return row }; return nil }
+        XCTAssertEqual(objects.count, rows.count)
+        XCTAssertFalse(objects.isEmpty)
+        for row in objects {
+            guard case let .integer(level)? = row["level"], case let .integer(visualDepth)? = row["visualDepth"],
+                  case let .integer(inset)? = row["leadingInset"], case let .string(background)? = row["rowBackground"],
+                  case let .string(state)? = row["rowState"] else {
+                return XCTFail("Missing Tree fields in \(row)")
+            }
+            XCTAssertGreaterThanOrEqual(level, 1)
+            XCTAssertEqual(inset, [3, 11, 27][visualDepth])
+            XCTAssertEqual(background, ["selected": "#e8f1f9", "inscope": "#f3f8fc", "normal": "#ffffff"][state])
+        }
+        XCTAssertEqual(objects.first?["level"], .integer(1), "Root is level 1")
+    }
+

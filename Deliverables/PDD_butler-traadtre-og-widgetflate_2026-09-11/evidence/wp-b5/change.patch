+            $0.itemSpacing = 0
+        }
+        return .List(list)
+    }
+
+    // MARK: - Meldingsraden
+
+    /// Én rad i loggen: avatar + navn + tid + grenchip, tekst, status, svarhandlinger og kort.
+    /// Radtypen `branchStart` (cellen legger den inn der en gren begynner i skopets logg)
+    /// vises som en skillelinje «gren startet · …».
+    static func butlerMessageRow(actions: SkeletonElement, cards: SkeletonElement) -> SkeletonVStack {
+        let initials = butlerText(keypath: "initials", size: 10.5, weight: "700", color: "#ffffff") {
+            $0.styleRole = "butler-avatar-initials"
+        }
+        let disc = butlerVStack([initials]) {
+            $0.width = 28
+            $0.height = 28
+            $0.cornerRadius = 14
+            $0.background = ButlerWorkbenchStyle.accent
+            $0.backgroundKeypath = "avatarColor"
+            $0.hAlignment = "center"
+            $0.vAlignment = "center"
+        }
+        // Ytre kolonne holder avataren øverst i raden.
+        let avatar = butlerVStack([disc]) {
+            $0.width = 28
+            $0.vAlignment = "top"
+        }
+        let heading = butlerHStack([
+            butlerText(keypath: "speaker", size: 13.5, weight: "700"),
+            butlerText(keypath: "timeLabel", size: 11.5, color: ButlerWorkbenchStyle.faint),

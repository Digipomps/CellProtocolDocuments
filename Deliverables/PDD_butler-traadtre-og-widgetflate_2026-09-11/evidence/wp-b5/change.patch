@@ -0,0 +1,44 @@
+/* Co-Pilot Chat (Butler) — lys arbeidsflate etter mockupen (WP-B5, PDD
+   butler-traadtre-og-widgetflate, referanse images/web-fylt-v1.png).
+   Lastes av Porthole bare for denne konfigurasjonen (syncConfigurationTheme).
+   Farger, størrelser og avstander i flaten kommer fra skjelettets modifikatorer, så web
+   og app tolker dem likt (WP-B4). Her står bare vertsrammen: lyst lerret i stedet for
+   product-view sitt mørke tema, og web-spesifikke klasser (radklasser, fanelinje). */
+
+.canvas.product-view.view-mode { background: #f4f7fa; border-color: #d5e0eb; box-shadow: none; }
+.canvas.product-view .skeleton-host { padding: 16px; }
+.canvas.product-view .skeleton-host > .style-role-butler-workbench { max-width: none; margin: 0; height: 100%; box-sizing: border-box; flex-wrap: nowrap; }
+
+/* product-view sitt mørke tema nullstilles til Porthole sin lyse grunnstil. */
+.canvas.product-view .skeleton-section { border: 0; border-radius: 0; background: transparent; color: #17212b; box-shadow: none; }
+.canvas.product-view .skeleton-section-header { border-bottom-color: #d5e0eb; }
+.canvas.product-view .skeleton-text { color: #17212b; }
+.canvas.product-view .skeleton-vstack { gap: 10px; }
+.canvas.product-view .skeleton-hstack { flex-wrap: nowrap; }
+.canvas.product-view .skeleton-button,
+.canvas.product-view .skeleton-list-row-action { border: 1px solid #d5e0eb; border-radius: 6px; background: #ffffff; color: #17212b; box-shadow: none; font-size: 13px; padding: 5px 10px; }
+.canvas.product-view .skeleton-divider { border-top-color: #e3eaf1; margin: 0; }
+
+/* Fanene Samtale/Aktivt/Mer som liten velger i chat-panelet. */
+.canvas.product-view .style-role-butler-chat-tabs { display: flex; flex-direction: column; gap: 0; min-height: 0; }
+.canvas.product-view .style-role-butler-chat-tabs > .skeleton-tabs-list { margin: 8px 16px 0; padding: 2px; gap: 2px; border: 1px solid #d5e0eb; border-radius: 7px; background: #f1f5f9; align-self: flex-start; }
+.canvas.product-view .style-role-butler-chat-tabs .skeleton-tabs-tab { color: #556273; padding: 3px 11px; font-weight: 600; font-size: 12px; border-radius: 5px; transform: none; }
+.canvas.product-view .style-role-butler-chat-tabs .skeleton-tabs-tab:hover { background: #ffffff; color: #17212b; border-color: transparent; transform: none; }
+.canvas.product-view .style-role-butler-chat-tabs .skeleton-tabs-tab[aria-selected="true"] { background: #ffffff; color: #17212b; border-color: #d5e0eb; box-shadow: none; }
+.canvas.product-view .style-role-butler-chat-tabs > .skeleton-tabs-panel { flex: 1; min-height: 0; display: flex; flex-direction: column; overflow: auto; }
+.canvas.product-view .style-role-butler-chat-tabs .style-role-chat-conversation,
+.canvas.product-view .style-role-butler-chat-tabs .style-role-chat-conversation > .skeleton-section-content { flex: 1; min-height: 0; display: flex; flex-direction: column; }
+
+/* Meldinger som rader med avatar, ikke bobler (porthole-webo.css gir chatradene bobler). */
+.canvas.product-view .style-role-chat-prompt-log .skeleton-list-row-main,
+.canvas.product-view .style-role-chat-prompt-log .chat-prompt-row-user .skeleton-list-row-main,
+.canvas.product-view .style-role-chat-prompt-log .chat-prompt-row-assistant .skeleton-list-row-main { background: transparent; border: 0; border-left: 0; box-shadow: none; margin: 0; padding: 0; max-width: none; }
+.canvas.product-view .style-role-chat-prompt-log .chat-prompt-row-assistant .skeleton-text:first-child,
+.canvas.product-view .style-role-chat-prompt-log .chat-prompt-row-user .skeleton-text:first-child { font-size: inherit; opacity: 1; }
+.canvas.product-view .style-role-chat-prompt-log .style-role-assistant-response-actions { margin-top: 6px; }
+
+/* Skrivefeltet: én linje, systemskrift, uten «>». Boksen er TextArea-modifikatorene. */
+.canvas.product-view .style-role-chat-composer.skeleton-textarea-wrapper::before { content: none; }
+.canvas.product-view .style-role-chat-composer.skeleton-textarea { padding: 0; min-height: 20px; line-height: 1.45; font-family: inherit; resize: none; color: #17212b; outline: none; }
+.canvas.product-view .style-role-chat-composer.skeleton-textarea::placeholder { color: #8391a1; opacity: 1; }
+.canvas.product-view .style-role-chat-composer-dock { background: #ffffff; position: static; }

+        columnModifiers.styleClasses = ["butler-canvas-column"]
+        columnModifiers.width = 370
+        columnModifiers.minHeight = 0
+        columnModifiers.maxHeightInfinity = true
+        let canvasColumn = SkeletonElement.VStack(SkeletonVStack(
+            elements: [componentPanel, widgetCanvas()], spacing: 12, modifiers: columnModifiers

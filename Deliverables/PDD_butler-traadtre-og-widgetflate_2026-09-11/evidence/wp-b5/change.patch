+            $0.maxWidthInfinity = true
+        }
+        return butlerPanel(role: "butler-tree-panel", elements: [
+            header, .Divider(SkeletonDivider()), .ScrollView(scroll), .Divider(SkeletonDivider()), footer
+        ]) {
+            $0.width = 290
+        }
+    }
+
+    /// Chat-hodet: tittel, tellere og skopvelger på én linje; skopbeskrivelse og grenchips under.
+    static func butlerChatHeader() -> SkeletonElement {
+        var titleLine: SkeletonElementList = [
+            butlerText(keypath: "title", size: 14, weight: "700"),
+            .Spacer(SkeletonSpacer()),

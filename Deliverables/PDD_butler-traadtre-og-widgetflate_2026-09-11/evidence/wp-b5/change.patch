diff --git a/Tests/AppTests/PersonalCopilotWorkbenchTests.swift b/Tests/AppTests/PersonalCopilotWorkbenchTests.swift
new file mode 100644
index 00000000..5a6bcf9e
--- /dev/null
+++ b/Tests/AppTests/PersonalCopilotWorkbenchTests.swift
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright (c) 2026 Stiftelsen Digipomps and HAVEN contributors
+
+@testable import App
+import XCTest
+import CellBase
+import Foundation
+
+/// WP-B5: det meldingsraden og chat-hodet i Butler-arbeidsflaten trenger fra cellen.
+final class PersonalCopilotWorkbenchTests: XCTestCase {
+    func testInitialsAndTimeLabel() {
+        XCTAssertEqual(PersonalCopilotChatPresentation.initials("Kjetil Hustveit"), "KH")
+        XCTAssertEqual(PersonalCopilotChatPresentation.initials("Butler"), "B")
+        XCTAssertEqual(PersonalCopilotChatPresentation.initials("Du"), "D")
+        XCTAssertEqual(PersonalCopilotChatPresentation.initials("  "), "")
+        // 07:12Z er 09:12 i Oslo om sommeren.
+        XCTAssertEqual(PersonalCopilotChatPresentation.timeLabel("2026-09-19T07:12:00Z"), "09:12")
+        XCTAssertEqual(PersonalCopilotChatPresentation.timeLabel("2026-09-19T07:12:00.250Z"), "09:12")
+        XCTAssertEqual(PersonalCopilotChatPresentation.timeLabel("ikke en dato"), "")
+    }
+
+    func testDismissLabelOnlyOnTheOpenSuggestionRow() {
+        let ui: Object = ["promptMessages": .list([
+            .object(["id": .string("assistant-old"), "dismissActionLabel": .string("Avvis")]),
+            .object(["id": .string("prompt-1")]),
+            .object(["id": .string("assistant-open")])
+        ])]
+        func labels(_ object: Object) -> [String?] {
+            guard case let .list(rows)? = object["promptMessages"] else { return [] }
+            return rows.map { value -> String? in
+                guard case let .object(row) = value else { return nil }
+                return row["dismissActionLabel"]?.string
+            }
+        }
+        XCTAssertEqual(labels(PersonalCopilotChatPresentation.markingOpenSuggestion(ui, rowID: "assistant-open")), [nil, nil, "Avvis"])
+        XCTAssertEqual(labels(PersonalCopilotChatPresentation.markingOpenSuggestion(ui, rowID: nil)), [nil, nil, nil])
+    }
+
+    func testScopedLogMarksWhereABranchStartsAndCountsOnlyMessages() throws {
+        var tree = PersonalCopilotHelperTree.migrating(helperRows: [["id": .string("invite"), "title": .string("Inviter")]])
+        func message(_ id: String, _ node: String, _ minute: Int) -> ValueType {
+            .object(["id": .string(id), "role": .string("user"), "nodeID": .string(node),
+                     "createdAt": .string(String(format: "2026-09-19T07:%02d:00Z", minute))])
+        }
+        let source: Object = ["promptMessages": .list([
+            message("m1", PersonalCopilotHelperTree.rootID, 10),
+            message("m2", "helper-invite", 20),
+            message("m3", "helper-invite", 21),
+            message("m4", PersonalCopilotHelperTree.rootID, 26)
+        ])]
+        func rows(_ ui: Object) -> [Object] {
+            guard case let .list(values)? = ui["promptMessages"] else { return [] }
+            return values.compactMap { if case let .object(row) = $0 { return row } else { return nil } }
+        }
+
+        let atRoot = tree.project(into: source)
+        XCTAssertEqual(rows(atRoot).map { $0["id"]?.string ?? "" }, ["m1", "branch-start-helper-invite", "m2", "m3", "m4"])
+        let separator = rows(atRoot)[1]
+        XCTAssertEqual(separator["kind"], .string("branchStart"))
+        XCTAssertEqual(separator["label"], .string("gren startet · Inviter"))
+        XCTAssertEqual(atRoot["promptMessageCount"], .integer(4), "The separator is not a message")
+        guard case let .list(panels)? = atRoot["chatPanelRows"], case let .object(panel)? = panels.first else {
+            return XCTFail("Expected chat panel row")
+        }
+        XCTAssertEqual(panel["count"], .integer(4))
+        XCTAssertEqual(panel["countLabel"], .string("4 meldinger · 1 gren i skop"))
+        guard case let .list(chips)? = rows(atRoot)[2]["branchChips"], case let .object(chip)? = chips.first else {
+            return XCTFail("A branch message carries its chip")
+        }
+        XCTAssertEqual(chip["toneColor"], .string(PersonalCopilotHelperTree.branchToneColor))
+
+        // Inside the branch itself there is nothing to mark.
+        XCTAssertNil(tree.apply(action: "selectNode", payload: .object(["nodeID": .string("helper-invite")])))
+        XCTAssertEqual(rows(tree.project(into: source)).map { $0["id"]?.string ?? "" }, ["m2", "m3"])
+    }
+
+    func testMessageRowTemplateIsTheWorkbenchRow() throws {
+        let configuration = try XCTUnwrap(PersonalCopilotConfigurationFactory.catalogConfigurations().first { $0.name == "Co-Pilot Chat" })
+        let json = String(decoding: try JSONEncoder().encode(configuration), as: UTF8.self)
+        for marker in ["butler-avatar-initials", "\"avatarColor\"", "\"timeLabel\"", "\"branchStart\"", "Skriv til Butler",
+                       "chat-prompt-can-open-helper", "chat-prompt-can-load-surface", "\"toneColor\""] {
+            XCTAssertTrue(json.contains(marker), "Missing \(marker)")
+        }
+        XCTAssertFalse(json.contains("Hva vil du få gjort?"))
+        XCTAssertFalse(json.contains("\"height\":640"))
+    }
+}

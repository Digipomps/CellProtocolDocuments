+            $0.vAlignment = "top"
+            $0.visibility = SkeletonVisibilityRule(when: SkeletonCondition(scope: .item, keypath: "kind", notEquals: .string("branchStart")))
+        }
+        // To egne linjeelementer (hvert element har sin egen id).
+        func rule() -> SkeletonElement {
+            butlerVStack([]) {
+                $0.height = 1
+                $0.background = ButlerWorkbenchStyle.line
+                $0.flexGrow = 1
+            }
+        }
+        let branchStart = butlerHStack([rule(), butlerText(keypath: "label", size: 12, color: ButlerWorkbenchStyle.muted), rule()], spacing: 10) {
+            $0.maxWidthInfinity = true
+            $0.paddingInsets = butlerInsets(4, 0)
+            $0.visibility = SkeletonVisibilityRule(when: SkeletonCondition(scope: .item, keypath: "kind", equals: .string("branchStart")))
+        }
+        return SkeletonVStack(elements: [branchStart, message], spacing: 0, modifiers: butlerModifiers {
+            $0.paddingInsets = butlerInsets(7, 0)
+        })
+    }
+
+    /// Grenchip ved navnet; bare for meldinger fra en gren (ikke roten).
+    static func butlerBranchChips() -> SkeletonElement {

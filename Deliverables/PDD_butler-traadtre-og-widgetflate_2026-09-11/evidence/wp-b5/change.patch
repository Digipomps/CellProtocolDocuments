diff --git a/Sources/App/Cells/PersonalCopilot/PersonalCopilotChatPresentation.swift b/Sources/App/Cells/PersonalCopilot/PersonalCopilotChatPresentation.swift
new file mode 100644
index 00000000..4475f557
--- /dev/null
+++ b/Sources/App/Cells/PersonalCopilot/PersonalCopilotChatPresentation.swift
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright (c) 2026 Stiftelsen Digipomps and HAVEN contributors
+
+import Foundation
+import CellBase
+
+/// WP-B5: det meldingsraden i Butler-arbeidsflaten viser i tillegg til teksten —
+/// initialer og farge i avataren, klokkeslett, og «Avvis» bare der det finnes et åpent
+/// forslag å avvise. Rene funksjoner, så projeksjonen kan testes uten cellen.
+enum PersonalCopilotChatPresentation {
+    static let userAvatarColor = "#0f4c81"
+    static let assistantAvatarColor = "#0f8a61"
+    static let displayTimeZone = TimeZone(identifier: "Europe/Oslo") ?? .current
+
+    /// «Kjetil Hustveit» → «KH», «Butler» → «B», «Du» → «D». Tomt navn gir tom streng.
+    static func initials(_ name: String) -> String {
+        let words = name.split(whereSeparator: { $0.isWhitespace || $0 == "-" }).filter { $0.first?.isLetter == true }
+        return String(words.prefix(2).compactMap(\.first)).uppercased()
+    }
+
+    /// ISO 8601-tidspunktet som «HH:mm» i norsk tid; tomt når tidspunktet ikke kan leses.
+    static func timeLabel(_ isoTimestamp: String) -> String {
+        guard let date = parse(isoTimestamp) else { return "" }
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = displayTimeZone
+        let parts = calendar.dateComponents([.hour, .minute], from: date)
+        guard let hour = parts.hour, let minute = parts.minute else { return "" }
+        return String(format: "%02d:%02d", hour, minute)
+    }
+
+    /// «Avvis» avviser det aktive forslaget (tom payload). Knappen hører derfor bare hjemme på
+    /// raden som viser dette forslaget; alle andre rader får ingen `dismissActionLabel`.
+    static func markingOpenSuggestion(_ ui: Object, rowID: String?) -> Object {
+        guard case let .list(rows)? = ui["promptMessages"] else { return ui }
+        var result = ui
+        result["promptMessages"] = .list(rows.map { value in
+            guard case var .object(row) = value else { return value }
+            if let rowID, row["id"]?.string == rowID {
+                row["dismissActionLabel"] = .string("Avvis")
+            } else {
+                row.removeValue(forKey: "dismissActionLabel")
+            }
+            return .object(row)
+        })
+        return result
+    }
+
+    private static func parse(_ raw: String) -> Date? {
+        let fractional = ISO8601DateFormatter()
+        fractional.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        return fractional.date(from: raw) ?? ISO8601DateFormatter().date(from: raw)
+    }
+}

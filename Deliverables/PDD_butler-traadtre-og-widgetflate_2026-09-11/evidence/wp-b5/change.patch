+    }
+
+    // MARK: - Skrivefeltet
+
+    /// Skrivefelt og Send på én linje.
+    static func butlerComposerRow(composer: SkeletonTextArea, send: SkeletonElement) -> SkeletonElement {
+        butlerHStack([.TextArea(composer), send]) { $0.maxWidthInfinity = true }

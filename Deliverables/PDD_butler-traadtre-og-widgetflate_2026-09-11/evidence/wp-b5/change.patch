+        /// Fra denne bredden står panelene side om side; under den stables de (appbredde 780 i
+        /// referansebildene). Grunnoppsettet er det stablede, så en vert som ikke oppgir bredde
+        /// (ukjent plass matcher ingen terskel) får en flate som også virker på liten skjerm.
+        static let sideBySideMinWidth: Double = 1100
+    }
+
+    // MARK: - Arbeidsflaten
+
+    /// Rotelementet: tre paneler i full høyde side om side når det er plass, ellers stablet.
+    /// Chat-panelet eier fanene Samtale/Aktivt/Mer (en liten velger i chat-hodet, Kjetils valg
+    /// 2026-09-19).
+    static func butlerWorkbench(tabs: SkeletonTabs, componentPanel: SkeletonElement) -> SkeletonElement {
+        var chatTabs = tabs
+        var tabModifiers = chatTabs.modifiers ?? SkeletonModifiers()
+        tabModifiers.styleRole = "butler-chat-tabs"
+        tabModifiers.styleClasses = ["butler-chat-tabs"]
+        tabModifiers.controlStyle = .plain
+        tabModifiers.flexGrow = 1
+        tabModifiers.minHeight = 0
+        chatTabs.modifiers = tabModifiers

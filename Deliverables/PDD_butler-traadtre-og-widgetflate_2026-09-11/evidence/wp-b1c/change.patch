diff --git a/Sources/App/Cells/PersonalCopilot/PersonalCopilotConfigurationFactory.swift b/Sources/App/Cells/PersonalCopilot/PersonalCopilotConfigurationFactory.swift
index 703a6350..44948441 100644
--- a/Sources/App/Cells/PersonalCopilot/PersonalCopilotConfigurationFactory.swift
+++ b/Sources/App/Cells/PersonalCopilot/PersonalCopilotConfigurationFactory.swift
@@ -3932,11 +3932,14 @@ enum PersonalCopilotConfigurationFactory {
 
     private static func clarificationCardModifiers() -> SkeletonModifiers {
         var modifiers = motionSurfaceModifiers(role: "chat-clarification-card", hint: .appear, sourceRole: "assistant-response-bubble")
-        modifiers.visibility = SkeletonVisibilityRule(when: SkeletonCondition(
-            scope: .root,
-            keypath: "chatHub.state.assistant.clarification",
-            exists: true
-        ))
+        // WP-B1c: hidden while a helper-tree scope without the latest exchange is
+        // selected. `not(equals false)` keeps the card for states without a tree.
+        modifiers.visibility = SkeletonVisibilityRule(when: SkeletonCondition(allOf: [
+            SkeletonCondition(scope: .root, keypath: "chatHub.state.assistant.clarification", exists: true),
+            SkeletonCondition(not: SkeletonCondition(
+                scope: .root, keypath: "chatHub.state.ui.helperTree.latestExchangeInScope", equals: .bool(false)
+            ))
+        ]))
         modifiers.styleClasses = ["chat-clarification-card", "motion-appear", "motion-source-assistant-response-bubble"]
         return modifiers
     }

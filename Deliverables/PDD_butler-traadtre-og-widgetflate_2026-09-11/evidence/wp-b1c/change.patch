     // §5 test.tree-model: stable root, three levels, shared tool, transactional cycle rejection.
+    func testClarificationAndHelpLineFollowTheScope() throws {
+        var tree = PersonalCopilotHelperTree.migrating(helperRows: [
+            ["id": .string("invite"), "title": .string("Inviter")]
+        ])
+        let message: Object = [
+            "id": .string("m1"), "role": .string("assistant"), "text": .string("Hei"),
+            "createdAt": .string("2026-09-19T10:00:00Z")
+        ]
+        let source: Object = [
+            "promptMessages": .list([.object(message)]),
+            "hasPromptHelp": .bool(true),
+            "promptHelpSummary": .string("Hva vil du få gjort?")
+        ]
+        func latest(_ ui: Object) -> ValueType? {
+            guard case let .object(helperTree)? = ui["helperTree"] else { return nil }
+            return helperTree["latestExchangeInScope"]
+        }
+        let atRoot = tree.project(into: source)
+        XCTAssertEqual(atRoot["hasPromptHelp"], .bool(true))
+        XCTAssertEqual(latest(atRoot), .bool(true))
+
+        XCTAssertNil(tree.apply(action: "selectNode", payload: .object(["nodeID": .string("helper-invite")])))
+        let atChild = tree.project(into: source)
+        XCTAssertEqual(atChild["hasPromptHelp"], .bool(false))
+        XCTAssertEqual(atChild["promptHelpSummary"], .string(""))
+        XCTAssertEqual(latest(atChild), .bool(false))
+
+        XCTAssertNil(tree.apply(action: "selectNode", payload: .object(["nodeID": .string(PersonalCopilotHelperTree.rootID)])))
+        let back = tree.project(into: source)
+        XCTAssertEqual(back["hasPromptHelp"], .bool(true))
+        XCTAssertEqual(back["promptHelpSummary"], .string("Hva vil du få gjort?"))
+        XCTAssertEqual(latest(back), .bool(true))
+    }

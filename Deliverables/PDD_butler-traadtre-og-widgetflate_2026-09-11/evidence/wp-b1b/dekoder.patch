diff --git a/Tests/AppTests/SkeletonRuntimeDecoderTests.swift b/Tests/AppTests/SkeletonRuntimeDecoderTests.swift
index 7f74092f..cfc84507 100644
--- a/Tests/AppTests/SkeletonRuntimeDecoderTests.swift
+++ b/Tests/AppTests/SkeletonRuntimeDecoderTests.swift
@@ -87,6 +87,49 @@ final class SkeletonRuntimeDecoderTests: XCTestCase {
         XCTAssertNotNil(SkeletonRuntimeDecoder.decode(from: wrapped))
     }
 
+    func testAcceptsTreeAndComponentSurface() throws {
+        let value = try valueType(from: """
+        {
+          "VStack": [
+            { "Tree": {
+                "keypath": "tree.rows", "idKeypath": "id", "parentIDKeypath": "parentID",
+                "levelKeypath": "level", "leadingInsetKeypath": "inset", "hasChildrenKeypath": "hasChildren",
+                "expandedKeypath": "expanded", "selectedIDStateKeypath": "tree.selected",
+                "selectionActionKeypath": "tree.select", "expansionActionKeypath": "tree.expand",
+                "rowSkeleton": { "VStack": [ { "Text": { "keypath": "title" } } ] }
+            } },
+            { "ComponentSurface": { "sourceKeypath": "widgets.mount", "instanceID": "widget-1", "variant": "pinned" } }
+          ]
+        }
+        """)
+        let element = try XCTUnwrap(SkeletonRuntimeDecoder.decode(from: value))
+        guard case let .VStack(stack) = element, stack.elements.count == 2,
+              case .Tree = stack.elements[0], case .ComponentSurface = stack.elements[1] else {
+            return XCTFail("Expected Tree and ComponentSurface to survive the runtime decoder")
+        }
+    }
+
+    func testRejectsUnknownElementInsideTreeRow() throws {
+        let value = try valueType(from: """
+        {
+          "Tree": {
+            "keypath": "tree.rows", "idKeypath": "id", "parentIDKeypath": "parentID",
+            "levelKeypath": "level", "leadingInsetKeypath": "inset", "hasChildrenKeypath": "hasChildren",
+            "expandedKeypath": "expanded", "selectedIDStateKeypath": "tree.selected",
+            "selectionActionKeypath": "tree.select", "expansionActionKeypath": "tree.expand",
+            "rowSkeleton": { "VStack": [ { "NotAnElement": {} } ] }
+          }
+        }
+        """)
+        XCTAssertNil(SkeletonRuntimeDecoder.decode(from: value))
+    }
+
+    func testButlerChatSkeletonSurvivesTheRuntimeDecoder() throws {
+        let configuration = try XCTUnwrap(PersonalCopilotConfigurationFactory.configuration(for: PersonalChatHubContract.endpoint))
+        let value = try JSONDecoder().decode(ValueType.self, from: JSONEncoder().encode(try XCTUnwrap(configuration.skeleton)))
+        XCTAssertNotNil(SkeletonRuntimeDecoder.decode(from: value))
+    }
+
     private func valueType(from json: String) throws -> ValueType {
         try JSONDecoder().decode(ValueType.self, from: Data(json.utf8))
     }

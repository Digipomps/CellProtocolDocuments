diff --git a/Tests/AppTests/ConferencePublicConfigurationPolicyTests.swift b/Tests/AppTests/ConferencePublicConfigurationPolicyTests.swift
new file mode 100644
index 00000000..74a57143
--- /dev/null
+++ b/Tests/AppTests/ConferencePublicConfigurationPolicyTests.swift
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright (c) 2026 Stiftelsen Digipomps and HAVEN contributors
+
+@testable import App
+import CellBase
+import XCTest
+
+final class ConferencePublicConfigurationPolicyTests: IsolatedCellTestCase {
+    func testPublicConfigurationRejectsTreeAtRootAndNestedInReadOnlyContent() {
+        let tree = SkeletonElement.Tree(SkeletonTree(
+            keypath: "conferencePublicShell.state.nodes",
+            idKeypath: "id",
+            parentIDKeypath: "parentID",
+            levelKeypath: "level",
+            leadingInsetKeypath: "leadingInset",
+            hasChildrenKeypath: "hasChildren",
+            expandedKeypath: "expanded",
+            selectedIDStateKeypath: "conferencePublicShell.state.selectedID",
+            selectionActionKeypath: "conferencePublicShell.selectNode",
+            expansionActionKeypath: "conferencePublicShell.expandNode",
+            rowSkeleton: SkeletonVStack(elements: [.Text(SkeletonText(keypath: "title"))])
+        ))
+
+        for skeleton in [tree, .VStack(SkeletonVStack(elements: [tree]))] {
+            var configuration = ConferenceShellConfigurationFactory.makePublicConfiguration()
+            configuration.skeleton = skeleton
+            XCTAssertEqual(
+                ConferencePublicConfigurationPolicy.validationError(for: configuration),
+                "public configuration cannot contain trees; they always dispatch selection and expansion actions"
+            )
+        }
+    }
+
+    func testPublicConfigurationRejectsComponentSurfaceAtRootAndNestedInReadOnlyContent() {
+        let surface = SkeletonElement.ComponentSurface(SkeletonComponentSurface(
+            sourceKeypath: "conferencePublicShell.state.widget",
+            instanceID: "public-widget",
+            variant: .pinned
+        ))
+
+        for skeleton in [surface, .VStack(SkeletonVStack(elements: [surface]))] {
+            var configuration = ConferenceShellConfigurationFactory.makePublicConfiguration()
+            configuration.skeleton = skeleton
+            XCTAssertEqual(
+                ConferencePublicConfigurationPolicy.validationError(for: configuration),
+                "public configuration cannot mount component surfaces"
+            )
+        }
+    }
+
+    func testValidPublicConfigurationRemainsValidWithVisualModifiers() throws {
+        var configuration = ConferenceShellConfigurationFactory.makePublicConfiguration()
+        XCTAssertNil(ConferencePublicConfigurationPolicy.validationError(for: configuration))
+
+        var modifiers = SkeletonModifiers()
+        modifiers.layoutVariants = [SkeletonLayoutVariant(minAvailableWidth: 640, spacing: 12)]
+        modifiers.interactionStyles = SkeletonInteractionStyles(
+            hover: SkeletonInteractionStyle(background: "#eeeeee"),
+            focusVisible: SkeletonInteractionStyle(foregroundColor: "#111111")
+        )
+        configuration.skeleton = .VStack(SkeletonVStack(
+            elements: [try XCTUnwrap(configuration.skeleton)],
+            modifiers: modifiers
+        ))
+        XCTAssertNil(ConferencePublicConfigurationPolicy.validationError(for: configuration))
+    }
+}

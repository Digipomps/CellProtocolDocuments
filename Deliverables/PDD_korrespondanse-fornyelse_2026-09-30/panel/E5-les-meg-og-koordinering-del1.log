# Only these environment variables may be set by a job. They tune HAVEN's own
# build guards; nothing here can redirect a toolchain or inject credentials.
ENV_PREFIX = "HAVEN_"


def native_arch_prefix() -> list[str]:
    """Force child processes to the machine's native architecture on Apple Silicon.

    If the interpreter running this file is an x86_64 build, every process it spawns
    inherits Rosetta translation. A Swift build then produces arm64 objects while the
    test host launches as x86_64, and the test bundle fails to load with
    "incompatible architecture". Anchoring to the hardware, not to this process,
    removes that whole class of failure.
    """
    if sys.platform != "darwin":
        return []
    try:
        result = subprocess.run(
            ["sysctl", "-n", "hw.optional.arm64"],
            capture_output=True, text=True, timeout=10, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return []
    return ["arch", "-arm64"] if result.stdout.strip() == "1" else []


ARCH_PREFIX = native_arch_prefix()

# Only the Swift toolchain needs the architecture anchor. Applying it everywhere
# breaks tools that ship as x86_64-only binaries, such as `gh`, with
# "Bad CPU type in executable".
ARCH_SENSITIVE = {"scripts/run_swift_bounded.sh", "swift"}


def job_environment(job: dict) -> dict[str, str]:
    environment = dict(os.environ)
    requested = job.get("env") or {}
    if not isinstance(requested, dict):
        raise Refused("env must be an object")
    for key, value in requested.items():
        if not key.startswith(ENV_PREFIX):
            raise Refused(f"env key not allowed (must start with {ENV_PREFIX}): {key}")
        environment[key] = str(value)
    return environment


def run_step(step: dict, cwd: Path, log_handle, environment: dict[str, str] | None = None) -> dict:
    cmd = step.get("cmd")
    name = step.get("name") or (cmd[0] if cmd else "step")
    timeout = min(int(step.get("timeoutSeconds", DEFAULT_STEP_TIMEOUT)), MAX_STEP_TIMEOUT)

    try:
        check_command(cmd, cwd)
    except Refused as refusal:
        log_handle.write(f"\n=== STEP {name}: REFUSED — {refusal}\n")
        return {"name": name, "status": "refused", "reason": str(refusal), "exitCode": None}

    program = cmd[0]
    argv = list(cmd)
    if program == "scripts/run_swift_bounded.sh":
        argv[0] = str(cwd / program)
    elif program.endswith(".py"):
        argv = [sys.executable, str(HAVEN_ROOT / program)] + argv[1:]

    if program in ARCH_SENSITIVE:
        argv = ARCH_PREFIX + argv
    log_handle.write(f"\n=== STEP {name}: {' '.join(cmd)}\n")
    log_handle.flush()
    started = time.monotonic()
    try:
        completed = subprocess.run(
            argv,
            cwd=str(cwd),
            stdout=log_handle,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            check=False,
            env=environment,
        )
        exit_code = completed.returncode
        status = "ok" if exit_code == 0 else "failed"
    except subprocess.TimeoutExpired:
        exit_code = None
        status = "timeout"
        log_handle.write(f"\n=== STEP {name}: TIMEOUT after {timeout}s\n")
    except OSError as error:
        exit_code = None
        status = "error"
        log_handle.write(f"\n=== STEP {name}: ERROR {error}\n")
    except BaseException as error:  # noqa: BLE001 - a lost job is worse than a broad catch
        exit_code = None
        status = "error"
        log_handle.write(f"\n=== STEP {name}: UNEXPECTED {type(error).__name__}: {error}\n")

    duration = round(time.monotonic() - started, 1)
    log_handle.write(f"=== STEP {name}: {status} exit={exit_code} in {duration}s\n")
    log_handle.flush()
    return {"name": name, "status": status, "exitCode": exit_code, "durationSeconds": duration}


def tail(path: Path, lines: int = 40) -> list[str]:
    try:
        content = path.read_text(errors="replace").splitlines()
    except OSError:
        return []
    return content[-lines:]


def run_job(job_path: Path) -> None:
    job_id = job_path.stem
    log_path = OUTBOX / f"{job_id}.log"
    result_path = OUTBOX / f"{job_id}.result.json"

    disk_before = free_gib()
    result = {
        "id": job_id,
        "startedAt": now(),
        "logFile": log_path.name,
        "diskFreeBeforeGiB": disk_before,
    }

    try:
        job = json.loads(job_path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        result.update(status="invalid", error=f"unreadable job file: {error}", finishedAt=now())
        write_atomic(result_path, json.dumps(result, indent=2))
        return

    steps = job.get("steps")
    if not isinstance(steps, list) or not steps:
        result.update(status="invalid", error="job has no steps", finishedAt=now())
        write_atomic(result_path, json.dumps(result, indent=2))
        return

    try:
        cwd = resolve_cwd(job.get("cwd"))
    except Refused as refusal:
        result.update(status="refused", error=str(refusal), finishedAt=now())
        write_atomic(result_path, json.dumps(result, indent=2))
        return

    result["cwd"] = str(cwd.relative_to(HAVEN_ROOT))
    try:
        environment = job_environment(job)
    except Refused as refusal:
        result.update(status="refused", error=str(refusal), finishedAt=now())
        write_atomic(result_path, json.dumps(result, indent=2))
        return
    overrides = {key: value for key, value in (job.get("env") or {}).items()}
    if overrides:
        result["env"] = overrides
    stop_on_failure = bool(job.get("stopOnFailure", True))
    step_results: list[dict] = []

    log(f"job {job_id}: {len(steps)} step(s) in {result['cwd']}")
    with log_path.open("w") as log_handle:
        log_handle.write(f"job {job_id} started {now()} in {cwd}\n")
        for step in steps:
            step_result = run_step(step, cwd, log_handle, environment)
            step_results.append(step_result)
            log(f"job {job_id}: step {step_result['name']} -> {step_result['status']}")
            if stop_on_failure and step_result["status"] != "ok":
                log_handle.write("\n=== stopping: stopOnFailure\n")
                break

    overall = "ok" if all(item["status"] == "ok" for item in step_results) else "failed"
    if any(item["status"] == "refused" for item in step_results):
        overall = "refused"

    disk_after = free_gib()
    result.update(
        status=overall,
        steps=step_results,
        finishedAt=now(),
        diskFreeAfterGiB=disk_after,
        # Negative means this job consumed space. Every job reports what it cost,
        # so disk growth is measured rather than self-reported.
        diskDeltaGiB=round(disk_after - disk_before, 1),
        logTail=tail(log_path),
    )
    write_atomic(result_path, json.dumps(result, indent=2))
    log(f"job {job_id}: {overall} (disk {disk_after - disk_before:+.1f} GiB, "
        f"{disk_after:.1f} GiB free)")


def claim_next() -> Path | None:
    candidates = sorted(
        path for path in INBOX.glob("*.json") if not path.name.endswith(".partial")
    )
    for candidate in candidates:
        if not JOB_ID_RE.match(candidate.stem):
            log(f"skipping job with unsafe id: {candidate.name}")
            continue
        target = RUNNING / candidate.name
        try:
            os.rename(candidate, target)
        except OSError:
            continue
        return target
    return None


def beat(state: str, job_id: str | None = None) -> None:
    payload = {"state": state, "at": now(), "pid": os.getpid(), "job": job_id}
    try:
        write_atomic(HEARTBEAT, json.dumps(payload, indent=2))
    except OSError:
        pass


def main() -> int:
    parser = argparse.ArgumentParser(description="HAVEN agent job runner")
    parser.add_argument("--once", action="store_true", help="drain the inbox and exit")
    parser.add_argument("--interval", type=float, default=3.0, help="poll interval in seconds")
    arguments = parser.parse_args()

    for directory in (INBOX, RUNNING, OUTBOX):
        directory.mkdir(parents=True, exist_ok=True)

    stopping = {"flag": False}

    def handle_signal(signum, _frame):
        stopping["flag"] = True
        log(f"received signal {signum}, finishing current job then stopping")

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    # Anything left in running/ is from a crash. Surface it rather than silently rerun.
    for orphan in RUNNING.glob("*.json"):
        stale = OUTBOX / f"{orphan.stem}.result.json"
        if not stale.exists():
            write_atomic(stale, json.dumps({
                "id": orphan.stem,
                "status": "interrupted",
                "error": "runner stopped while this job was running",
                "finishedAt": now(),
            }, indent=2))
        try:
            orphan.unlink(missing_ok=True)
        except OSError as error:
            log(f"could not clear orphan {orphan.name}: {error}")
        log(f"recovered orphaned job {orphan.stem}")

    log(f"runner ready — HAVEN root {HAVEN_ROOT}, spool {SPOOL}"
        + (f", forcing {' '.join(ARCH_PREFIX)}" if ARCH_PREFIX else ""))
    beat("idle")

    while not stopping["flag"]:
        job = claim_next()
        if job is None:
            if arguments.once:
                break
            beat("idle")
            time.sleep(arguments.interval)
            continue
        beat("running", job.stem)
        try:
            run_job(job)
        except BaseException as error:  # noqa: BLE001
            # Without this, an unexpected failure leaves no result at all and the job
            # looks like it never ran. A recorded error is always better than silence.
            log(f"job {job.stem} crashed: {type(error).__name__}: {error}")
            try:
                write_atomic(OUTBOX / f"{job.stem}.result.json", json.dumps({
                    "id": job.stem,
                    "status": "error",
                    "error": f"{type(error).__name__}: {error}",
                    "traceback": traceback.format_exc()[-4000:],
                    "finishedAt": now(),
                }, indent=2))
            except OSError:
                pass
        finally:
            try:
                job.unlink(missing_ok=True)
            except OSError as error:
                log(f"could not clear {job.name} from running/: {error}")
            beat("idle")

    beat("stopped")
    log("runner stopped")
    return 0


if __name__ == "__main__":
    sys.exit(main())

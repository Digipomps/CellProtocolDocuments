+  /// En tilgang venter på fornyelse når den er utløpt eller går ut innen `renewalWindow`,
+  /// og verken tilgangen eller principalen er tilbakekalt. Lenger fra fristen oppfører en
+  /// aktiv tilgang seg som før, og en tilbakekalt tilgang kan ikke komme tilbake gjennom en
+  /// invitasjon.
+  static func grantAwaitsRenewal(
+    _ grant: AssistantCorrespondenceGrant,
+    revokedPrincipalIDs: Set<String>,
+    now: Date
+  ) -> Bool {
+    guard grant.revokedAt == nil,
+      revokedPrincipalIDs.contains(grant.principalID) == false,
+      let expiresAt = grant.expiresAt
+    else {
+      return false
+    }
+    return expiresAt <= now.addingTimeInterval(renewalWindow)
+  }
